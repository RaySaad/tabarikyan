<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_quick_delivery_order" model="ir.sequence">
            <field name="name">Quick Delivery Order Sequence</field>
            <field name="code">quick.delivery.order</field>
            <field name="prefix">QCK-%(year)s-</field>
            <field name="padding">6</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- إعادة محاولة الإسناد كل دقيقة للطلبات التي لم يتوفّر لها
             مندوب لحظة وصولها. -->
        <record id="ir_cron_auto_assign_quick_orders" model="ir.cron">
            <field name="name">Quick Delivery: Retry Auto-Assign Unassigned Orders</field>
            <field name="model_id" ref="model_quick_delivery_order"/>
            <field name="state">code</field>
            <field name="code">model.cron_retry_auto_assign()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>

        <!-- إعادة إرسال إبلاغات التاجر الفاشلة (تراجع أُسّي حتى ثماني
             محاولات). بلا هذا المجدول، انقطاع دقائق في سيرفر التاجر =
             طلبات لا يعرف بها أبداً - وهو ما كان يحدث مع except: pass. -->
        <record id="ir_cron_purge_throttle" model="ir.cron">
            <field name="name">Quick Delivery: Purge Rate Counters</field>
            <field name="model_id" ref="model_quick_delivery_throttle"/>
            <field name="state">code</field>
            <field name="code">model.cron_purge()</field>
            <field name="interval_number">6</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
        </record>

        <record id="ir_cron_flush_customer_messages" model="ir.cron">
            <field name="name">Quick Delivery: Retry Customer Messages</field>
            <field name="model_id" ref="model_quick_delivery_message"/>
            <field name="state">code</field>
            <field name="code">model.cron_flush_pending()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>

        <!-- إعادة محاولة إشعارات المندوبين. الدفع يُرسل فور الإسناد
             بعد تثبيت المعاملة؛ وهذا للمتعثّر: خدمة دفعٍ متوقفة، أو
             شبكة الخادم انقطعت تلك اللحظة. -->
        <record id="ir_cron_flush_driver_push" model="ir.cron">
            <field name="name">Quick Delivery: Retry Driver Push</field>
            <field name="model_id" ref="model_quick_delivery_push"/>
            <field name="state">code</field>
            <field name="code">model.cron_flush_pending()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>

        <record id="ir_cron_flush_webhooks" model="ir.cron">
            <field name="name">Quick Delivery: Retry Merchant Webhooks</field>
            <field name="model_id" ref="model_quick_delivery_webhook"/>
            <field name="state">code</field>
            <field name="code">model.cron_flush_pending()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>

        <!-- نطاق البحث عن مندوب - يُعدَّل من الإعدادات التقنية بلا كود. -->
        <record id="config_dispatch_radius" model="ir.config_parameter">
            <field name="key">quick_delivery.dispatch_radius_km</field>
            <field name="value">6.0</field>
        </record>
    </data>
</odoo>
