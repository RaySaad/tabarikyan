<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- الصفحة الرئيسية: السوبرماركتات أيقوناتٍ، بنفس هوية مركز
         السداد البنكي. تُفتح بالضغط على التطبيق نفسه. -->
    <record id="action_quick_delivery_home" model="ir.actions.client">
        <field name="name">مركز التوصيل الفوري</field>
        <field name="tag">quick_delivery_home</field>
    </record>

    <record id="action_quick_sla_dashboard" model="ir.actions.client">
        <field name="name">لوحة مراقبة 30 دقيقة + الخريطة</field>
        <field name="tag">quick_delivery.sla_dashboard</field>
    </record>

    <record id="view_quick_delivery_order_list" model="ir.ui.view">
        <field name="name">quick.delivery.order.list</field>
        <field name="model">quick.delivery.order</field>
        <field name="arch" type="xml">
            <list decoration-danger="state in ('searching_driver', 'failed')" decoration-success="state == 'delivered'">
                <field name="name"/>
                <field name="merchant_order_id"/>
                <field name="client_id"/>
                <field name="store_name"/>
                <field name="customer_name"/>
                <field name="driver_id"/>
                <field name="delivery_otp"/>
                <field name="cod_amount" sum="مبلغ التحصيل"/>
                <field name="is_cod_settled"/>
                <field name="delivery_fee" sum="رسوم التوصيل" optional="show"/>
                <field name="driver_commission" sum="عمولة المندوبين"
                       optional="hide"/>
                <field name="net_revenue" sum="الصافي" optional="hide"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_quick_delivery_order_form" model="ir.ui.view">
        <field name="name">quick.delivery.order.form</field>
        <field name="model">quick.delivery.order</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="auto_assign_nearest_driver" string="إسناد آلي لأقرب مندوب" type="object" class="btn-primary" invisible="state != 'searching_driver'"/>
                    <field name="state" widget="statusbar" statusbar_visible="searching_driver,driver_assigned,arrived_at_store,picked_up,delivered,failed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="بيانات السوبرماركت والفرع">
                            <field name="client_id"/>
                            <field name="merchant_order_id"/>
                            <field name="store_code"/>
                            <field name="store_name"/>
                            <field name="store_lat"/>
                            <field name="store_lng"/>
                        </group>
                        <group string="بيانات العميل والتوصيل">
                            <field name="customer_name"/>
                            <field name="customer_phone"/>
                            <field name="customer_lat"/>
                            <field name="customer_lng"/>
                            <field name="address_notes"/>
                        </group>
                    </group>
                    <group>
                        <group string="التنفيذ والمؤقت وإثبات التسليم">
                            <field name="driver_id"/>
                            <field name="delivery_otp"/>
                            <!-- يُعطى للعميل النهائي: يرى حالته ومندوبه
                                 ورمز تسليمه. الرمز في الرابط هو حارسه. -->
                            <field name="tracking_url"
                                   widget="CopyClipboardChar"/>
                            <field name="sla_minutes"/>
                            <field name="sla_deadline"/>
                            <field name="delivered_at"/>
                            <field name="pod_photo" widget="image" class="oe_avatar"/>
                        </group>
                        <group string="التحصيل والعهدة والتعذر">
                            <field name="delivery_fee"/>
                            <field name="driver_commission"/>
                            <field name="net_revenue"/>
                            <field name="bags_count"/>
                            <field name="payment_method"/>
                            <field name="cod_amount"/>
                            <field name="is_cod_settled"/>
                            <field name="cod_settled_at"/>
                            <field name="failure_reason"/>
                            <field name="failure_notes"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>


    <record id="view_quick_delivery_order_search" model="ir.ui.view">
        <field name="name">quick.delivery.order.search</field>
        <field name="model">quick.delivery.order</field>
        <field name="arch" type="xml">
            <!-- لم تكن للطلبات شاشة بحث إطلاقاً: مع سوبرماركت واحد
                 تُحتمل القائمة، ومع العثيم وبندة وغيرهما تصير غير
                 قابلة للقراءة - لا فلترة بالعميل ولا تجميع. -->
            <search string="بحث الطلبات">
                <field name="name" string="رقم التتبع أو طلب التاجر"
                       filter_domain="['|', ('name', 'ilike', self),
                                       ('merchant_order_id', 'ilike', self)]"/>
                <field name="client_id"/>
                <field name="customer_name"
                       filter_domain="['|', ('customer_name', 'ilike', self),
                                       ('customer_phone', 'ilike', self)]"
                       string="العميل أو جواله"/>
                <field name="driver_id"/>
                <field name="store_name"/>

                <filter name="filter_open" string="قيد التنفيذ"
                        domain="[('state', 'in', ['searching_driver',
                                 'driver_assigned', 'arrived_at_store',
                                 'picked_up'])]"/>
                <filter name="filter_unassigned" string="بلا مندوب"
                        domain="[('state', '=', 'searching_driver')]"/>
                <filter name="filter_late" string="تجاوزت الوقت"
                        domain="[('sla_deadline', '&lt;',
                                  datetime.datetime.now()
                                  .strftime('%Y-%m-%d %H:%M:%S')),
                                 ('state', 'in', ['searching_driver',
                                  'driver_assigned', 'arrived_at_store',
                                  'picked_up'])]"/>
                <separator/>
                <filter name="filter_delivered" string="مسلَّمة"
                        domain="[('state', '=', 'delivered')]"/>
                <filter name="filter_failed" string="تعذّر تسليمها"
                        domain="[('state', 'in', ['failed', 'cancelled'])]"/>
                <separator/>
                <filter name="filter_cod" string="تحصيل نقدي"
                        domain="[('payment_method', '=', 'COD')]"/>
                <filter name="filter_cod_unsettled" string="عهدة غير مسوّاة"
                        domain="[('payment_method', '=', 'COD'),
                                 ('state', '=', 'delivered'),
                                 ('is_cod_settled', '=', False)]"/>
                <separator/>
                <filter name="filter_today" string="اليوم"
                        domain="[('create_date', '&gt;=',
                                  context_today().strftime('%Y-%m-%d 00:00:00'))]"/>
                <filter name="filter_this_month" string="هذا الشهر"
                        domain="[('create_date', '&gt;=',
                                  (context_today() + relativedelta(day=1))
                                  .strftime('%Y-%m-%d 00:00:00'))]"/>
                <separator/>
                <filter name="group_client" string="السوبرماركت"
                        context="{'group_by': 'client_id'}"/>
                <filter name="group_state" string="الحالة"
                        context="{'group_by': 'state'}"/>
                <filter name="group_driver" string="المندوب"
                        context="{'group_by': 'driver_id'}"/>
                <filter name="group_store" string="الفرع"
                        context="{'group_by': 'store_name'}"/>
                <filter name="group_payment" string="طريقة الدفع"
                        context="{'group_by': 'payment_method'}"/>
                <filter name="group_month" string="الشهر"
                        context="{'group_by': 'create_date:month'}"/>
            </search>
        </field>
    </record>

    <record id="action_quick_delivery_orders" model="ir.actions.act_window">
        <field name="name">جميع طلبات التوصيل</field>
        <field name="res_model">quick.delivery.order</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_quick_delivery_order_search"/>
        <field name="context">{'search_default_filter_today': 1}</field>
    </record>

    <record id="view_partner_form_qcommerce" model="ir.ui.view">
        <field name="name">res.partner.form.qcommerce</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <!-- الصفحة كلها لمجموعة المدير: الحقول نفسها محصورة على
                     مستوى الحقل في بايثون (groups=)، وهذا يمنع ظهور صفحة
                     فارغة لمن لا يملك الصلاحية. -->
                <page string="ربط التوصيل السريع (API)"
                      groups="quick_delivery.group_qd_manager">
                    <group>
                        <field name="is_qcommerce_client"/>
                    </group>
                    <group invisible="not is_qcommerce_client">
                        <group string="استقبال الطلبات منهم">
                            <!-- الرابط هو ما تعطيه لنظام التاجر.
                                 الجزء العشوائي فيه سرّ، فلا يُخمَّن. -->
                            <field name="qd_intake_url"
                                   widget="CopyClipboardChar"
                                   invisible="not qd_intake_code"/>
                            <field name="qd_intake_code" invisible="1"/>
                            <button name="action_qd_generate_intake_code"
                                    type="object" class="btn-primary"
                                    string="توليد رابط استقبال"
                                    invisible="qd_intake_code"/>
                            <button name="action_qd_generate_intake_code"
                                    type="object" class="btn-link"
                                    string="توليد رابط جديد (يُبطل القديم)"
                                    confirm="سيتوقف الرابط الحالي فوراً، ولن يستطيع نظام التاجر الإرسال حتى تعطيه الجديد. متأكد؟"
                                    invisible="not qd_intake_code"/>
                            <field name="qd_payload_format"/>
                            <field name="qd_capture_mode"
                                   widget="boolean_toggle"/>
                            <button name="action_qd_view_inbox" type="object"
                                    class="btn-link" string="عرض الوارد"
                                    invisible="qd_inbox_count == 0"/>
                            <field name="qd_inbox_count" invisible="1"/>
                        </group>
                        <group string="الإبلاغ والرسوم">
                            <field name="api_key" password="True"/>
                            <field name="webhook_url"
                                   placeholder="https://erp.example.com/webhook/delivery"/>
                            <field name="webhook_secret" password="True"/>
                            <field name="delivery_fee_per_order"/>
                        </group>
                    </group>
                    <div class="alert alert-info mt-2" role="alert"
                         invisible="not qd_capture_mode or not is_qcommerce_client">
                        <b>وضع الالتقاط مفعّل.</b> كل نداء يصل يُحفظ كما
                        وصل ويُرد <code>202</code> ولو كانت صيغته مجهولة،
                        فلا يضيع شيء أثناء الربط. <b>أطفئه بعد انتهاء
                        الربط</b>: قبول طلب لا نفهمه في الإنتاج يعني
                        طلباً لن يصل أحداً والتاجر يظنّه مقبولاً.
                    </div>
                </page>
            </xpath>
        </field>
    </record>


    <!-- ============ المندوبون (كيان مستقل لا مستخدمو أودو) ============ -->
    <record id="view_quick_delivery_driver_list" model="ir.ui.view">
        <field name="name">quick.delivery.driver.list</field>
        <field name="model">quick.delivery.driver</field>
        <field name="arch" type="xml">
            <list decoration-muted="driver_status == 'offline'"
                  decoration-success="driver_status == 'online'"
                  decoration-warning="not has_pin">
                <field name="name"/>
                <field name="phone"/>
                <field name="vehicle_plate" optional="show"/>
                <field name="driver_status" widget="badge"
                       decoration-success="driver_status == 'online'"
                       decoration-warning="driver_status == 'busy'"/>
                <field name="has_pin" string="له رمز دخول"/>
                <field name="today_delivered_count"/>
                <field name="cod_custody_balance" sum="إجمالي العهدة"/>
                <field name="last_ping" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_quick_delivery_driver_form" model="ir.ui.view">
        <field name="name">quick.delivery.driver.form</field>
        <field name="model">quick.delivery.driver</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_generate_pin" type="object"
                            string="توليد رمز دخول" class="btn-primary"
                            groups="quick_delivery.group_qd_manager"
                            help="يُعرض الرمز مرة واحدة ثم يُخزَّن مُعمّى."/>
                    <button name="action_revoke_sessions" type="object"
                            string="إنهاء جلسات الأجهزة"
                            groups="quick_delivery.group_qd_manager"
                            help="لجوال مفقود أو مندوب أُوقف: يخرج من التطبيق فوراً."/>
                    <button name="action_settle_driver_cod" type="object"
                            string="تسوية عهدة التحصيل (COD)" class="btn-success"
                            groups="quick_delivery.group_qd_manager"
                            invisible="cod_custody_balance == 0"/>
                    <field name="driver_status" widget="statusbar"
                           statusbar_visible="offline,online,busy"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="موقوف"
                            bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="اسم المندوب"/></h1>
                    </div>
                    <group>
                        <group string="البيانات ودخول التطبيق">
                            <field name="phone" placeholder="05XXXXXXXX"/>
                            <field name="vehicle_plate"/>
                            <field name="active" widget="boolean_toggle"/>
                            <field name="has_pin"/>
                            <!-- يُكتب يدوياً أو يُولَّد بالزر. لا يُقرأ
                                 بعد الحفظ: المخزَّن بصمة لا نصّ. -->
                            <field name="pin" password="True"
                                   placeholder="4 إلى 6 أرقام"
                                   groups="quick_delivery.group_qd_manager"/>
                        </group>
                        <group string="الجلسة الحالية"
                               groups="quick_delivery.group_qd_manager">
                            <field name="session_expiry"/>
                            <field name="session_device"/>
                            <field name="login_locked_until"/>
                            <field name="login_fail_count"/>
                        </group>
                    </group>
                    <group>
                        <group string="الموقع والحالة">
                            <field name="current_lat"/>
                            <field name="current_lng"/>
                            <field name="last_ping"/>
                        </group>
                        <group string="المحفظة والعهدة">
                            <field name="commission_per_order"/>
                            <field name="cod_custody_balance"/>
                            <field name="today_delivered_count"/>
                            <field name="today_earnings"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="طلبات المندوب">
                            <field name="order_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="client_id"/>
                                    <field name="customer_name"/>
                                    <field name="cod_amount"/>
                                    <field name="is_cod_settled"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="ملاحظات">
                            <field name="notes" placeholder="..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_quick_delivery_driver_search" model="ir.ui.view">
        <field name="name">quick.delivery.driver.search</field>
        <field name="model">quick.delivery.driver</field>
        <field name="arch" type="xml">
            <search string="بحث المندوبين">
                <field name="name"/>
                <field name="phone"/>
                <field name="vehicle_plate"/>
                <filter name="filter_online" string="متاح الآن"
                        domain="[('driver_status', '=', 'online')]"/>
                <filter name="filter_busy" string="في مهمة"
                        domain="[('driver_status', '=', 'busy')]"/>
                <filter name="filter_no_pin" string="بلا رمز دخول"
                        domain="[('has_pin', '=', False)]"/>
                <filter name="filter_archived" string="الموقوفون"
                        domain="[('active', '=', False)]"/>
                <separator/>
                <filter name="group_status" string="الحالة"
                        context="{'group_by': 'driver_status'}"/>
            </search>
        </field>
    </record>

    <record id="action_quick_delivery_drivers" model="ir.actions.act_window">
        <field name="name">المندوبون</field>
        <field name="res_model">quick.delivery.driver</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">سجّل أول مندوب</p>
            <p>المندوب هنا ليس مستخدم أودو ولا يحتاج رخصة. أضفه، ولّد له
               رمز دخول، وأعطه رابط التطبيق: <b>/driver</b></p>
        </field>
    </record>


    <!-- ============ السوبرماركتات (عملاء الـAPI) ============ -->
    <record id="view_qcommerce_client_list" model="ir.ui.view">
        <field name="name">res.partner.qcommerce.list</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <list string="السوبرماركتات" decoration-warning="not qd_is_configured">
                <field name="name"/>
                <field name="phone" optional="show"/>
                <field name="qd_is_configured" string="الربط مكتمل"/>
                <field name="qd_capture_mode" string="وضع الالتقاط"
                       optional="show"/>
                <field name="delivery_fee_per_order"
                       groups="quick_delivery.group_qd_manager"/>
                <field name="qd_active_orders" string="جارية"/>
                <field name="qd_late_orders" string="متأخرة"/>
                <field name="qd_month_orders" sum="طلبات الشهر"/>
                <field name="qd_month_fees" sum="رسوم الشهر"/>
                <button name="action_qd_view_orders" type="object"
                        icon="fa-list" title="طلبات هذا السوبرماركت"/>
            </list>
        </field>
    </record>


    <record id="view_qcommerce_client_kanban" model="ir.ui.view">
        <field name="name">res.partner.qcommerce.kanban</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <!-- كرت لكل سوبرماركت: حالته من نظرة، وأزراره تدخل إلى
                 طلباته وحدها. مع عميل واحد كانت القائمة تكفي. -->
            <kanban create="1">
                <field name="qd_active_orders"/>
                <field name="qd_late_orders"/>
                <field name="qd_today_delivered"/>
                <field name="qd_month_orders"/>
                <field name="qd_month_fees"/>
                <field name="qd_is_configured"/>
                <field name="qd_capture_mode"/>
                <field name="qd_inbox_pending"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <span class="fw-bolder fs-5">
                                <field name="name"/>
                            </span>
                            <span t-if="!record.qd_is_configured.raw_value"
                                  class="badge text-bg-warning">ربطه ناقص</span>
                            <span t-elif="record.qd_capture_mode.raw_value"
                                  class="badge text-bg-info">وضع الالتقاط</span>
                            <span t-else="" class="badge text-bg-success">يعمل</span>
                        </div>

                        <div class="row text-center g-0 border-top border-bottom py-2 mb-2">
                            <div class="col-4">
                                <div class="text-muted small">جارية</div>
                                <div class="fs-4 fw-bold">
                                    <field name="qd_active_orders"/>
                                </div>
                            </div>
                            <div class="col-4 border-start border-end">
                                <div class="text-muted small">متأخرة</div>
                                <div t-attf-class="fs-4 fw-bold #{record.qd_late_orders.raw_value ? 'text-danger' : 'text-muted'}">
                                    <field name="qd_late_orders"/>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="text-muted small">سُلّمت اليوم</div>
                                <div class="fs-4 fw-bold text-success">
                                    <field name="qd_today_delivered"/>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between small text-muted mb-2">
                            <span>طلبات الشهر: <field name="qd_month_orders"/></span>
                            <span>رسوم الشهر: <field name="qd_month_fees"/></span>
                        </div>

                        <div class="d-flex flex-wrap gap-1">
                            <button name="action_qd_view_live_orders" type="object"
                                    class="btn btn-sm btn-primary">الطلبات الجارية</button>
                            <button name="action_qd_view_orders" type="object"
                                    class="btn btn-sm btn-secondary">كل الطلبات</button>
                            <button name="action_qd_view_inbox" type="object"
                                    t-if="record.qd_inbox_pending.raw_value"
                                    class="btn btn-sm btn-outline-danger">
                                وارد لم يُحوَّل (<field name="qd_inbox_pending"/>)
                            </button>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_qcommerce_client_search" model="ir.ui.view">
        <field name="name">res.partner.qcommerce.search</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <search string="بحث السوبرماركتات">
                <field name="name"/>
                <filter name="filter_not_configured" string="ربطه ناقص"
                        domain="[('qd_is_configured', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_qcommerce_clients" model="ir.actions.act_window">
        <field name="name">السوبرماركتات (عملاء الـAPI)</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('is_qcommerce_client', '=', True)]</field>
        <field name="context">{'default_is_qcommerce_client': True}</field>
        <field name="search_view_id" ref="view_qcommerce_client_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">أضف أول سوبرماركت</p>
            <p>لكل سوبرماركت مفتاح API خاص ورابط إبلاغ خاص ورسم توصيل
               خاص. رقم الطلب فريد داخل كل عميل، فلا يتعارض
               <b>SO-100</b> من العثيم مع <b>SO-100</b> من بندة.</p>
        </field>
    </record>


    <!-- ============ الوارد الخام من أنظمة التجّار ============ -->
    <record id="view_quick_delivery_inbox_list" model="ir.ui.view">
        <field name="name">quick.delivery.inbox.list</field>
        <field name="model">quick.delivery.inbox</field>
        <field name="arch" type="xml">
            <list string="الوارد" create="0"
                  decoration-danger="state == 'failed'"
                  decoration-muted="state in ('mapped', 'ignored')">
                <header>
                    <button name="action_replay" type="object"
                            string="إعادة معالجة المحدَّد" class="btn-primary"/>
                </header>
                <field name="received_at"/>
                <field name="client_id"/>
                <field name="remote_addr" optional="show"/>
                <field name="order_id" optional="show"/>
                <field name="attempts" optional="hide"/>
                <field name="result_note" string="ما حدث" optional="show"/>
                <field name="error" optional="show"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'mapped'"
                       decoration-muted="state == 'ignored'"
                       decoration-danger="state == 'failed'"/>
                <button name="action_replay" type="object" icon="fa-repeat"
                        title="إعادة المعالجة"
                        invisible="state in ('mapped', 'ignored')"/>
            </list>
        </field>
    </record>

    <record id="view_quick_delivery_inbox_form" model="ir.ui.view">
        <field name="name">quick.delivery.inbox.form</field>
        <field name="model">quick.delivery.inbox</field>
        <field name="arch" type="xml">
            <form create="0">
                <header>
                    <button name="action_replay" type="object"
                            string="إعادة المعالجة" class="btn-primary"
                            invisible="state in ('mapped', 'ignored')"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="client_id"/>
                            <field name="received_at"/>
                            <field name="remote_addr"/>
                            <field name="endpoint_code"/>
                        </group>
                        <group>
                            <field name="order_id"/>
                            <field name="attempts"/>
                            <field name="result_note"/>
                            <field name="error"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="الجسم كما وصل">
                            <!-- هذا هو الدليل: ما أرسله التاجر حرفياً،
                                 ومنه يُكتب المُحوّل. -->
                            <field name="raw_body" widget="text"
                                   options="{'resizable': true}"/>
                        </page>
                        <page string="الترويسات">
                            <!-- الأسرار مقنَّعة: نعرف أي ترويسة
                                 استعملوها وشكلها، ولا نحتفظ بسرّهم. -->
                            <field name="headers" widget="json"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_quick_delivery_inbox_search" model="ir.ui.view">
        <field name="name">quick.delivery.inbox.search</field>
        <field name="model">quick.delivery.inbox</field>
        <field name="arch" type="xml">
            <search string="بحث الوارد">
                <field name="client_id"/>
                <field name="raw_body" string="بحث في الجسم"/>
                <filter name="filter_pending" string="بانتظار التحويل"
                        domain="[('state', '=', 'received')]"/>
                <filter name="filter_failed" string="تعذّر تحويله"
                        domain="[('state', '=', 'failed')]"/>
                <filter name="filter_not_mapped" string="يحتاج معالجة"
                        domain="[('state', 'not in', ['mapped', 'ignored'])]"/>
                <filter name="filter_ignored" string="مُهمَل"
                        domain="[('state', '=', 'ignored')]"/>
                <separator/>
                <filter name="group_client" string="السوبرماركت"
                        context="{'group_by': 'client_id'}"/>
                <filter name="group_state" string="الحالة"
                        context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <record id="action_quick_delivery_inbox" model="ir.actions.act_window">
        <field name="name">الوارد من أنظمة التجّار</field>
        <field name="res_model">quick.delivery.inbox</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_filter_not_mapped': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">لم يصل شيء بعد</p>
            <p>كل نداء يصل من نظام التاجر يُحفظ هنا كما وصل — الجسم
               والترويسات والوقت والعنوان. منه يُكتب مُحوّل صيغته، وبزر
               <b>إعادة المعالجة</b> يصير ما التُقط طلبات فعلية.</p>
        </field>
    </record>

    <!-- ============ صادر إبلاغ التاجر (Webhook) ============ -->
    <record id="view_quick_delivery_webhook_list" model="ir.ui.view">
        <field name="name">quick.delivery.webhook.list</field>
        <field name="model">quick.delivery.webhook</field>
        <field name="arch" type="xml">
            <list string="إبلاغات التاجر" create="0"
                  decoration-danger="state == 'failed'"
                  decoration-muted="state == 'sent'">
                <field name="create_date" string="وقت الحدث"/>
                <field name="order_id"/>
                <field name="client_id"/>
                <field name="attempts"/>
                <field name="response_code" optional="show"/>
                <field name="next_attempt_at" optional="hide"/>
                <field name="sent_at" optional="hide"/>
                <field name="last_error" optional="show"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'sent'"
                       decoration-danger="state == 'failed'"/>
                <button name="action_retry" type="object" icon="fa-repeat"
                        title="إعادة المحاولة" invisible="state == 'sent'"/>
            </list>
        </field>
    </record>

    <record id="action_quick_delivery_webhooks" model="ir.actions.act_window">
        <field name="name">إبلاغات التاجر (Webhook)</field>
        <field name="res_model">quick.delivery.webhook</field>
        <field name="view_mode">list</field>
        <field name="context">{'search_default_filter_not_sent': 1}</field>
    </record>

    <record id="view_quick_delivery_webhook_search" model="ir.ui.view">
        <field name="name">quick.delivery.webhook.search</field>
        <field name="model">quick.delivery.webhook</field>
        <field name="arch" type="xml">
            <search string="بحث الإبلاغات">
                <field name="order_id"/>
                <field name="client_id"/>
                <filter name="filter_not_sent" string="لم يُرسل بعد"
                        domain="[('state', '!=', 'sent')]"/>
                <filter name="filter_failed" string="فشل نهائياً"
                        domain="[('state', '=', 'failed')]"/>
                <separator/>
                <filter name="group_client" string="السوبرماركت"
                        context="{'group_by': 'client_id'}"/>
                <filter name="group_state" string="الحالة"
                        context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <!-- القوائم محصورة بمجموعات التوصيل: كانت ظاهرة لكل مستخدم داخلي. -->
    <menuitem id="menu_quick_delivery_root" name="التوصيل الفوري (30m)" sequence="10"
              action="action_quick_delivery_home"
              groups="quick_delivery.group_qd_dispatcher"/>
    <menuitem id="menu_quick_home" name="الرئيسية" parent="menu_quick_delivery_root" action="action_quick_delivery_home" sequence="0"
              groups="quick_delivery.group_qd_dispatcher"/>
    <menuitem id="menu_quick_dashboard" name="غرفة العمليات والخريطة الحية" parent="menu_quick_delivery_root" action="action_quick_sla_dashboard" sequence="1"
              groups="quick_delivery.group_qd_dispatcher"/>
    <menuitem id="menu_quick_orders" name="سجل الطلبات" parent="menu_quick_delivery_root" action="action_quick_delivery_orders" sequence="2"
              groups="quick_delivery.group_qd_dispatcher"/>
    <menuitem id="menu_quick_clients" name="السوبرماركتات" parent="menu_quick_delivery_root" action="action_qcommerce_clients" sequence="4"
              groups="quick_delivery.group_qd_dispatcher"/>
    <menuitem id="menu_quick_drivers" name="المندوبون" parent="menu_quick_delivery_root" action="action_quick_delivery_drivers" sequence="3"
              groups="quick_delivery.group_qd_dispatcher"/>
    <menuitem id="menu_quick_inbox" name="الوارد من التجّار" parent="menu_quick_delivery_root" action="action_quick_delivery_inbox" sequence="5"
              groups="quick_delivery.group_qd_dispatcher"/>
    <menuitem id="menu_quick_webhooks" name="إبلاغات التاجر (Webhook)" parent="menu_quick_delivery_root" action="action_quick_delivery_webhooks" sequence="6"
              groups="quick_delivery.group_qd_manager"/>
</odoo>
