<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- يرث نموذج أمر البيع الأساسي عمداً: شاشة التأجير في النسخة
             المدفوعة ترث النموذج نفسه، فتظهر الحقول فيها دون أن يعتمد
             الموديول على تطبيق التأجير. -->
        <record id="view_order_form_booking" model="ir.ui.view">
            <field name="name">sale.order.form.booking</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//header" position="inside">
                    <button name="action_register_booking_payment" type="object"
                            string="تسجيل دفعة" class="btn-secondary"
                            invisible="not is_booking_order or state in ('draft', 'cancel')"/>
                    <button name="action_send_rental_contract" type="object"
                            string="إرسال العقد" class="btn-secondary"
                            invisible="not is_booking_order or state not in ('sale', 'done') or booking_amount_paid == 0"/>
                    <button name="action_print_rental_contract" type="object"
                            string="طباعة العقد" class="btn-secondary"
                            invisible="not is_booking_order or state not in ('sale', 'done') or booking_amount_paid == 0"/>
                </xpath>
                <xpath expr="//div[@name='button_box']" position="inside">
                    <button name="action_view_booking_payments" type="object"
                            class="oe_stat_button" icon="fa-money"
                            invisible="booking_payment_count == 0">
                        <field name="booking_payment_count" widget="statinfo"
                               string="دفعات الحجز"/>
                    </button>
                </xpath>
                <xpath expr="//field[@name='partner_id']" position="before">
                    <field name="is_booking_order" invisible="1"/>
                    <field name="booking_source"
                           readonly="state in ('sale', 'cancel')"/>
                    <field name="booking_collected_by"
                           invisible="not booking_source"
                           required="booking_source == 'platform'"
                           readonly="state in ('sale', 'cancel')"/>
                    <field name="booking_reference"
                           invisible="not booking_source"
                           required="booking_source == 'platform'"
                           readonly="state in ('sale', 'cancel')"
                           placeholder="رقم الحجز في المنصة"/>
                </xpath>
                <xpath expr="//field[@name='partner_id']" position="after">
                    <field name="guest_name" invisible="not is_booking_order"/>
                    <field name="guest_mobile" invisible="not is_booking_order"/>
                    <field name="guest_email" invisible="not is_booking_order"
                           widget="email"/>
                    <field name="contract_sent_date" readonly="1"
                           invisible="not contract_sent_date"/>
                    <field name="booking_amount_paid"
                           invisible="not is_booking_order or booking_amount_paid == 0"/>
                    <field name="booking_amount_due"
                           invisible="not is_booking_order or booking_amount_due == 0"/>
                </xpath>
            </field>
        </record>

        <record id="view_order_tree_booking" model="ir.ui.view">
            <field name="name">sale.order.list.booking</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='partner_id']" position="after">
                    <field name="booking_reference" optional="show"/>
                    <field name="guest_name" optional="hide"/>
                    <field name="booking_source" optional="hide"/>
                </xpath>
            </field>
        </record>

        <record id="view_sales_order_filter_booking" model="ir.ui.view">
            <field name="name">sale.order.search.booking</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_sales_order_filter"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='name']" position="after">
                    <field name="booking_reference" string="رقم الحجز"/>
                    <field name="guest_name" string="اسم النزيل"/>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
