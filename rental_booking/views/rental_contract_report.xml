<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="action_report_rental_contract" model="ir.actions.report">
            <field name="name">عقد إيجار</field>
            <field name="model">sale.order</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">rental_booking.report_rental_contract</field>
            <field name="report_file">rental_booking.report_rental_contract</field>
            <field name="binding_model_id" ref="sale.model_sale_order"/>
            <field name="binding_type">report</field>
        </record>

        <template id="report_rental_contract_document">
            <t t-call="web.external_layout">
                <div class="page">
                    <h2 class="text-center">عقد إيجار</h2>
                    <div class="text-center mb-4">
                        <span>رقم الحجز: </span><span t-field="o.name"/>
                        <t t-if="o.booking_reference">
                            <span> — مرجع المنصة: </span><span t-field="o.booking_reference"/>
                        </t>
                    </div>

                    <div class="row mb-4">
                        <div class="col-6">
                            <strong>الطرف الأول (المؤجِّر)</strong>
                            <div t-field="o.company_id.partner_id"
                                 t-options='{"widget": "contact", "fields": ["name", "address", "phone"], "no_marker": True}'/>
                            <div t-if="o.company_id.vat">الرقم الضريبي: <span t-field="o.company_id.vat"/></div>
                        </div>
                        <div class="col-6">
                            <strong>الطرف الثاني (المستأجر)</strong>
                            <div><span t-field="o.guest_name"/></div>
                            <div t-if="o.guest_id_number">رقم الهوية: <span t-field="o.guest_id_number"/></div>
                            <div t-if="o.guest_mobile">الجوال: <span t-field="o.guest_mobile"/></div>
                            <div t-if="o.guest_email"><span t-field="o.guest_email"/></div>
                        </div>
                    </div>

                    <table class="table table-sm mb-4">
                        <thead>
                            <tr>
                                <th>الوحدة / الخدمة</th>
                                <th class="text-end">الكمية</th>
                                <th class="text-end">الإجمالي</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="o.order_line.filtered(lambda l: not l.display_type)" t-as="line">
                                <td><span t-field="line.name"/></td>
                                <td class="text-end"><span t-field="line.product_uom_qty"/></td>
                                <td class="text-end"><span t-field="line.price_subtotal"/></td>
                            </tr>
                        </tbody>
                    </table>

                    <div class="row mb-4">
                        <div class="offset-6 col-6">
                            <table class="table table-sm">
                                <tr>
                                    <td>إجمالي قيمة العقد</td>
                                    <td class="text-end"><span t-field="o.amount_total"/></td>
                                </tr>
                                <tr>
                                    <td>المدفوع</td>
                                    <td class="text-end"><span t-field="o.booking_amount_paid"/></td>
                                </tr>
                                <tr class="border-black o-total">
                                    <td><strong>المتبقي</strong></td>
                                    <td class="text-end"><strong><span t-field="o.booking_amount_due"/></strong></td>
                                </tr>
                            </table>
                        </div>
                    </div>

                    <div t-if="o.booking_payment_ids" class="mb-4">
                        <strong>الدفعات المستلمة</strong>
                        <table class="table table-sm">
                            <tr t-foreach="o.booking_payment_ids.filtered(lambda p: p.state in ('in_process', 'paid'))" t-as="pay">
                                <td><span t-field="pay.date"/></td>
                                <td><span t-field="pay.journal_id.name"/></td>
                                <td class="text-end"><span t-field="pay.amount"/></td>
                            </tr>
                        </table>
                    </div>

                    <!-- بنود العقد يحرّرها المستخدم من الإعدادات - لا تُكتب
                         في الكود: نصّ قانوني يخصّهم وقد يتغيّر. -->
                    <div t-if="o.company_id.rental_contract_terms" class="mb-4">
                        <strong>بنود العقد</strong>
                        <div t-field="o.company_id.rental_contract_terms"/>
                    </div>

                    <div class="row mt-5">
                        <div class="col-6 text-center">
                            <div>الطرف الأول (المؤجِّر)</div>
                            <div class="mt-4">التوقيع: ..............................</div>
                        </div>
                        <div class="col-6 text-center">
                            <div>الطرف الثاني (المستأجر)</div>
                            <div class="mt-4">التوقيع: ..............................</div>
                        </div>
                    </div>
                </div>
            </t>
        </template>

        <template id="report_rental_contract">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <t t-call="rental_booking.report_rental_contract_document"/>
                </t>
            </t>
        </template>

        <record id="mail_template_rental_contract" model="mail.template">
            <field name="name">عقد إيجار - إرسال للمستأجر</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="subject">عقد إيجار {{ object.name }}</field>
            <field name="email_from">{{ (object.company_id.email or user.email_formatted) }}</field>
            <field name="report_template_ids" eval="[(4, ref('action_report_rental_contract'))]"/>
            <field name="auto_delete" eval="False"/>
            <field name="body_html" type="html">
                <div style="margin:0px;padding:0px;font-size:14px;">
                    <p>مرحباً <t t-out="object.guest_name or ''"/>،</p>
                    <p>
                        نشكر لكم حجزكم لدى <t t-out="object.company_id.name or ''"/>.
                        تجدون عقد الإيجار مرفقاً بهذه الرسالة.
                    </p>
                    <p>
                        رقم الحجز: <t t-out="object.name or ''"/><br/>
                        إجمالي قيمة العقد: <t t-out="format_amount(object.amount_total, object.currency_id) or ''"/><br/>
                        المدفوع: <t t-out="format_amount(object.booking_amount_paid, object.currency_id) or ''"/><br/>
                        المتبقي: <t t-out="format_amount(object.booking_amount_due, object.currency_id) or ''"/>
                    </p>
                    <p>نتطلع لاستقبالكم.</p>
                </div>
            </field>
        </record>

    </data>
</odoo>
