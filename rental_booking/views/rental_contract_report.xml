<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="action_report_rental_contract" model="ir.actions.report">
            <field name="name">عقد إيجار</field>
            <field name="model">sale.order</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">rental_booking.report_rental_contract</field>
            <field name="report_file">rental_booking.report_rental_contract</field>
            <field name="binding_model_id" ref="sale.model_sale_order"/>
            <field name="binding_type">report</field>
        </record>

        <!-- ================================================================
             مستند شكلي للمستأجر: المبالغ ومدة الحجز فقط - بلا تواقيع ولا
             جدول دفعات (طلب صريح). تفصيل الدفعات موضعه الفاتورة، وهناك
             يظهر "تم الدفع في ..." لكل دفعة.
             ================================================================ -->
        <template id="report_rental_contract_document">
            <t t-call="web.external_layout">
                <t t-set="period" t-value="o._get_booking_period()"/>
                <div class="page">
                    <h2 class="text-center mb-1">عقد إيجار</h2>
                    <div class="text-center text-muted mb-4">
                        <span t-field="o.name"/>
                        <t t-if="o.booking_reference">
                            <span> — رقم الحجز: </span><span t-field="o.booking_reference"/>
                        </t>
                    </div>

                    <table class="table table-sm mb-4">
                        <tr>
                            <td style="width:35%"><strong>المستأجر</strong></td>
                            <td><span t-field="o.guest_name"/></td>
                        </tr>
                        <tr t-if="o.guest_id_number">
                            <td><strong>رقم الهوية</strong></td>
                            <td><span t-field="o.guest_id_number"/></td>
                        </tr>
                        <tr t-if="o.guest_mobile">
                            <td><strong>رقم الجوال</strong></td>
                            <td><span t-field="o.guest_mobile"/></td>
                        </tr>
                        <tr t-if="period['start']">
                            <td><strong>الدخول</strong></td>
                            <td><span t-esc="period['start']"
                                      t-options='{"widget": "datetime"}'/></td>
                        </tr>
                        <tr t-if="period['end']">
                            <td><strong>الخروج</strong></td>
                            <td><span t-esc="period['end']"
                                      t-options='{"widget": "datetime"}'/></td>
                        </tr>
                        <tr t-if="period['nights']">
                            <td><strong>مدة الحجز</strong></td>
                            <td><span t-esc="period['nights']"/> ليلة</td>
                        </tr>
                    </table>

                    <table class="table table-sm mb-4">
                        <thead>
                            <tr>
                                <th>الوحدة / الخدمة</th>
                                <th class="text-end">الإجمالي</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="o.order_line.filtered(lambda l: not l.display_type)" t-as="line">
                                <td><span t-field="line.name"/></td>
                                <td class="text-end"><span t-field="line.price_subtotal"/></td>
                            </tr>
                        </tbody>
                    </table>

                    <div class="row mb-4">
                        <div class="offset-6 col-6">
                            <table class="table table-sm">
                                <tr>
                                    <td>إجمالي قيمة الحجز</td>
                                    <td class="text-end"><span t-field="o.amount_total"/></td>
                                </tr>
                                <tr>
                                    <td>المدفوع</td>
                                    <td class="text-end"><span t-field="o.booking_amount_paid"/></td>
                                </tr>
                                <tr class="border-black o-total">
                                    <td><strong>المتبقي</strong></td>
                                    <td class="text-end"><strong><span t-field="o.booking_amount_due"/></strong></td>
                                </tr>
                            </table>
                        </div>
                    </div>

                    <!-- بنود العقد يحرّرها المستخدم من الإعدادات - لا تُكتب
                         في الكود: نصّ قانوني يخصّهم وقد يتغيّر. -->
                    <div t-if="o.company_id.rental_contract_terms">
                        <strong>بنود العقد</strong>
                        <div t-field="o.company_id.rental_contract_terms"/>
                    </div>
                </div>
            </t>
        </template>

        <template id="report_rental_contract">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <t t-call="rental_booking.report_rental_contract_document"/>
                </t>
            </t>
        </template>

    </data>
</odoo>
