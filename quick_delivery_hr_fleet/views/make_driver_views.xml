<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_make_driver_form" model="ir.ui.view">
        <field name="name">quick.delivery.make.driver.form</field>
        <field name="model">quick.delivery.make.driver</field>
        <field name="arch" type="xml">
            <form string="تحويل موظفين إلى مندوبين">
                <group>
                    <field name="employee_ids" widget="many2many_tags"
                           options="{'no_create': True}"/>
                    <field name="client_ids" widget="many2many_tags"
                           options="{'no_create': True}"
                           placeholder="اتركه فارغاً ليخدموا كل الشركات"/>
                    <field name="commission_per_order"/>
                    <field name="vehicle_id" options="{'no_create': True}"/>
                    <field name="generate_pins"/>
                </group>
                <div class="alert alert-warning" role="alert"
                     invisible="not generate_pins">
                    ستُعرض الأرقام السرية <b>مرة واحدة</b> بعد الإنشاء.
                    الأسلم إطفاء الخيار وتوليد رمز كلٍّ عند تسليمه
                    جواله — ورقةٌ فيها أرقام عشرين مندوباً خطرٌ بذاتها.
                </div>
                <footer>
                    <button name="action_create_drivers" type="object"
                            string="إنشاء المندوبين" class="btn-primary"/>
                    <button string="إلغاء" class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_make_driver_result" model="ir.ui.view">
        <field name="name">quick.delivery.make.driver.result</field>
        <field name="model">quick.delivery.make.driver</field>
        <field name="arch" type="xml">
            <form string="النتيجة">
                <div class="alert alert-success" role="alert">
                    أُنشئ <field name="created_count" class="oe_inline"/> مندوباً.
                </div>
                <field name="result_text" nolabel="1" readonly="1"
                       widget="text" class="font-monospace"/>
                <group string="لم يُنشأوا" invisible="not skipped_text">
                    <field name="skipped_text" nolabel="1" readonly="1"/>
                </group>
                <footer>
                    <button name="action_open_drivers" type="object"
                            string="فتح المندوبين" class="btn-primary"/>
                    <button string="إغلاق" class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- يظهر في قائمة الإجراءات ⚙ عند تحديد موظفين -->
    <record id="action_make_driver" model="ir.actions.act_window">
        <field name="name">اجعلهم مندوبي توصيل</field>
        <field name="res_model">quick.delivery.make.driver</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_make_driver_form"/>
        <field name="target">new</field>
        <field name="binding_model_id" ref="hr.model_hr_employee"/>
        <field name="binding_view_types">list,form</field>
        <field name="group_ids"
               eval="[(4, ref('quick_delivery.group_qd_manager'))]"/>
    </record>
</odoo>
