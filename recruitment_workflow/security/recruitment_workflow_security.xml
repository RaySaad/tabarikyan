<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- فئة التطبيق (Module Category) -->
        <record id="module_category_recruitment_workflow" model="ir.module.category">
            <field name="name">سير عمل التوظيف</field>
            <field name="description">صلاحيات إدارة سير عمل طلبات التوظيف</field>
            <field name="sequence">20</field>
        </record>

        <!-- صلاحية المجموعة (res.groups.privilege) - جديد في Odoo 19 -->
        <record id="privilege_recruitment_workflow" model="res.groups.privilege">
            <field name="name">سير عمل التوظيف</field>
            <field name="sequence">20</field>
            <field name="category_id" ref="module_category_recruitment_workflow"/>
        </record>

        <!-- مستخدم: يقدّم ويتابع طلبات التوظيف -->
        <record id="group_recruitment_workflow_user" model="res.groups">
            <field name="name">مستخدم - طلبات التوظيف</field>
            <field name="sequence">10</field>
            <field name="privilege_id" ref="privilege_recruitment_workflow"/>
        </record>

        <!-- مسؤول المشروع -->
        <record id="group_recruitment_workflow_project_manager" model="res.groups">
            <field name="name">مسؤول المشروع</field>
            <field name="sequence">20</field>
            <field name="privilege_id" ref="privilege_recruitment_workflow"/>
            <field name="implied_ids" eval="[(4, ref('group_recruitment_workflow_user'))]"/>
        </record>

        <!-- الموارد البشرية: تتابع وتؤكد اكتمال نقل الكفالة -->
        <record id="group_recruitment_workflow_hr" model="res.groups">
            <field name="name">الموارد البشرية</field>
            <field name="sequence">25</field>
            <field name="privilege_id" ref="privilege_recruitment_workflow"/>
            <field name="implied_ids" eval="[(4, ref('group_recruitment_workflow_user'))]"/>
        </record>

        <!-- مدير العمليات - في هذه المؤسسة نفس الشخص مسؤول عن الموارد
             البشرية أيضاً، فمنحه هذه المجموعة يمنحه صلاحياتها تلقائياً دون
             حاجة لإضافته يدوياً لمجموعة "الموارد البشرية" بشكل منفصل. -->
        <record id="group_recruitment_workflow_operations" model="res.groups">
            <field name="name">مدير العمليات</field>
            <field name="sequence">30</field>
            <field name="privilege_id" ref="privilege_recruitment_workflow"/>
            <field name="implied_ids" eval="[
                (4, ref('group_recruitment_workflow_project_manager')),
                (4, ref('group_recruitment_workflow_hr')),
            ]"/>
        </record>

        <!-- المحاسب: يعتمد سداد الرسوم قبل المتابعة -->
        <record id="group_recruitment_workflow_accountant" model="res.groups">
            <field name="name">المحاسب</field>
            <field name="sequence">45</field>
            <field name="privilege_id" ref="privilege_recruitment_workflow"/>
            <field name="implied_ids" eval="[(4, ref('group_recruitment_workflow_user'))]"/>
        </record>

        <!-- المدير العام -->
        <record id="group_recruitment_workflow_gm" model="res.groups">
            <field name="name">المدير العام</field>
            <field name="sequence">40</field>
            <field name="privilege_id" ref="privilege_recruitment_workflow"/>
            <field name="implied_ids" eval="[(4, ref('group_recruitment_workflow_operations'))]"/>
        </record>

        <!-- قسم الأسطول -->
        <record id="group_recruitment_workflow_fleet" model="res.groups">
            <field name="name">قسم الأسطول</field>
            <field name="sequence">50</field>
            <field name="privilege_id" ref="privilege_recruitment_workflow"/>
            <field name="implied_ids" eval="[(4, ref('group_recruitment_workflow_user'))]"/>
        </record>

        <!-- مدير النظام (كامل الصلاحيات) -->
        <record id="group_recruitment_workflow_manager" model="res.groups">
            <field name="name">مدير سير العمل (كامل الصلاحيات)</field>
            <field name="sequence">60</field>
            <field name="privilege_id" ref="privilege_recruitment_workflow"/>
            <field name="implied_ids" eval="[
                (4, ref('group_recruitment_workflow_gm')),
                (4, ref('group_recruitment_workflow_fleet')),
                (4, ref('group_recruitment_workflow_accountant')),
                (4, ref('group_recruitment_workflow_hr')),
            ]"/>
            <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
        </record>

        <!-- قاعدة سجلات: عزل حسب الشركة -->
        <record id="recruitment_request_company_rule" model="ir.rule">
            <field name="name">طلبات التوظيف: حسب الشركة</field>
            <field name="model_id" ref="model_recruitment_request"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="recruitment_request_attachment_company_rule" model="ir.rule">
            <field name="name">مرفقات طلبات التوظيف: حسب الشركة</field>
            <field name="model_id" ref="model_recruitment_request_attachment"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('request_id.company_id', '=', False), ('request_id.company_id', 'in', company_ids)]</field>
        </record>

        <record id="hr_employee_cost_company_rule" model="ir.rule">
            <field name="name">تكاليف الموظفين: حسب الشركة</field>
            <field name="model_id" ref="model_hr_employee_cost"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="hr_employee_platform_history_company_rule" model="ir.rule">
            <field name="name">تاريخ منصات الموظفين: حسب الشركة</field>
            <field name="model_id" ref="model_hr_employee_platform_history"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="hr_employee_platform_transfer_request_company_rule" model="ir.rule">
            <field name="name">طلبات نقل الموظفين بين المنصات: حسب الشركة</field>
            <field name="model_id" ref="model_hr_employee_platform_transfer_request"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

    </data>
</odoo>
