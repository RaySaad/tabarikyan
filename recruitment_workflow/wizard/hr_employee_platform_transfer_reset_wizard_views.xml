<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_hr_employee_platform_transfer_reset_wizard_form" model="ir.ui.view">
        <field name="name">hr.employee.platform.transfer.reset.wizard.form</field>
        <field name="model">hr.employee.platform.transfer.reset.wizard</field>
        <field name="arch" type="xml">
            <form string="إعادة طلب النقل لمسودة">
                <group>
                    <field name="request_id" readonly="1"/>
                    <field name="reason" placeholder="مثال: بيانات خاطئة، تراجع الموظف عن النقل..."/>
                </group>
                <footer>
                    <button name="action_confirm_reset" type="object"
                            string="تأكيد الإعادة لمسودة" class="btn-primary"/>
                    <button string="إلغاء" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
