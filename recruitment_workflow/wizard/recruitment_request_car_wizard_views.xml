<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_recruitment_request_car_wizard_form" model="ir.ui.view">
        <field name="name">recruitment.request.car.wizard.form</field>
        <field name="model">recruitment.request.car.wizard</field>
        <field name="arch" type="xml">
            <form string="طلب سيارة من الأسطول">
                <field name="request_id" invisible="1"/>
                <field name="project_id" invisible="1"/>
                <div class="alert alert-info" role="alert">
                    <field name="project_id" class="d-inline" readonly="1"/> -
                    عدد السيارات المتاحة: <field name="available_count" class="d-inline"/>
                </div>
                <group>
                    <field name="vehicle_id"
                           options="{'no_create': True}"/>
                </group>
                <footer>
                    <button name="action_send_request" type="object"
                            string="إرسال الطلب للأسطول" class="btn-primary"/>
                    <button string="إلغاء" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
