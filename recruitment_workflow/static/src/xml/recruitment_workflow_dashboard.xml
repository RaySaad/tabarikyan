<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="recruitment_workflow.RecruitmentWorkflowDashboard">
        <div class="o_recruitment_workflow_dashboard o_action position-relative h-100 overflow-auto" dir="rtl">

            <!-- مؤشر التحميل (Loading Spinner) -->
            <div t-if="state.isLoading" class="o_rw_loading_overlay d-flex flex-column justify-content-center align-items-center">
                <div class="spinner-border text-primary mb-3" style="width: 3.5rem; height: 3.5rem;" role="status"/>
                <h5 class="text-muted fw-bold">جاري تحميل لوحة مؤشرات التوظيف...</h5>
            </div>

            <div class="container-fluid p-4" t-if="!state.isLoading">

                <!-- 1. شريط التحكم والترويسة (Header & Controls) -->
                <div class="row align-items-center mb-4 g-3">
                    <div class="col-12 col-lg-5">
                        <div class="d-flex align-items-center">
                            <div class="o_rw_header_icon me-3">
                                <i class="fa fa-id-badge fa-2x text-primary"/>
                            </div>
                            <div>
                                <h3 class="fw-bold mb-1 text-dark">لوحة مؤشرات سير عمل التوظيف</h3>
                                <p class="text-muted mb-0 small">نظرة شاملة لمراحل الاستقطاب، الموافقات، تسليم السيارات، وتوزيع المناديب</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-lg-7">
                        <div class="d-flex flex-wrap justify-content-lg-end align-items-center gap-2">
                            <!-- فلتر الفترة الزمنية -->
                            <div class="d-flex align-items-center bg-white rounded-pill px-3 py-1 border shadow-sm">
                                <i class="fa fa-calendar-o text-muted me-2"/>
                                <span class="small text-muted me-2">الفترة:</span>
                                <select class="form-select form-select-sm border-0 bg-transparent fw-bold" 
                                        style="cursor: pointer; width: auto;"
                                        t-model="state.selectedPeriod" 
                                        t-on-change="onPeriodChange">
                                    <option value="today">اليوم</option>
                                    <option value="this_week">هذا الأسبوع</option>
                                    <option value="this_month">هذا الشهر</option>
                                    <option value="last_month">الشهر الماضي</option>
                                    <option value="this_year">هذه السنة</option>
                                    <option value="all">كل الأوقات</option>
                                </select>
                            </div>

                            <!-- فلتر المنصة / المشروع -->
                            <div class="d-flex align-items-center bg-white rounded-pill px-3 py-1 border shadow-sm">
                                <i class="fa fa-cubes text-muted me-2"/>
                                <span class="small text-muted me-2">المنصة:</span>
                                <select class="form-select form-select-sm border-0 bg-transparent fw-bold" 
                                        style="cursor: pointer; width: auto;"
                                        t-model="state.selectedProjectId" 
                                        t-on-change="onProjectChange">
                                    <option value="0">جميع المنصات</option>
                                    <t t-foreach="state.projects" t-as="proj" t-key="proj.id">
                                        <option t-att-value="proj.id" t-esc="proj.name"/>
                                    </t>
                                </select>
                            </div>

                            <!-- زر التحديث السريع -->
                            <button class="btn btn-outline-primary rounded-pill shadow-sm px-3" 
                                    t-on-click="refreshDashboard" 
                                    title="تحديث البيانات">
                                <i class="fa fa-refresh me-1"/> تحديث
                            </button>
                        </div>
                    </div>
                </div>

                <!-- 2. مركز الإجراءات السريعة (Quick Action Bar) -->
                <div class="card border-0 shadow-sm rounded-4 mb-4 o_rw_quick_bar">
                    <div class="card-body p-3">
                        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
                            <span class="fw-bold small text-secondary d-none d-md-inline">
                                <i class="fa fa-bolt text-warning me-1"/> إجراءات سريعة:
                            </span>
                            <div class="d-flex flex-wrap gap-2">
                                <button class="btn btn-sm btn-light border rounded-pill px-3 fw-bold" t-on-click="() => this.createRecord('recruitment.request', 'طلب توظيف جديد')">
                                    <i class="fa fa-user-plus text-primary me-1"/> طلب توظيف جديد
                                </button>
                                <button class="btn btn-sm btn-light border rounded-pill px-3 fw-bold" t-on-click="() => this.createRecord('hr.employee.platform.transfer.request', 'طلب نقل منصة جديد')">
                                    <i class="fa fa-exchange text-info me-1"/> نقل منصة
                                </button>
                                <button class="btn btn-sm btn-light border rounded-pill px-3 fw-bold" t-on-click="() => this.createRecord('fleet.vehicle.change.request', 'طلب تغيير سيارة')">
                                    <i class="fa fa-car text-warning me-1"/> تغيير سيارة
                                </button>
                                <button class="btn btn-sm btn-light border rounded-pill px-3 fw-bold" t-on-click="() => this.createRecord('fleet.accident.report', 'تسجيل حادث مروري')">
                                    <i class="fa fa-ambulance text-danger me-1"/> تقرير حادث
                                </button>
                                <button class="btn btn-sm btn-light border rounded-pill px-3 fw-bold" t-on-click="() => this.createRecord('hr.employee.warning', 'تسجيل إنذار لمندوب')">
                                    <i class="fa fa-exclamation-triangle text-secondary me-1"/> إنذار مندوب
                                </button>
                                <button class="btn btn-sm btn-light border rounded-pill px-3 fw-bold" t-on-click="() => this.createRecord('hr.employee.exit.request', 'طلب إنهاء خدمة')">
                                    <i class="fa fa-sign-out text-danger me-1"/> إنهاء خدمة
                                </button>
                                <button class="btn btn-sm btn-primary rounded-pill px-3 fw-bold shadow-sm" t-on-click="openBulkAssignWizard">
                                    <i class="fa fa-users me-1"/> نقل منصات جماعي
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 3. شريط التنبيهات الذكية (Smart Alerts) -->
                <!-- تنبيه عجز سيارات التوظيف -->
                <div t-if="state.alerts.car_shortage_alert and state.alerts.car_shortage_alert.has_shortage" 
                     class="alert alert-danger border-0 shadow-sm rounded-4 d-flex align-items-center justify-content-between p-3 mb-4">
                    <div class="d-flex align-items-center">
                        <div class="o_rw_alert_icon bg-danger text-white rounded-circle p-2 me-3 d-flex align-items-center justify-content-center" style="width: 42px; height: 42px;">
                            <i class="fa fa-car fa-lg"/>
                        </div>
                        <div>
                            <h6 class="mb-0 fw-bold text-dark">عجز في سيارات التوظيف المتاحة</h6>
                            <p class="mb-0 small text-muted">
                                يوجد <strong class="text-danger" t-esc="state.alerts.car_shortage_alert.waiting_car"/> طلب بانتظار تخصيص سيارة، بينما يتوفر في الأسطول فقط 
                                <strong class="text-dark" t-esc="state.alerts.car_shortage_alert.available_vehicles"/> سيارة شاغرة جاهزة للتسليم.
                            </p>
                        </div>
                    </div>
                    <div class="d-flex gap-2">
                        <button class="btn btn-danger btn-sm fw-bold px-3 shadow-sm rounded-pill text-white" 
                                t-on-click="() => this.openRecords('recruitment.request', [['stage_code', '=', 'car_request']], 'طلبات بانتظار سيارة')">
                            <i class="fa fa-eye me-1"/> مراجعة طلبات السيارات
                        </button>
                    </div>
                </div>

                <!-- تنبيه اقتراب انتهاء الإقامات -->
                <div t-if="state.alerts.iqama_expiring_count > 0" 
                     class="alert alert-warning border-0 shadow-sm rounded-4 d-flex align-items-center justify-content-between p-3 mb-4">
                    <div class="d-flex align-items-center">
                        <div class="o_rw_alert_icon bg-warning text-white rounded-circle p-2 me-3 d-flex align-items-center justify-content-center" style="width: 42px; height: 42px;">
                            <i class="fa fa-id-card-o fa-lg"/>
                        </div>
                        <div>
                            <h6 class="mb-0 fw-bold text-dark">إقامات قاربت على الانتهاء خلال 60 يوماً</h6>
                            <p class="mb-0 small text-muted">
                                يوجد <strong class="text-danger" t-esc="state.alerts.iqama_expiring_count"/> مندوب تنتهي إقامتهم قريباً ويتطلب تجديدها تفادياً للغرامات وتوقف العمل.
                            </p>
                        </div>
                    </div>
                    <button class="btn btn-outline-warning btn-sm fw-bold px-3 rounded-pill text-dark" 
                            t-on-click="openExpiringIqamas">
                        <i class="fa fa-users me-1"/> عرض المناديب
                    </button>
                </div>

                <!-- تنبيه طلبات بمرفقات ناقصة -->
                <div t-if="state.alerts.incomplete_att_count > 0" 
                     class="alert alert-info border-0 shadow-sm rounded-4 d-flex align-items-center justify-content-between p-3 mb-4">
                    <div class="d-flex align-items-center">
                        <div class="o_rw_alert_icon bg-info text-white rounded-circle p-2 me-3 d-flex align-items-center justify-content-center" style="width: 42px; height: 42px;">
                            <i class="fa fa-paperclip fa-lg"/>
                        </div>
                        <div>
                            <h6 class="mb-0 fw-bold text-dark">طلبات توظيف بمرفقات إجبارية غير مكتملة</h6>
                            <p class="mb-0 small text-muted">
                                يوجد <strong class="text-primary" t-esc="state.alerts.incomplete_att_count"/> طلب توظيف قيد المعالجة يحتاج استكمال المرفقات للانتقال للمراحل التالية.
                            </p>
                        </div>
                    </div>
                    <button class="btn btn-outline-info btn-sm fw-bold px-3 rounded-pill" 
                            t-on-click="() => this.openRecords('recruitment.request', [['has_missing_mandatory_attachments', '=', true], ['state', '=', 'in_progress']], 'طلبات بمرفقات ناقصة')">
                        عرض الطلبات
                    </button>
                </div>

                <!-- 4. بطاقات المؤشرات التشغيلية الرئيسية (KPI Cards) -->
                <div class="row g-3 mb-4">
                    <!-- إجمالي طلبات التوظيف -->
                    <div class="col-12 col-md-6 col-xl-2">
                        <div class="card h-100 border-0 shadow-sm rounded-4 o_rw_kpi_card o_rw_card_total p-3"
                             role="button" t-on-click="() => this.openRecords('recruitment.request', [], 'جميع طلبات التوظيف')">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <span class="text-muted small fw-bold">إجمالي الطلبات</span>
                                <div class="o_rw_card_mini_icon text-primary"><i class="fa fa-file-text-o"/></div>
                            </div>
                            <h3 class="fw-bold mb-1 text-primary" t-esc="state.kpis.total_requests"/>
                            <div class="d-flex align-items-center justify-content-between mt-2 pt-2 border-top">
                                <span t-if="state.kpis.growth_rate !== 0" 
                                      t-attf-class="badge rounded-pill small #{state.kpis.growth_rate > 0 ? 'bg-success-subtle text-success' : 'bg-danger-subtle text-danger'}">
                                    <i t-attf-class="fa #{state.kpis.growth_rate > 0 ? 'fa-arrow-up' : 'fa-arrow-down'} me-1"/>
                                    <t t-esc="Math.abs(state.kpis.growth_rate)"/>%
                                </span>
                                <span t-else="" class="small text-muted">مقارنة بالفترة السابقة</span>
                            </div>
                        </div>
                    </div>

                    <!-- قيد المعالجة -->
                    <div class="col-12 col-md-6 col-xl-2">
                        <div class="card h-100 border-0 shadow-sm rounded-4 o_rw_kpi_card o_rw_card_inprogress p-3"
                             role="button" t-on-click="() => this.openRecords('recruitment.request', [['state', '=', 'in_progress']], 'طلبات قيد المعالجة')">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <span class="text-muted small fw-bold">قيد المعالجة</span>
                                <div class="o_rw_card_mini_icon text-warning"><i class="fa fa-clock-o"/></div>
                            </div>
                            <h3 class="fw-bold mb-1 text-warning" t-esc="state.kpis.in_progress_count"/>
                            <div class="mt-2 pt-2 border-top small text-muted">
                                طلبات بمختلف المراحل
                            </div>
                        </div>
                    </div>

                    <!-- تم مباشرة العمل -->
                    <div class="col-12 col-md-6 col-xl-2">
                        <div class="card h-100 border-0 shadow-sm rounded-4 o_rw_kpi_card o_rw_card_started p-3"
                             role="button" t-on-click="() => this.openRecords('recruitment.request', [['stage_code', '=', 'started']], 'مناديب باشروا العمل')">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <span class="text-muted small fw-bold">تمت المباشرة</span>
                                <div class="o_rw_card_mini_icon text-success"><i class="fa fa-check-circle-o"/></div>
                            </div>
                            <h3 class="fw-bold mb-1 text-success" t-esc="state.kpis.started_count"/>
                            <div class="d-flex align-items-center justify-content-between mt-2 pt-2 border-top">
                                <span class="badge bg-success-subtle text-success rounded-pill small">
                                    نجاح <t t-esc="state.kpis.success_rate"/>%
                                </span>
                            </div>
                        </div>
                    </div>

                    <!-- طلبات مرفوضة -->
                    <div class="col-12 col-md-6 col-xl-2">
                        <div class="card h-100 border-0 shadow-sm rounded-4 o_rw_kpi_card o_rw_card_rejected p-3"
                             role="button" t-on-click="() => this.openRecords('recruitment.request', [['state', '=', 'rejected']], 'طلبات مرفوضة')">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <span class="text-muted small fw-bold">مرفوضة</span>
                                <div class="o_rw_card_mini_icon text-danger"><i class="fa fa-times-circle-o"/></div>
                            </div>
                            <h3 class="fw-bold mb-1 text-danger" t-esc="state.kpis.rejected_count"/>
                            <div class="d-flex align-items-center justify-content-between mt-2 pt-2 border-top">
                                <span class="badge bg-danger-subtle text-danger rounded-pill small">
                                    نسبة <t t-esc="state.kpis.rejection_rate"/>%
                                </span>
                            </div>
                        </div>
                    </div>

                    <!-- المناديب النشطين -->
                    <div class="col-12 col-md-6 col-xl-2">
                        <div class="card h-100 border-0 shadow-sm rounded-4 o_rw_kpi_card o_rw_card_couriers p-3"
                             role="button" t-on-click="() => this.openRecords('hr.employee', [['is_courier', '=', true]], 'المناديب النشطين')">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <span class="text-muted small fw-bold">المناديب النشطين</span>
                                <div class="o_rw_card_mini_icon text-info"><i class="fa fa-users"/></div>
                            </div>
                            <h3 class="fw-bold mb-1 text-info" t-esc="state.kpis.active_couriers_count"/>
                            <div class="mt-2 pt-2 border-top small text-muted">
                                إجمالي كادر المناديب
                            </div>
                        </div>
                    </div>

                    <!-- كفاءة الأسطول -->
                    <div class="col-12 col-md-6 col-xl-2">
                        <div class="card h-100 border-0 shadow-sm rounded-4 o_rw_kpi_card o_rw_card_fleet p-3"
                             role="button" t-on-click="() => this.openRecords('fleet.vehicle', [], 'أسطول المركبات')">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <span class="text-muted small fw-bold">إشغال الأسطول</span>
                                <div class="o_rw_card_mini_icon text-purple"><i class="fa fa-car" style="color: #8b5cf6;"/></div>
                            </div>
                            <h3 class="fw-bold mb-1" style="color: #8b5cf6;" t-esc="state.kpis.fleet_allocation_rate + '%'"/>
                            <div class="d-flex align-items-center justify-content-between mt-2 pt-2 border-top small text-muted">
                                <span><strong t-esc="state.kpis.assigned_vehicles"/> مسلّمة</span>
                                <span>من <strong t-esc="state.kpis.total_vehicles"/></span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 5. مسار الموافقات والمراحل المعلقة (Approvals & Stages Pipeline) -->
                <div class="card border-0 shadow-sm rounded-4 mb-4">
                    <div class="card-header bg-white border-0 pt-3 pb-0 px-4">
                        <div class="d-flex align-items-center justify-content-between">
                            <h5 class="fw-bold mb-0 text-dark">
                                <i class="fa fa-tasks text-primary me-2"/> مسار الموافقات والعمليات الجارية
                            </h5>
                            <span class="badge bg-secondary-subtle text-secondary rounded-pill small">تتطلب متابعة أو إجراء</span>
                        </div>
                    </div>
                    <div class="card-body px-4 pb-4 pt-3">
                        <div class="row g-3">
                            <!-- 1. مراجعة مسؤول المشروع -->
                            <div class="col-12 col-sm-6 col-lg-4 col-xl-3">
                                <div class="o_rw_pipeline_item p-3 rounded-4 border bg-light h-100"
                                     role="button" t-on-click="() => this.openRecords('recruitment.request', [['stage_code', '=', 'project_review']], 'بانتظار مراجعة مسؤول المشروع')">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <span class="fw-bold text-dark small">مراجعة مسؤول المشروع</span>
                                        <span class="badge bg-primary text-white rounded-pill" t-esc="state.approvals.wait_pm"/>
                                    </div>
                                    <div class="small text-muted mt-2">تدقيق البيانات والمنصة ➔</div>
                                </div>
                            </div>

                            <!-- 2. مراجعة مدير العمليات -->
                            <div class="col-12 col-sm-6 col-lg-4 col-xl-3">
                                <div class="o_rw_pipeline_item p-3 rounded-4 border bg-light h-100"
                                     role="button" t-on-click="() => this.openRecords('recruitment.request', [['stage_code', '=', 'operations_review']], 'بانتظار مراجعة مدير العمليات')">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <span class="fw-bold text-dark small">مراجعة مدير العمليات</span>
                                        <span class="badge bg-warning text-dark rounded-pill" t-esc="state.approvals.wait_ops"/>
                                    </div>
                                    <div class="small text-muted mt-2">التحقق التشغيلي والمطابقة ➔</div>
                                </div>
                            </div>

                            <!-- 3. اعتماد المدير العام -->
                            <div class="col-12 col-sm-6 col-lg-4 col-xl-3">
                                <div class="o_rw_pipeline_item p-3 rounded-4 border bg-light h-100"
                                     role="button" t-on-click="() => this.openRecords('recruitment.request', [['stage_code', '=', 'gm_approval']], 'بانتظار اعتماد المدير العام')">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <span class="fw-bold text-dark small">اعتماد المدير العام</span>
                                        <span class="badge bg-danger text-white rounded-pill" t-esc="state.approvals.wait_gm"/>
                                    </div>
                                    <div class="small text-muted mt-2">الموافقة النهائية للاستقطاب ➔</div>
                                </div>
                            </div>

                            <!-- 4. بانتظار السداد المالي -->
                            <div class="col-12 col-sm-6 col-lg-4 col-xl-3">
                                <div class="o_rw_pipeline_item p-3 rounded-4 border bg-light h-100"
                                     role="button" t-on-click="() => this.openRecords('recruitment.request', [['stage_code', '=', 'paid']], 'بانتظار السداد المالي')">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <span class="fw-bold text-dark small">بانتظار السداد المالي</span>
                                        <span class="badge bg-info text-white rounded-pill" t-esc="state.approvals.wait_paid"/>
                                    </div>
                                    <div class="small text-muted mt-2">سداد رسوم النقل والخدمات ➔</div>
                                </div>
                            </div>

                            <!-- 5. جاري نقل الكفالة -->
                            <div class="col-12 col-sm-6 col-lg-4 col-xl-3">
                                <div class="o_rw_pipeline_item p-3 rounded-4 border bg-light h-100"
                                     role="button" t-on-click="() => this.openRecords('recruitment.request', [['stage_code', '=', 'sponsorship_transfer']], 'جاري نقل الكفالة')">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <span class="fw-bold text-dark small">جاري نقل الكفالة</span>
                                        <span class="badge bg-secondary text-white rounded-pill" t-esc="state.approvals.sponsorship_transfer"/>
                                    </div>
                                    <div class="small text-muted mt-2">إجراءات قوى ووزارة الموارد ➔</div>
                                </div>
                            </div>

                            <!-- 6. تم نقل الكفالة - الموارد البشرية -->
                            <div class="col-12 col-sm-6 col-lg-4 col-xl-3">
                                <div class="o_rw_pipeline_item p-3 rounded-4 border bg-light h-100"
                                     role="button" t-on-click="() => this.openRecords('recruitment.request', [['stage_code', '=', 'sponsorship_done']], 'تم نقل الكفالة')">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <span class="fw-bold text-dark small">تم نقل الكفالة (HR)</span>
                                        <span class="badge bg-teal text-white rounded-pill" style="background-color: #0d9488;" t-esc="state.approvals.sponsorship_done"/>
                                    </div>
                                    <div class="small text-muted mt-2">استكمال ملف الموظف ➔</div>
                                </div>
                            </div>

                            <!-- 7. طلب سيارة - انتظار التخصيص -->
                            <div class="col-12 col-sm-6 col-lg-4 col-xl-3">
                                <div class="o_rw_pipeline_item p-3 rounded-4 border bg-light h-100"
                                     role="button" t-on-click="() => this.openRecords('recruitment.request', [['stage_code', '=', 'car_request']], 'بانتظار تخصيص سيارة')">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <span class="fw-bold text-dark small">طلب سيارة (الأسطول)</span>
                                        <span class="badge bg-purple text-white rounded-pill" style="background-color: #7c3aed;" t-esc="state.approvals.wait_car"/>
                                    </div>
                                    <div class="small text-muted mt-2">تسليم وتوقيع العهدة ➔</div>
                                </div>
                            </div>

                            <!-- 8. طلبات نقل المنصات المعلقة -->
                            <div class="col-12 col-sm-6 col-lg-4 col-xl-3">
                                <div class="o_rw_pipeline_item p-3 rounded-4 border bg-light h-100"
                                     role="button" t-on-click="() => this.openRecords('hr.employee.platform.transfer.request', [['state', 'in', ['draft', 'ops_review']]], 'طلبات نقل المنصة المعلقة')">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <span class="fw-bold text-dark small">نقل منصات معلق</span>
                                        <span class="badge bg-dark text-white rounded-pill" t-esc="state.approvals.pending_transfers"/>
                                    </div>
                                    <div class="small text-muted mt-2">مناقلات مناديب بين التطبيقات ➔</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 6. الرسوم البيانية التفاعلية (Interactive Visual Analytics) -->
                <!-- الصف الأول من الرسوم: مسار المراحل وتوزيع المنصات -->
                <div class="row g-4 mb-4">
                    <!-- مسار مراحل التوظيف (Funnel) -->
                    <div class="col-12 col-lg-7">
                        <div class="card border-0 shadow-sm rounded-4 h-100 o_rw_chart_card p-4">
                            <div class="d-flex align-items-center justify-content-between mb-3">
                                <div>
                                    <h5 class="fw-bold mb-1 text-dark">
                                        <i class="fa fa-filter text-primary me-2"/> مسار مراحل التوظيف (Funnel)
                                    </h5>
                                    <span class="text-muted small">توزيع الطلبات النشطة عبر مراحل سير العمل الـ 9 المعتمدة</span>
                                </div>
                            </div>
                            <div class="chart-container" style="height: 310px;">
                                <canvas t-ref="funnelChart"/>
                            </div>
                        </div>
                    </div>

                    <!-- التوزيع النسبي للمناديب حسب المنصة -->
                    <div class="col-12 col-lg-5">
                        <div class="card border-0 shadow-sm rounded-4 h-100 o_rw_chart_card p-4">
                            <div class="d-flex align-items-center justify-content-between mb-3">
                                <div>
                                    <h5 class="fw-bold mb-1 text-dark">
                                        <i class="fa fa-pie-chart text-info me-2"/> توزيع المناديب حسب المنصة
                                    </h5>
                                    <span class="text-muted small">نسبة تواجد المناديب على تطبيقات التوصيل المختلفة</span>
                                </div>
                            </div>
                            <div class="chart-container" style="height: 310px;">
                                <canvas t-ref="platformChart"/>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- الصف الثاني من الرسوم: الاتجاه الزمني، أنظمة العمل، والأسطول -->
                <div class="row g-4 mb-4">
                    <!-- الاتجاه الشهري لحركة التوظيف -->
                    <div class="col-12 col-lg-6">
                        <div class="card border-0 shadow-sm rounded-4 h-100 o_rw_chart_card p-4">
                            <div class="d-flex align-items-center justify-content-between mb-3">
                                <div>
                                    <h5 class="fw-bold mb-1 text-dark">
                                        <i class="fa fa-line-chart text-success me-2"/> الاتجاه الشهري للتوظيف (آخر 6 أشهر)
                                    </h5>
                                    <span class="text-muted small">مقارنة بين الطلبات الجديدة، المباشرة الناجحة، والطلبات المرفوضة</span>
                                </div>
                            </div>
                            <div class="chart-container" style="height: 280px;">
                                <canvas t-ref="monthlyTrendChart"/>
                            </div>
                        </div>
                    </div>

                    <!-- أنظمة العمل والتعويضات -->
                    <div class="col-12 col-lg-3">
                        <div class="card border-0 shadow-sm rounded-4 h-100 o_rw_chart_card p-4">
                            <div class="d-flex align-items-center justify-content-between mb-3">
                                <div>
                                    <h5 class="fw-bold mb-1 text-dark">
                                        <i class="fa fa-briefcase text-warning me-2"/> أنظمة العمل
                                    </h5>
                                    <span class="text-muted small">توزيع المناديب حسب نظام التشغيل</span>
                                </div>
                            </div>
                            <div class="chart-container" style="height: 280px;">
                                <canvas t-ref="compensationChart"/>
                            </div>
                        </div>
                    </div>

                    <!-- جاهزية أسطول المركبات -->
                    <div class="col-12 col-lg-3">
                        <div class="card border-0 shadow-sm rounded-4 h-100 o_rw_chart_card p-4">
                            <div class="d-flex align-items-center justify-content-between mb-3">
                                <div>
                                    <h5 class="fw-bold mb-1 text-dark">
                                        <i class="fa fa-truck text-purple me-2" style="color: #8b5cf6;"/> جاهزية الأسطول
                                    </h5>
                                    <span class="text-muted small">المركبات المسلمة مقابل الشاغرة</span>
                                </div>
                            </div>
                            <div class="chart-container" style="height: 280px;">
                                <canvas t-ref="fleetChart"/>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 7. سجل أحدث طلبات التوظيف (Recent Requests Table) -->
                <div class="card border-0 shadow-sm rounded-4 mb-4">
                    <div class="card-header bg-white border-0 pt-4 pb-2 px-4">
                        <div class="d-flex align-items-center justify-content-between">
                            <div>
                                <h5 class="fw-bold mb-1 text-dark">
                                    <i class="fa fa-clock-o text-muted me-2"/> أحدث طلبات التوظيف
                                </h5>
                                <span class="text-muted small">آخر 10 طلبات مسجلة على النظام مع تفاصيل المرحلة والحالة</span>
                            </div>
                            <button class="btn btn-outline-primary btn-sm rounded-pill px-3" 
                                    t-on-click="() => this.openRecords('recruitment.request', [], 'جميع طلبات التوظيف')">
                                عرض الكل <i class="fa fa-angle-left ms-1"/>
                            </button>
                        </div>
                    </div>
                    <div class="card-body px-4 pb-4 pt-2">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle o_rw_recent_table mb-0">
                                <thead>
                                    <tr>
                                        <th class="border-0">رقم الطلب</th>
                                        <th class="border-0">اسم المندوب</th>
                                        <th class="border-0">رقم الهوية</th>
                                        <th class="border-0">المنصة</th>
                                        <th class="border-0">المرحلة الحالية</th>
                                        <th class="border-0">الحالة</th>
                                        <th class="border-0">تاريخ الطلب</th>
                                        <th class="border-0 text-center">إجراء</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-if="state.recentRequests.length === 0">
                                        <tr>
                                            <td colspan="8" class="text-center py-4 text-muted">
                                                لا توجد طلبات توظيف مسجلة مطابقة للشروط المحددة
                                            </td>
                                        </tr>
                                    </t>
                                    <t t-foreach="state.recentRequests" t-as="req" t-key="req.id">
                                        <tr>
                                            <td class="fw-bold text-primary">
                                                <span role="button" t-on-click="() => this.viewRecord('recruitment.request', req.id, req.name)" t-esc="req.name"/>
                                            </td>
                                            <td class="fw-semibold text-dark" t-esc="req.employee_name"/>
                                            <td class="text-muted font-monospace" t-esc="req.identification_id"/>
                                            <td>
                                                <span class="badge bg-light text-dark border rounded-pill px-2 py-1" t-esc="req.project_name"/>
                                            </td>
                                            <td>
                                                <span class="badge bg-primary-subtle text-primary rounded-pill px-2 py-1" t-esc="req.stage_name"/>
                                            </td>
                                            <td>
                                                <span t-if="req.state === 'in_progress'" class="badge bg-warning-subtle text-warning rounded-pill px-2 py-1">قيد المعالجة</span>
                                                <span t-elif="req.state === 'done'" class="badge bg-success-subtle text-success rounded-pill px-2 py-1">مكتمل</span>
                                                <span t-elif="req.state === 'rejected'" class="badge bg-danger-subtle text-danger rounded-pill px-2 py-1">مرفوض</span>
                                                <span t-else="" class="badge bg-secondary rounded-pill px-2 py-1" t-esc="req.state_label"/>
                                            </td>
                                            <td class="text-muted small" t-esc="req.create_date"/>
                                            <td class="text-center">
                                                <button class="btn btn-sm btn-light border rounded-circle shadow-sm" 
                                                        t-on-click="() => this.viewRecord('recruitment.request', req.id, req.name)"
                                                        title="عرض التفاصيل">
                                                    <i class="fa fa-external-link text-primary"/>
                                                </button>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </t>
</templates>
