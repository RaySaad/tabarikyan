<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- تنبيه الموارد البشرية قبل انتهاء إقامة المندوب بالمدة
             المحددة في الإعدادات - انظر
             hr_employee.py._cron_notify_iqama_expiry. -->
        <record id="cron_recruitment_notify_iqama_expiry" model="ir.cron">
            <field name="name">سير التوظيف: تنبيه انتهاء الإقامة</field>
            <field name="model_id" ref="model_hr_employee"/>
            <field name="state">code</field>
            <field name="code">model._cron_notify_iqama_expiry()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

    </data>
</odoo>
