<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============ أنواع تكاليف الموظفين (إعدادات) ============
         تُستخدم حصراً كإعداد لآلية "رسوم التوظيف" في recruitment_
         request.py (fee_cost_type_id) - تحدد الحساب المحاسبي/دفتر
         اليومية عند إصدار فاتورة المورد. نموذج hr.employee.cost
         (تكاليف مستقلة بعد التوظيف) الذي كان يستخدم هذه الأنواع أيضاً
         حُذف (طلب صريح: "ليس له داعي" - لم يُستخدم فعلياً، ولا قائمة
         كانت تصل لسجلاته أصلاً). -->
    <record id="view_hr_employee_cost_type_list" model="ir.ui.view">
        <field name="name">hr.employee.cost.type.list</field>
        <field name="model">hr.employee.cost.type</field>
        <field name="arch" type="xml">
            <list string="أنواع تكاليف الموظفين" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="category"/>
                <field name="partner_id" optional="show"/>
                <field name="expense_account_id"/>
                <field name="journal_id"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_hr_employee_cost_type_form" model="ir.ui.view">
        <field name="name">hr.employee.cost.type.form</field>
        <field name="model">hr.employee.cost.type</field>
        <field name="arch" type="xml">
            <form string="نوع تكلفة الموظف">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="category"/>
                        <field name="partner_id"/>
                        <field name="expense_account_id"/>
                        <field name="journal_id"/>
                        <field name="active"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hr_employee_cost_type" model="ir.actions.act_window">
        <field name="name">أنواع تكاليف الموظفين</field>
        <field name="res_model">hr.employee.cost.type</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiley_face">
                أضف أول نوع تكلفة (مثال: تأشيرة، رسوم توظيف...)
            </p>
        </field>
    </record>

</odoo>
