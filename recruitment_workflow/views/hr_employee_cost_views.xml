<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============ أنواع التكاليف (إعدادات) ============ -->
    <record id="view_hr_employee_cost_type_list" model="ir.ui.view">
        <field name="name">hr.employee.cost.type.list</field>
        <field name="model">hr.employee.cost.type</field>
        <field name="arch" type="xml">
            <list string="أنواع تكاليف الموظفين" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="category"/>
                <field name="partner_id" optional="show"/>
                <field name="expense_account_id"/>
                <field name="journal_id"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_hr_employee_cost_type_form" model="ir.ui.view">
        <field name="name">hr.employee.cost.type.form</field>
        <field name="model">hr.employee.cost.type</field>
        <field name="arch" type="xml">
            <form string="نوع تكلفة الموظف">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="category"/>
                        <field name="partner_id"/>
                        <field name="expense_account_id"/>
                        <field name="journal_id"/>
                        <field name="active"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hr_employee_cost_type" model="ir.actions.act_window">
        <field name="name">أنواع تكاليف الموظفين</field>
        <field name="res_model">hr.employee.cost.type</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiley_face">
                أضف أول نوع تكلفة (مثال: تجديد إقامة، نقل، تأشيرة خروج/عودة...)
            </p>
        </field>
    </record>

    <!-- ============ التكاليف (قائمة واحدة داخل التوظيف) ============ -->
    <record id="view_hr_employee_cost_list" model="ir.ui.view">
        <field name="name">hr.employee.cost.list</field>
        <field name="model">hr.employee.cost</field>
        <field name="arch" type="xml">
            <list string="تكاليف الموظفين حسب المنصة"
                  decoration-success="state == 'submitted'"
                  decoration-muted="state == 'cancelled'">
                <field name="date"/>
                <field name="employee_id"/>
                <field name="project_id"/>
                <field name="cost_type_id"/>
                <field name="category" optional="hide"/>
                <field name="partner_id" optional="hide"/>
                <field name="amount" sum="الإجمالي"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="payment_state" optional="show"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'submitted'"
                       decoration-muted="state == 'cancelled'"
                       decoration-info="state == 'draft'"/>
            </list>
        </field>
    </record>

    <record id="view_hr_employee_cost_form" model="ir.ui.view">
        <field name="name">hr.employee.cost.form</field>
        <field name="model">hr.employee.cost</field>
        <field name="arch" type="xml">
            <form string="تكلفة موظف">
                <header>
                    <button name="action_submit_to_accounting" type="object"
                            string="رفع للمحاسبة" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_cancel" type="object" string="إلغاء"
                            invisible="state not in ('draft', 'submitted')"/>
                    <button name="action_reset_to_draft" type="object" string="إعادة لمسودة"
                            invisible="state != 'cancelled' or move_id"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,submitted"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_move" type="object"
                                class="oe_stat_button" icon="fa-file-text-o"
                                groups="recruitment_workflow.group_recruitment_workflow_operations"
                                invisible="not move_id">
                            <div class="o_stat_info">
                                <span class="o_stat_text">فاتورة المورد</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="display_name" readonly="1"/></h1>
                    </div>
                    <div class="alert alert-info" role="alert"
                         invisible="state != 'submitted'">
                        تم رفع هذه التكلفة كفاتورة مورد. المراجعة والاعتماد والدفع
                        الآن من مسؤولية فريق المحاسبة داخل تطبيق المحاسبة
                        (فواتير الموردين ← تسجيل الدفعة).
                        حالة الفاتورة: <field name="move_state" class="d-inline" readonly="1"/> -
                        حالة الدفع: <field name="payment_state" class="d-inline" readonly="1"/>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="cost_type_id"/>
                            <field name="partner_id" options="{'no_create': True}"/>
                            <field name="date"/>
                        </group>
                        <group>
                            <field name="project_id" options="{'no_create': True}"/>
                            <field name="analytic_account_id" readonly="1"/>
                            <field name="amount"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <field name="description" placeholder="تفاصيل إضافية عن التكلفة..."/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_hr_employee_cost_search" model="ir.ui.view">
        <field name="name">hr.employee.cost.search</field>
        <field name="model">hr.employee.cost</field>
        <field name="arch" type="xml">
            <search string="بحث تكاليف الموظفين">
                <field name="employee_id"/>
                <field name="project_id"/>
                <field name="cost_type_id"/>
                <field name="partner_id"/>
                <field name="category"/>
                <separator/>
                <filter name="filter_government" string="مدفوعات حكومية" domain="[('category', '=', 'government')]"/>
                <separator/>
                <filter name="filter_draft" string="مسودة (لم تُرفع بعد)" domain="[('state', '=', 'draft')]"/>
                <filter name="filter_submitted" string="مرفوعة للمحاسبة" domain="[('state', '=', 'submitted')]"/>
                <filter name="filter_not_paid" string="غير مدفوعة" domain="[('payment_state', 'in', ('not_paid', 'partial'))]"/>
                <separator/>
                <filter name="group_project" string="المشروع/المنصة" context="{'group_by': 'project_id'}"/>
                <filter name="group_employee" string="الموظف" context="{'group_by': 'employee_id'}"/>
                <filter name="group_cost_type" string="نوع التكلفة" context="{'group_by': 'cost_type_id'}"/>
                <filter name="group_category" string="التصنيف" context="{'group_by': 'category'}"/>
                <filter name="group_state" string="الحالة" context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <record id="action_hr_employee_cost" model="ir.actions.act_window">
        <field name="name">تكاليف الموظفين حسب المنصة</field>
        <field name="res_model">hr.employee.cost</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_hr_employee_cost_search"/>
        <field name="context">{'search_default_group_project': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiley_face">
                سجّل أول تكلفة (تجديد إقامة، نقل...) لموظف على مشروع/منصة
            </p>
            <p>
                اضغط "رفع للمحاسبة" لإنشاء فاتورة مورد تلقائياً موزّعة تحليلياً
                على المشروع، وتصير من مسؤولية فريق المحاسبة من هناك.
            </p>
        </field>
    </record>

</odoo>
