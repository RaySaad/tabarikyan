<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_recruitment_stage_list" model="ir.ui.view">
        <field name="name">recruitment.stage.list</field>
        <field name="model">recruitment.stage</field>
        <field name="arch" type="xml">
            <list string="المراحل" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="require_attachments"/>
                <field name="require_validation"/>
                <field name="require_car"/>
                <field name="is_closing_stage"/>
                <field name="fold"/>
            </list>
        </field>
    </record>

    <record id="view_recruitment_stage_form" model="ir.ui.view">
        <field name="name">recruitment.stage.form</field>
        <field name="model">recruitment.stage</field>
        <field name="arch" type="xml">
            <form string="المرحلة">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="require_attachments"/>
                            <field name="require_validation"/>
                            <field name="require_car"/>
                            <field name="is_closing_stage"/>
                            <field name="fold"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="الوصف">
                        <field name="description" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_recruitment_stage" model="ir.actions.act_window">
        <field name="name">المراحل</field>
        <field name="res_model">recruitment.stage</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
