<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- توسعة فورم الموظف: إضافة المنصة الحالية وزر النقل وسجل التاريخ -->
    <record id="view_hr_employee_form_inherit_recruitment" model="ir.ui.view">
        <field name="name">hr.employee.form.recruitment.platform</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_platform_history" type="object"
                        class="oe_stat_button" icon="fa-history"
                        invisible="platform_history_count == 0">
                    <field name="platform_history_count" widget="statinfo" string="فترات المنصات"/>
                </button>
                <button name="action_view_transfer_requests" type="object"
                        class="oe_stat_button" icon="fa-exchange"
                        invisible="pending_transfer_request_count == 0">
                    <field name="pending_transfer_request_count" widget="statinfo"
                           string="طلبات نقل معلّقة"/>
                </button>
                <button name="action_view_vehicle_change_requests" type="object"
                        class="oe_stat_button" icon="fa-car"
                        invisible="vehicle_change_request_count == 0">
                    <field name="vehicle_change_request_count" widget="statinfo"
                           string="طلبات تغيير المركبة"/>
                </button>
            </xpath>
            <xpath expr="//field[@name='job_id']" position="after">
                <field name="project_id" string="المنصة الحالية" readonly="1"
                       options="{'no_create': True}"/>
                <button name="action_open_platform_transfer_request" type="object"
                        string="طلب نقل لمنصة أخرى" class="btn-link"
                        icon="fa-exchange" invisible="not project_id"/>
                <field name="analytic_account_id" readonly="1" invisible="not analytic_account_id"/>
                <field name="absher_mobile"/>
            </xpath>
        </field>
    </record>

    <!-- زر "فتح إدخالات العمل" (hr_work_entry) يظهر شرطاً بحقل has_work_
         entries المقصور على base.group_system/hr.group_hr_user - لا علاقة
         له بمستخدمي السداد البنكي إطلاقاً (بيانات رواتب/حضور، وليست سلف/
         رسوم/تصفيات). كان يظهر لهم رغم ذلك (تعريفه الأصلي بلا قيد كافٍ)،
         مسبباً تحذير "عدم اتساق في صلاحيات الوصول" عند كل تحديث للموديول.
         نقيّده هنا ليطابق تماماً صلاحية الحقل نفسه.

         سجل منفصل عمداً، يرث مباشرة من عرض hr_work_entry نفسه (وليس من
         hr.view_employee_form الأساسي كالعرض أعلاه) - لأن أودو يدمج
         العروض المتفرّعة من نفس الأصل بترتيب حقل priority (الافتراضي 16)،
         وعرض hr_work_entry يحمل priority=90 (يُطبَّق متأخراً عمداً)، فزر
         "فتح إدخالات العمل" لم يكن موجوداً بعد في الشجرة المُجمَّعة وقت
         معالجة عرضنا أعلاه (priority الافتراضي) - فشل xpath هناك فعلياً
         عند الاختبار. الوراثة من عرض hr_work_entry مباشرة تضمن وجود الزر
         دائماً بغض النظر عن أي ترتيب priority مستقبلي. -->
    <record id="view_hr_employee_form_inherit_recruitment_work_entries" model="ir.ui.view">
        <field name="name">hr.employee.form.recruitment.work.entries.groups</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr_work_entry.hr_employee_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@id='open_work_entries']" position="attributes">
                <attribute name="groups">base.group_system,hr.group_hr_user</attribute>
            </xpath>
        </field>
    </record>

    <!-- إضافة "تجميع حسب المنصة" في بحث الموظفين - يسمح بعرض الموظفين
         مجمّعين ككيتا/هنقرستيشن... بدل قائمة مسطّحة واحدة -->
    <record id="view_employee_filter_inherit_recruitment" model="ir.ui.view">
        <field name="name">hr.employee.search.recruitment.platform</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_filter"/>
        <field name="arch" type="xml">
            <filter name="group_department" position="after">
                <filter name="group_recruitment_platform" string="المنصة"
                        domain="[]" context="{'group_by': 'project_id'}"/>
            </filter>
        </field>
    </record>

    <!-- قائمة/فورم تاريخ المنصات -->
    <record id="view_hr_employee_platform_history_list" model="ir.ui.view">
        <field name="name">hr.employee.platform.history.list</field>
        <field name="model">hr.employee.platform.history</field>
        <field name="arch" type="xml">
            <list string="تاريخ المنصات" default_order="date_start desc"
                  decoration-success="is_current">
                <field name="employee_id"/>
                <field name="project_id"/>
                <field name="analytic_account_id" optional="hide"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="is_current" widget="boolean_toggle" readonly="1"/>
                <field name="note" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_hr_employee_platform_history_form" model="ir.ui.view">
        <field name="name">hr.employee.platform.history.form</field>
        <field name="model">hr.employee.platform.history</field>
        <field name="arch" type="xml">
            <form string="فترة عمل على منصة">
                <group>
                    <field name="employee_id"/>
                    <field name="project_id"/>
                    <field name="analytic_account_id" readonly="1"/>
                    <field name="date_start"/>
                    <field name="date_end"/>
                    <field name="note"/>
                </group>
            </form>
        </field>
    </record>

    <record id="action_hr_employee_platform_history" model="ir.actions.act_window">
        <field name="name">تاريخ منصات المناديب</field>
        <field name="res_model">hr.employee.platform.history</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
