    <!-- إعداد لآلية "رسوم التوظيف" في recruitment_request.py
         (fee_cost_type_id) - وليس لنموذج تكاليف مستقل (حُذف، انظر
         hr_employee_cost_type_views.xml). -->
    <menuitem id="menu_hr_employee_cost_type"
              name="أنواع تكاليف الموظفين"
              parent="hr.menu_human_resources_configuration"
              action="action_hr_employee_cost_type"
              groups="recruitment_workflow.group_recruitment_workflow_manager"
              sequence="25"/>

    <!-- تكامل مع تطبيق Fleet: قائمة طلبات السيارات المعلّقة من التوظيف،
         تظهر جوه تطبيق Fleet نفسه بدل ما يحتاج مسؤول الأسطول يفتح تطبيق
         التوظيف. الأزرار (استلام/موافقة) تظهر تلقائياً حسب صلاحياته. -->
    <menuitem id="menu_fleet_recruitment_requests"
              name="طلبات السيارات (توظيف)"
              parent="fleet.menu_root"
              action="action_recruitment_request_fleet"
              groups="recruitment_workflow.group_recruitment_workflow_fleet"
              sequence="25"/>

    <menuitem id="menu_fleet_vehicle_branch_history"
              name="تاريخ فروع السيارات"
              parent="fleet.menu_root"
              action="action_fleet_vehicle_branch_history"
              groups="recruitment_workflow.group_recruitment_workflow_fleet"
              sequence="30"/>

    <!-- طلبات تغيير المركبات وبلاغات الحوادث تعيش في تطبيق "الأسطول"
         وليس في سير عمل التوظيف - المركبات مسؤولية قسم الأسطول/الحركة،
         وهناك يجدها من يعمل عليها يومياً (طلب صريح). المجموعات الثلاث
         (مشرف الحركة/مدير الصيانة/مدير الحركة) تمنح صلاحية الأسطول
         القياسية تلقائياً - انظر security - وإلا لما ظهر لهم التطبيق
         الأصلي أساساً فلا يرون هذه القوائم مهما مُنحوا صلاحيتها. -->
    <menuitem id="menu_fleet_vehicle_change_request"
              name="طلبات تغيير المركبات"
              parent="fleet.menu_root"
              action="action_fleet_vehicle_change_request"
