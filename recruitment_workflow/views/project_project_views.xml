<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_project_project_form_recruitment" model="ir.ui.view">
        <field name="name">project.project.form.recruitment.workflow</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <field name="user_id" position="after">
                <field name="default_job_id"
                       groups="recruitment_workflow.group_recruitment_workflow_user"/>
                <field name="compensation_type_ids" widget="many2many_tags"
                       options="{'no_create': True}"
                       groups="recruitment_workflow.group_recruitment_workflow_user"/>
                <field name="is_recruitment_open"
                       groups="recruitment_workflow.group_recruitment_workflow_user"/>
            </field>
        </field>
    </record>

</odoo>
