<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- توسعة نموذج السيارة في تطبيق الأسطول: إضافة حالة التوفر للتوظيف -->
    <record id="view_fleet_vehicle_form_inherit_recruitment" model="ir.ui.view">
        <field name="name">fleet.vehicle.form.recruitment</field>
        <field name="model">fleet.vehicle</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <header>
                    <button name="action_set_available" type="object"
                            string="تعيين كمتاحة للتوظيف" class="btn-primary"
                            invisible="recruitment_state == 'available'"/>
                    <button name="action_set_unavailable" type="object"
                            string="تعيين كغير متاحة"
                            invisible="recruitment_state == 'unavailable'"/>
                    <field name="recruitment_state" widget="statusbar"/>
                </header>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_branch_history" type="object"
                        class="oe_stat_button" icon="fa-history"
                        invisible="branch_history_count == 0">
                    <field name="branch_history_count" widget="statinfo" string="فترات الفروع"/>
                </button>
            </xpath>
            <xpath expr="//sheet" position="inside">
                <group string="التوظيف / الأسطول" name="recruitment_platform">
                    <field name="project_id"/>
                    <button name="action_open_branch_transfer_wizard" type="object"
                            string="نقل لفرع آخر" class="btn-link"
                            icon="fa-exchange"
                            groups="recruitment_workflow.group_recruitment_workflow_fleet"/>
                </group>
            </xpath>
        </field>
    </record>

    <!-- معالج نقل سيارة لفرع آخر - تنفيذ فوري مع تسجيل الحركة -->
    <record id="view_fleet_vehicle_branch_transfer_wizard_form" model="ir.ui.view">
        <field name="name">fleet.vehicle.branch.transfer.wizard.form</field>
        <field name="model">fleet.vehicle.branch.transfer.wizard</field>
        <field name="arch" type="xml">
            <form string="نقل لفرع آخر">
                <field name="vehicle_id" invisible="1"/>
                <group>
                    <field name="current_company_id"/>
                    <field name="company_id" options="{'no_create': True}"/>
                    <field name="note" placeholder="ملاحظة اختيارية..."/>
                </group>
                <footer>
                    <button name="action_confirm_transfer" type="object"
                            string="تأكيد النقل" class="btn-primary"/>
                    <button string="إلغاء" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- قائمة/فورم تاريخ فروع السيارات -->
    <record id="view_fleet_vehicle_branch_history_list" model="ir.ui.view">
        <field name="name">fleet.vehicle.branch.history.list</field>
        <field name="model">fleet.vehicle.branch.history</field>
        <field name="arch" type="xml">
            <list string="تاريخ فروع السيارات" default_order="date_start desc"
                  decoration-success="is_current">
                <field name="vehicle_id"/>
                <field name="company_id"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="is_current" widget="boolean_toggle" readonly="1"/>
                <field name="moved_by" optional="hide"/>
                <field name="note" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_fleet_vehicle_branch_history_form" model="ir.ui.view">
        <field name="name">fleet.vehicle.branch.history.form</field>
        <field name="model">fleet.vehicle.branch.history</field>
        <field name="arch" type="xml">
            <form string="فترة تبعية لفرع">
                <group>
                    <field name="vehicle_id"/>
                    <field name="company_id"/>
                    <field name="date_start"/>
                    <field name="date_end"/>
                    <field name="moved_by"/>
                    <field name="note"/>
                </group>
            </form>
        </field>
    </record>

    <record id="action_fleet_vehicle_branch_history" model="ir.actions.act_window">
        <field name="name">تاريخ فروع السيارات</field>
        <field name="res_model">fleet.vehicle.branch.history</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- نموذج مخصّص لطلبات السيارات من التوظيف - يظهر داخل تطبيق Fleet
         فقط، ويقتصر على ما يحتاجه مسؤول الأسطول (استلام + تفويض) دون بقية
         تفاصيل طلب التوظيف (الرسوم، المرفقات...) غير ذات الصلة بعمله. -->
    <record id="view_recruitment_request_form_fleet" model="ir.ui.view">
        <field name="name">recruitment.request.form.fleet</field>
        <field name="model">recruitment.request</field>
        <field name="arch" type="xml">
            <form string="طلب سيارة - توظيف" create="0" delete="0">
                <header>
                    <button name="action_fleet_receive" type="object" string="استلام الطلب"
                            class="btn-primary"
                            groups="recruitment_workflow.group_recruitment_workflow_fleet"
                            invisible="car_request_state != 'requested'"/>
                    <button name="action_fleet_authorize" type="object" string="تفويض السيارة (اعتماد نهائي)"
                            class="btn-primary"
                            groups="recruitment_workflow.group_recruitment_workflow_fleet"
                            invisible="car_request_state != 'received'"/>
                    <field name="car_request_state" widget="statusbar"
                           statusbar_visible="requested,received,authorized"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="بيانات المندوب">
                            <field name="employee_name" readonly="1"/>
                            <field name="mobile" readonly="1"/>
                            <field name="project_id" readonly="1"/>
                        </group>
                        <group string="السيارة">
                            <!-- قابلة للتعديل هنا فقط - قسم الأسطول هو من
                                 يختار السيارة المحدَّدة، وليس مسؤول المشروع
                                 (الحقل للعرض فقط في نموذج التوظيف الرئيسي). -->
                            <field name="vehicle_id"
                                   domain="[('recruitment_state', '=', 'available'),
                                            '|', ('project_id', '=', project_id), ('project_id', '=', False)]"
                                   options="{'no_create': True}"/>
                            <field name="car_requested" readonly="1"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ربط القائمة والنموذج المخصّصَين أعلاه بإجراء نافذة Fleet (المُعرَّف
         في recruitment_request_views.xml) - عبر سجلّي ir.actions.act_window.view
         بدل الحقل view_id (الذي يدعم عرضاً واحداً فقط) حتى يكون لكل من
         list وform عرضه المخصّص بدل الافتراضي العام لطلب التوظيف. -->
    <record id="action_recruitment_request_fleet_view_list" model="ir.actions.act_window.view">
        <field name="sequence">1</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_recruitment_request_list_fleet"/>
        <field name="act_window_id" ref="action_recruitment_request_fleet"/>
    </record>

    <record id="action_recruitment_request_fleet_view_form" model="ir.actions.act_window.view">
        <field name="sequence">2</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_recruitment_request_form_fleet"/>
        <field name="act_window_id" ref="action_recruitment_request_fleet"/>
    </record>

</odoo>
