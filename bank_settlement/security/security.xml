<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- فئة التطبيق (Module Category) -->
        <record id="module_category_bank_settlement" model="ir.module.category">
            <field name="name">السداد البنكي</field>
            <field name="description">صلاحيات إدارة السلف والرسوم الحكومية وتحويلات المركبات والتأمين الطبي وتصفيات المناديب</field>
            <field name="sequence">21</field>
        </record>

        <!-- صلاحية المجموعة (res.groups.privilege) - جديد في Odoo 19، نفس
             النمط المستخدم في recruitment_workflow لضمان ظهور المجموعات
             تحت فئة تطبيق واضحة بدل "Extra Rights". -->
        <record id="privilege_bank_settlement" model="res.groups.privilege">
            <field name="name">السداد البنكي</field>
            <field name="sequence">21</field>
            <field name="category_id" ref="module_category_bank_settlement"/>
        </record>

        <record id="group_bank_settlement_user" model="res.groups">
            <field name="name">السداد البنكي / مستخدم</field>
            <field name="sequence">10</field>
            <field name="privilege_id" ref="privilege_bank_settlement"/>
        </record>

        <!-- الاسم "محاسب" (وليس "مراجع") - هو المسؤول فعلياً عن تنفيذ
             الصرف الفعلي بعد اعتماد المدير العام، وليس عن أي "مراجعة"
             حقيقية (لا يوجد إجراء مراجعة منفصل مربوط بهذه المجموعة تحديداً
             - فقط ينفّذ بعد اعتماد المدير العام مباشرة). مُعرَّف الحقل
             (XML ID) بقي group_bank_settlement_reviewer بلا تغيير عمداً
             حفاظاً على عضويات المستخدمين الحاليين عند الترقية - لا يُنشئ
             تغيير الاسم مجموعة جديدة فارغة. -->
        <record id="group_bank_settlement_reviewer" model="res.groups">
            <field name="name">السداد البنكي / محاسب</field>
            <field name="sequence">20</field>
            <field name="privilege_id" ref="privilege_bank_settlement"/>
            <field name="implied_ids" eval="[(4, ref('group_bank_settlement_user'))]"/>
        </record>

        <record id="group_bank_settlement_manager" model="res.groups">
            <field name="name">السداد البنكي / مدير عام</field>
            <field name="sequence">30</field>
            <field name="privilege_id" ref="privilege_bank_settlement"/>
            <field name="implied_ids" eval="[(4, ref('group_bank_settlement_reviewer'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
        </record>

        <!--
            توزيع الصلاحيات الفعلي على الإجراءات (وليس فقط CRUD) مطبَّق في
            كود Python (bank_settlement_mixin._check_group) وأزرار الواجهة:
            - "مستخدم": ينشئ السجل ويرسله للمراجعة (action_submit_review).
            - "محاسب" (ويتوارثه "مدير عام"): ينفّذ الصرف الفعلي بعد اعتماد
              المدير العام (action_done / action_create_insurance_transfer)،
              ويتولّى أيضاً "إلغاء"/"رفض" السجل.
            - "مدير عام" فقط: يعتمد السجل (action_confirm)، حسب الفيديو.
            لا توجد Record Rules على نماذج السداد البنكي نفسها بعد (كل من
            يملك المجموعة يرى كل سجلاتها بغض النظر عن من أنشأها) - أضفها
            لاحقاً إن احتجت عزلاً بين المستخدمين/الفروع. يوجد Record Rule
            واحد فقط أدناه على account.move نفسه (وليس نماذج السداد
            البنكي) - انظر شرحه.
        -->

        <!-- "مستخدم/محاسب" السداد البنكي يحتاجون صلاحية قراءة على
             account.move (لعرض القيد الناتج عبر زر "عرض القيد") ودخول
             تطبيق المحاسبة نفسه لرؤية قائمة "السداد البنكي" المدموجة
             فيه - وهذا يعني بلا قاعدة إضافية أنهم يقدرون تصفح كل قيود/
             فواتير الشركة الأخرى (عملاء، موردين...) رغم عدم حاجتهم لها.
             هذه القاعدة تحصر رؤيتهم على القيود التي أنشأها السداد البنكي
             نفسه فقط (is_bank_settlement_move) - أي محاولة لفتح "العملاء
             ← الفواتير" أو أي قائمة محاسبية أخرى ستظهر فارغة لهم عملياً. -->
        <record id="account_move_bank_settlement_rule" model="ir.rule">
            <field name="name">قيود السداد البنكي فقط - مستخدم/محاسب السداد البنكي</field>
            <field name="model_id" ref="account.model_account_move"/>
            <field name="groups" eval="[(4, ref('group_bank_settlement_user'))]"/>
            <field name="domain_force">[('is_bank_settlement_move', '=', True)]</field>
            <field name="perm_read">1</field>
            <field name="perm_write">0</field>
            <field name="perm_create">0</field>
            <field name="perm_unlink">0</field>
        </record>

        <!-- عزل حسب الشركة/الفرع على سجلات السداد البنكي نفسها - كان
             مفقوداً سابقاً (أي عضو في مجموعات السداد البنكي يرى سجلات كل
             الشركات/الفروع بلا استثناء)، بنفس نمط hr_employee_platform_
             history_company_rule في recruitment_workflow. قاعدة واحدة
             لكل نموذج من الخمسة (لا يمكن ربط ir.rule بالـ mixin
             التجريدي مباشرة - لا جدول خاص به). -->
        <record id="bank_settlement_advance_company_rule" model="ir.rule">
            <field name="name">السلف: حسب الشركة</field>
            <field name="model_id" ref="model_bank_settlement_advance"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="bank_settlement_government_fee_company_rule" model="ir.rule">
            <field name="name">الرسوم الحكومية: حسب الشركة</field>
            <field name="model_id" ref="model_bank_settlement_government_fee"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="bank_settlement_vehicle_transfer_company_rule" model="ir.rule">
            <field name="name">تحويلات المركبات: حسب الشركة</field>
            <field name="model_id" ref="model_bank_settlement_vehicle_transfer"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="bank_settlement_medical_insurance_company_rule" model="ir.rule">
            <field name="name">التأمين الطبي: حسب الشركة</field>
            <field name="model_id" ref="model_bank_settlement_medical_insurance"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="bank_settlement_representative_company_rule" model="ir.rule">
            <field name="name">تصفيات المناديب: حسب الشركة</field>
            <field name="model_id" ref="model_bank_settlement_representative"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <!-- ثغرتان اكتُشفتا بفحص شامل لتغطية قواعد عزل الفروع: النموذجان
             يحملان company_id بلا أي قاعدة عزل - فكان مستخدم فرع يرى
             جداول استحقاق الدفعات المقدمة وطلبات الاستقدام لفروع أخرى. -->
        <record id="bank_settlement_prepaid_line_company_rule" model="ir.rule">
            <field name="name">أسطر استحقاق الدفعات المقدمة: حسب الشركة</field>
            <field name="model_id" ref="model_bank_settlement_prepaid_line"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="recruitment_import_request_company_rule" model="ir.rule">
            <field name="name">طلبات الاستقدام: حسب الشركة</field>
            <field name="model_id" ref="model_recruitment_import_request"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

    </data>
</odoo>
