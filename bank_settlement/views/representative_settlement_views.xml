<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_bank_settlement_representative_list" model="ir.ui.view">
            <field name="name">bank.settlement.representative.list</field>
            <field name="model">bank.settlement.representative</field>
            <field name="arch" type="xml">
                <list string="تصفيات المناديب" decoration-success="state == 'done'">
                    <field name="name"/>
                    <field name="date"/>
                    <field name="employee_id" string="اسم المندوب"/>
                    <field name="residency_number"/>
                    <field name="iban"/>
                    <field name="project_id" string="اسم التطبيق"/>
                    <field name="platform_employee_id" string="ID رقم"/>
                    <field name="settlement_amount" sum="الإجمالي"/>
                    <field name="state" widget="badge"
                           decoration-success="state == 'done'"
                           decoration-info="state == 'confirmed'"
                           decoration-muted="state == 'draft'"/>
                </list>
            </field>
        </record>

        <record id="view_bank_settlement_representative_form" model="ir.ui.view">
            <field name="name">bank.settlement.representative.form</field>
            <field name="model">bank.settlement.representative</field>
            <field name="arch" type="xml">
                <form string="تصفية مندوب">
                    <header>
                        <button name="action_submit_review" string="إرسال للمراجعة"
                                type="object" class="btn-primary"
                                invisible="state != 'draft'"/>
                        <button name="action_confirm" string="تأكيد"
                                type="object" class="btn-primary"
                                groups="bank_settlement.group_bank_settlement_manager"
                                invisible="state != 'under_review'"/>
                        <button name="action_done" string="تم السداد"
                                type="object" class="btn-primary"
                                groups="bank_settlement.group_bank_settlement_reviewer"
                                invisible="state != 'confirmed'"/>
                        <button name="action_reset_draft" string="إعادة لمسودة"
                                type="object" groups="bank_settlement.group_bank_settlement_manager"
                                invisible="state not in ('under_review', 'confirmed')"/>
                        <button name="action_cancel" string="إلغاء"
                                type="object" groups="bank_settlement.group_bank_settlement_reviewer"
                                invisible="state in ('done', 'cancel')"/>
                        <field name="state" widget="statusbar"
                               statusbar_visible="draft,under_review,confirmed,done"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_move" type="object"
                                    class="oe_stat_button" icon="fa-file-text-o"
                                    invisible="not move_id">
                                <div class="o_stat_info">
                                    <span class="o_stat_text">القيد المحاسبي</span>
                                </div>
                            </button>
                        </div>
                        <div class="oe_title">
                            <h1><field name="name" readonly="1"/></h1>
                        </div>
                        <group>
                            <group string="بيانات المندوب">
                                <field name="date"/>
                                <field name="employee_id" string="اسم المندوب" required="1"/>
                                <field name="residency_number"/>
                                <field name="iban"/>
                                <field name="company_id" groups="base.group_multi_company" readonly="1"/>
                            </group>
                            <group string="بيانات المنصة">
                                <field name="project_id" string="اسم التطبيق"/>
                                <field name="analytic_account_id" readonly="1"/>
                                <field name="platform_employee_id" string="ID رقم"/>
                            </group>
                        </group>
                        <group string="مبلغ التصفية">
                            <field name="currency_id" invisible="1"/>
                            <field name="settlement_amount" readonly="move_id"/>
                            <field name="linked_account_id" readonly="move_id"/>
                            <field name="journal_id" readonly="move_id"/>
                        </group>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="action_bank_settlement_representative" model="ir.actions.act_window">
            <field name="name">تصفيات المناديب</field>
            <field name="res_model">bank.settlement.representative</field>
            <field name="view_mode">list,form</field>
        </record>

    </data>
</odoo>
