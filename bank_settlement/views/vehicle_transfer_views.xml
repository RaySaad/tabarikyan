<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_bank_settlement_vehicle_transfer_list" model="ir.ui.view">
            <field name="name">bank.settlement.vehicle.transfer.list</field>
            <field name="model">bank.settlement.vehicle.transfer</field>
            <field name="arch" type="xml">
                <list string="تحويلات المركبات" decoration-success="state == 'done'">
                    <field name="name"/>
                    <field name="transfer_type_id"/>
                    <field name="employee_id"/>
                    <field name="vehicle_id" optional="show"/>
                    <field name="amount" sum="الإجمالي"/>
                    <field name="tax_amount"/>
                    <field name="state" widget="badge"
                           decoration-success="state == 'done'"
                           decoration-info="state == 'confirmed'"
                           decoration-muted="state == 'draft'"/>
                </list>
            </field>
        </record>

        <record id="view_bank_settlement_vehicle_transfer_form" model="ir.ui.view">
            <field name="name">bank.settlement.vehicle.transfer.form</field>
            <field name="model">bank.settlement.vehicle.transfer</field>
            <field name="arch" type="xml">
                <form string="تحويل مركبة">
                    <header>
                        <button name="action_submit_review" string="إرسال للمراجعة"
                                type="object" class="btn-primary"
                                invisible="state != 'draft'"/>
                        <button name="action_confirm" string="تأكيد"
                                type="object" class="btn-primary"
                                groups="bank_settlement.group_bank_settlement_manager"
                                invisible="state != 'under_review'"/>
                        <button name="action_done" string="تم التحويل"
                                type="object" class="btn-primary"
                                groups="bank_settlement.group_bank_settlement_reviewer"
                                invisible="state != 'confirmed'"/>
                        <button name="action_reset_draft" string="إعادة لمسودة"
                                type="object" groups="bank_settlement.group_bank_settlement_manager"
                                invisible="state not in ('under_review', 'confirmed')"/>
                        <button name="action_cancel" string="إلغاء"
                                type="object" groups="bank_settlement.group_bank_settlement_reviewer"
                                invisible="state in ('done', 'cancel')"/>
                        <field name="state" widget="statusbar"
                               statusbar_visible="draft,under_review,confirmed,done"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_move" type="object"
                                    class="oe_stat_button" icon="fa-file-text-o"
                                    invisible="not move_id">
                                <div class="o_stat_info">
                                    <span class="o_stat_text">القيد المحاسبي</span>
                                </div>
                            </button>
                        </div>
                        <div class="oe_title">
                            <h1><field name="name" readonly="1"/></h1>
                        </div>
                        <group>
                            <group>
                                <field name="transfer_type_id"
                                       readonly="state != 'draft'"/>
                                <field name="employee_id"
                                       readonly="state != 'draft'"/>
                                <field name="employee_partner_id" invisible="1"/>
                                <field name="vehicle_id"
                                       readonly="state != 'draft'"
                                       domain="['|', ('driver_id', '=', employee_partner_id), ('future_driver_id', '=', employee_partner_id)] if employee_partner_id else []"/>
                                <field name="project_id"
                                       readonly="state != 'draft'"/>
                                <field name="analytic_account_id" readonly="1"/>
                                <field name="company_id" groups="base.group_multi_company" readonly="1"/>
                                <!-- الحساب المرتبط لا يظهر إلا بعد اعتماد المدير
                                     العام، ويبقى قابلاً للتعبئة تحديداً في تلك
                                     الحالة (قبل تسجيل التحويل الفعلي). -->
                                <field name="linked_account_id" readonly="state != 'confirmed'"
                                       invisible="state not in ('confirmed', 'done')"/>
                            </group>
                            <group>
                                <field name="currency_id" invisible="1"/>
                                <field name="amount" readonly="state != 'draft'"/>
                                <field name="tax_amount" readonly="state != 'draft'"/>
                                <field name="total_amount"/>
                                <field name="transfer_date" readonly="state != 'draft'"/>
                                <field name="bank_reference" readonly="state != 'draft'"/>
                                <!-- دفتر اليومية لا يظهر إلا بعد اعتماد المدير
                                     العام - لا حاجة له قبل ذلك. -->
                                <field name="journal_id" readonly="state != 'confirmed'"
                                       invisible="state not in ('confirmed', 'done')"/>
                            </group>
                        </group>
                        <group string="ملاحظات">
                            <field name="notes" nolabel="1"/>
                        </group>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="action_bank_settlement_vehicle_transfer" model="ir.actions.act_window">
            <field name="name">تحويلات المركبات</field>
            <field name="res_model">bank.settlement.vehicle.transfer</field>
            <field name="view_mode">list,form</field>
        </record>

    </data>
</odoo>
