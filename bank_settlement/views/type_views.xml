<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ============ الجهة الحكومية ============ -->
        <record id="view_bank_settlement_government_entity_list" model="ir.ui.view">
            <field name="name">bank.settlement.government.entity.list</field>
            <field name="model">bank.settlement.government.entity</field>
            <field name="arch" type="xml">
                <list string="الجهات الحكومية" editable="bottom">
                    <field name="sequence" widget="handle"/>
                    <field name="name"/>
                    <field name="active" column_invisible="True"/>
                </list>
            </field>
        </record>
        <record id="action_bank_settlement_government_entity" model="ir.actions.act_window">
            <field name="name">الجهات الحكومية</field>
            <field name="res_model">bank.settlement.government.entity</field>
            <field name="view_mode">list</field>
        </record>

