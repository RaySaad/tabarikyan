<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_bank_settlement_medical_insurance_list" model="ir.ui.view">
            <field name="name">bank.settlement.medical.insurance.list</field>
            <field name="model">bank.settlement.medical.insurance</field>
            <field name="arch" type="xml">
                <list string="التأمين الطبي" decoration-success="state == 'done'"
                      decoration-danger="state == 'rejected'">
                    <field name="name"/>
                    <field name="fee_type_id"/>
                    <field name="employee_id"/>
                    <field name="vendor_id"/>
                    <field name="amount"/>
                    <field name="tax_amount"/>
                    <field name="total_amount" sum="الإجمالي"/>
                    <field name="state" widget="badge"
                           decoration-success="state == 'done'"
                           decoration-info="state == 'confirmed'"
                           decoration-danger="state == 'rejected'"
                           decoration-muted="state == 'draft'"/>
                </list>
            </field>
        </record>

        <record id="view_bank_settlement_medical_insurance_search" model="ir.ui.view">
            <field name="name">bank.settlement.medical.insurance.search</field>
            <field name="model">bank.settlement.medical.insurance</field>
            <field name="arch" type="xml">
                <search string="التأمين الطبي">
                    <field name="name"/>
                    <field name="employee_id"/>
                    <field name="vendor_id"/>
                    <filter name="inactive" string="مؤرشف" domain="[('active', '=', False)]"/>
                    <group>
                        <filter name="group_by_state" string="الحالة" context="{'group_by': 'state'}"/>
                        <filter name="group_by_employee" string="الموظف" context="{'group_by': 'employee_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="view_bank_settlement_medical_insurance_form" model="ir.ui.view">
            <field name="name">bank.settlement.medical.insurance.form</field>
            <field name="model">bank.settlement.medical.insurance</field>
            <field name="arch" type="xml">
                <form string="تأمين / فحص طبي">
                    <header>
                        <button name="action_submit_review" string="إرسال للمراجعة"
                                type="object" class="btn-primary"
                                invisible="state != 'draft'"/>
                        <button name="action_confirm" string="اعتماد التحويل"
                                type="object" class="btn-primary"
                                groups="bank_settlement.group_bank_settlement_manager"
                                invisible="state != 'under_review'"/>
                        <button name="action_create_insurance_transfer"
                                string="إنشاء تحويل التأمين" type="object"
                                class="btn-primary"
                                groups="bank_settlement.group_bank_settlement_reviewer"
                                invisible="state != 'confirmed'"/>
                        <button name="action_open_return_wizard" string="إرجاع للتصحيح"
                                type="object" groups="bank_settlement.group_bank_settlement_manager"
                                invisible="state != 'confirmed'"/>
                        <button name="action_open_reject_wizard" string="رفض"
                                type="object" groups="bank_settlement.group_bank_settlement_reviewer"
                                invisible="state in ('done', 'cancel', 'rejected')"/>
                        <field name="state" widget="statusbar"
                               statusbar_visible="draft,under_review,confirmed,done"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_move" type="object"
                                    class="oe_stat_button" icon="fa-file-text-o"
                                    invisible="not move_id">
                                <div class="o_stat_info">
                                    <span class="o_stat_text">فاتورة المورد</span>
                                </div>
                            </button>
                        </div>
                        <div class="oe_title">
                            <h1><field name="name" readonly="1"/></h1>
                        </div>
                        <div class="alert alert-warning" role="alert" invisible="not returned_for_correction">
                            تم إرجاع هذا السجل للتصحيح - يمكن تعديل المبلغ وتاريخ التحويل
                            مؤقتاً حتى إعادة الاعتماد. هوية الموظف/المنصة تبقى مقفولة.
                        </div>
                        <group>
                            <group string="بيانات التأمين">
                                <field name="fee_type_id" readonly="state != 'draft'"/>
                                <!-- طلب صريح: يبقى المورد قابلاً للتعديل من
                                     "مسودة" وحتى آخر مرحلة، لا يُقفَل فور
                                     مغادرة "مسودة" كباقي حقول الهوية هنا. -->
                                <field name="vendor_id"
                                       readonly="state in ('done', 'rejected', 'cancel')"/>
                                <field name="company_iban" readonly="state != 'draft'"/>
                                <!-- تاريخ التحويل الفعلي - خاص بالمحاسب وقت
                                     الصرف تحديداً - لا يظهر إلا بعد اعتماد
                                     المدير العام (أو أثناء "إرجاع للتصحيح"،
                                     نفس منطق دفتر اليومية/الحساب المرتبط في
                                     بقية الشاشات، رغم أن هذه الشاشة لا
                                     تستخدمهما مباشرة). -->
                                <field name="transfer_date" readonly="state != 'confirmed' and not returned_for_correction"
                                       invisible="state not in ('confirmed', 'done') and not returned_for_correction"/>
                            </group>
                            <group string="المبالغ">
                                <field name="currency_id" invisible="1"/>
                                <field name="amount" readonly="state != 'draft' and not returned_for_correction"/>
                                <field name="tax_amount" readonly="state != 'draft'"/>
                                <field name="total_amount"/>
                            </group>
                        </group>
                        <group>
                            <group string="بيانات المندوب">
                                <field name="employee_id" string="اسم المندوب" required="1"
                                       readonly="state != 'draft'"/>
                                <field name="residency_number"/>
                                <field name="company_id" groups="base.group_multi_company" readonly="1"/>
                            </group>
                            <group string="المنصة">
                                <field name="project_id" string="التطبيق"
                                       readonly="state != 'draft'"/>
                                <field name="analytic_account_id" readonly="1"/>
                                <field name="operating_system" string="نظام التشغيل"/>
                            </group>
                        </group>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="action_bank_settlement_medical_insurance" model="ir.actions.act_window">
            <field name="name">التأمين الطبي</field>
            <field name="res_model">bank.settlement.medical.insurance</field>
            <field name="view_mode">list,form</field>
        </record>

    </data>
</odoo>
