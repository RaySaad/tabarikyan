<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_bank_settlement_deletion_log_list" model="ir.ui.view">
        <field name="name">bank.settlement.deletion.log.list</field>
        <field name="model">bank.settlement.deletion.log</field>
        <field name="arch" type="xml">
            <list string="سجل الحذف النهائي الإداري" default_order="create_date desc" create="0" edit="0">
                <field name="create_date" string="تاريخ الحذف"/>
                <field name="source_model"/>
                <field name="record_name"/>
                <field name="employee_name"/>
                <field name="amount" sum="الإجمالي"/>
                <field name="state_at_deletion"/>
                <field name="move_name" optional="hide"/>
                <field name="move_status_at_deletion"/>
                <field name="deleted_by"/>
                <field name="reason" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_bank_settlement_deletion_log_form" model="ir.ui.view">
        <field name="name">bank.settlement.deletion.log.form</field>
        <field name="model">bank.settlement.deletion.log</field>
        <field name="arch" type="xml">
            <form string="سجل حذف نهائي" create="0" edit="0">
                <group>
                    <field name="source_model"/>
                    <field name="record_name"/>
                    <field name="employee_name"/>
                    <field name="amount"/>
                    <field name="state_at_deletion"/>
                    <field name="move_name"/>
                    <field name="move_status_at_deletion"/>
                    <field name="deleted_by"/>
                    <field name="reason"/>
                </group>
            </form>
        </field>
    </record>

    <record id="action_bank_settlement_deletion_log" model="ir.actions.act_window">
        <field name="name">سجل الحذف النهائي الإداري</field>
        <field name="res_model">bank.settlement.deletion.log</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
