<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- توسعة طلب إنهاء الخدمة بما يخص السداد البنكي وحده: زر إنشاء
             التصفية النهائية للمندوب وعرضها. -->
        <record id="view_hr_employee_exit_request_form_bank_settlement" model="ir.ui.view">
            <field name="name">hr.employee.exit.request.form.bank.settlement</field>
            <field name="model">hr.employee.exit.request</field>
            <field name="inherit_id" ref="recruitment_workflow.view_hr_employee_exit_request_form"/>
            <field name="arch" type="xml">
                <xpath expr="//div[@name='button_box']" position="inside">
                    <button name="action_view_final_settlement" type="object"
                            class="oe_stat_button" icon="fa-money"
                            invisible="not representative_settlement_id">
                        <div class="o_stat_info">
                            <span class="o_stat_text">التصفية النهائية</span>
                        </div>
                    </button>
                </xpath>
                <xpath expr="//header" position="inside">
                    <button name="action_create_final_settlement" type="object"
                            string="إنشاء التصفية النهائية"
                            groups="bank_settlement.group_bank_settlement_user"
                            invisible="state != 'done' or representative_settlement_id"/>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
