<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_recruitment_request_form_inherit_bank_settlement" model="ir.ui.view">
            <field name="name">recruitment.request.form.inherit.bank.settlement</field>
            <field name="model">recruitment.request</field>
            <field name="inherit_id" ref="recruitment_workflow.view_recruitment_request_form"/>
            <field name="arch" type="xml">
                <xpath expr="//div[@name='button_box']" position="inside">
                    <!-- عرض فقط - بدون تنقّل للسداد البنكي، فقط حالة سداد
                         الرسوم الحكومية بنظرة سريعة (بنفس أسلوب "فاتورة
                         الرسوم" المجاورة). -->
                    <div class="oe_stat_button" style="cursor:default;"
                         groups="bank_settlement.group_bank_settlement_user"
                         invisible="not bank_settlement_gov_fee_id">
                        <i class="fa fa-fw fa-university" title="الرسوم الحكومية" role="img"/>
                        <div class="o_stat_info">
                            <span class="o_stat_text">الرسوم الحكومية</span>
                            <field name="bank_settlement_gov_fee_state" widget="badge" class="o_stat_value"/>
                        </div>
                    </div>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
