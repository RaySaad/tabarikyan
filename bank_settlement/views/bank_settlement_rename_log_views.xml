<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_bank_settlement_rename_log_list" model="ir.ui.view">
        <field name="name">bank.settlement.rename.log.list</field>
        <field name="model">bank.settlement.rename.log</field>
        <field name="arch" type="xml">
            <list string="سجل تعديل الكود الإداري" default_order="create_date desc" create="0" edit="0">
                <field name="create_date" string="تاريخ التعديل"/>
                <field name="source_model"/>
                <field name="old_code"/>
                <field name="new_code"/>
                <field name="employee_name"/>
                <field name="renamed_by"/>
                <field name="reason" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_bank_settlement_rename_log_form" model="ir.ui.view">
        <field name="name">bank.settlement.rename.log.form</field>
        <field name="model">bank.settlement.rename.log</field>
        <field name="arch" type="xml">
            <form string="سجل تعديل كود" create="0" edit="0">
                <group>
                    <field name="source_model"/>
                    <field name="old_code"/>
                    <field name="new_code"/>
                    <field name="employee_name"/>
                    <field name="renamed_by"/>
                    <field name="reason"/>
                </group>
            </form>
        </field>
    </record>

    <record id="action_bank_settlement_rename_log" model="ir.actions.act_window">
        <field name="name">سجل تعديل الكود الإداري</field>
        <field name="res_model">bank.settlement.rename.log</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
