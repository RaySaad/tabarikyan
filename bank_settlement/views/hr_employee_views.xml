<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- كشف حساب الموظف - انتقل من شاشة الموظف نفسها (تطبيق الموظفين)
         إلى تطبيق "السداد البنكي" مباشرة (طلب صريح) - حتى لا يحتاج
         مستخدم/محاسب السداد البنكي أي صلاحية على تطبيق الموظفين ليصل
         إليه (نفس فلسفة استقلال التطبيق المذكورة في __manifest__.py).
         عرض/نموذج مستقلان هنا (لا يُعدِّلان نموذج hr.employee الأساسي
         في تطبيق الموظفين) - فقط الحقول اللازمة لعرض/طباعة الكشف. -->
    <record id="view_hr_employee_list_bank_settlement" model="ir.ui.view">
        <field name="name">hr.employee.list.bank.settlement.statement</field>
        <field name="model">hr.employee</field>
        <field name="arch" type="xml">
            <list string="كشف حساب الموظف" create="false" edit="false">
                <field name="name"/>
                <field name="identification_id"/>
                <field name="project_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_hr_employee_form_bank_settlement" model="ir.ui.view">
        <field name="name">hr.employee.form.bank.settlement.statement</field>
        <field name="model">hr.employee</field>
        <field name="arch" type="xml">
            <form string="كشف حساب الموظف" create="false" edit="false">
                <header>
                    <button name="action_print_employee_statement" type="object"
                            string="طباعة كشف حساب" class="btn-primary"
                            icon="fa-file-pdf-o"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <field name="identification_id" readonly="1"/>
                        <field name="project_id" readonly="1"/>
                        <field name="company_id" groups="base.group_multi_company" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_bank_settlement_employee_statement" model="ir.actions.act_window">
        <field name="name">كشف حساب الموظف</field>
        <field name="res_model">hr.employee</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_hr_employee_list_bank_settlement')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_hr_employee_form_bank_settlement')}),
        ]"/>
    </record>

</odoo>
