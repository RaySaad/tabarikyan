<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- زر "طباعة كشف حساب" على شاشة الموظف - كشف يُعطى للموظف نفسه
         (سلف، تصفيات مناديب، مخالفات/رسوم رخصة، رواتب/عمولات فقط -
         انظر hr_employee.py: _get_employee_statement_data لسبب استبعاد
         الرسوم الحكومية/التأمين الطبي عمداً). متاح لمن يملك صلاحية
         "مستخدم" السداد البنكي فما فوق فقط - كشف مالي، وليس للعرض العام. -->
    <record id="view_hr_employee_form_inherit_bank_settlement" model="ir.ui.view">
        <field name="name">hr.employee.form.bank.settlement.statement</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_print_employee_statement" type="object"
                        class="oe_stat_button" icon="fa-file-pdf-o"
                        groups="bank_settlement.group_bank_settlement_user">
                    <div class="o_stat_info">
                        <span class="o_stat_text">كشف حساب</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>

</odoo>
