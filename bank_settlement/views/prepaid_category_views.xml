<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ============ فئة الدفعة المقدمة (إعدادات) ============ -->
        <record id="view_bank_settlement_prepaid_category_list" model="ir.ui.view">
            <field name="name">bank.settlement.prepaid.category.list</field>
            <field name="model">bank.settlement.prepaid.category</field>
            <field name="arch" type="xml">
                <list string="فئات الدفعة المقدمة" editable="bottom">
                    <field name="sequence" widget="handle"/>
                    <field name="name"/>
                    <field name="prepaid_account_id"/>
                    <field name="expense_account_id"/>
                    <field name="journal_id"/>
                    <field name="active" column_invisible="True"/>
                </list>
            </field>
        </record>
        <record id="action_bank_settlement_prepaid_category" model="ir.actions.act_window">
            <field name="name">فئات الدفعة المقدمة</field>
            <field name="res_model">bank.settlement.prepaid.category</field>
            <field name="view_mode">list</field>
        </record>

        <!-- ============ سطر استحقاق الدفعة المقدمة (عرض/تدقيق) ============ -->
        <record id="view_bank_settlement_prepaid_line_list" model="ir.ui.view">
            <field name="name">bank.settlement.prepaid.line.list</field>
            <field name="model">bank.settlement.prepaid.line</field>
            <field name="arch" type="xml">
                <list string="جدول استحقاق الدفعة المقدمة" create="0">
                    <field name="sequence"/>
                    <field name="name"/>
                    <field name="employee_id"/>
                    <field name="period_start_date"/>
                    <field name="period_end_date"/>
                    <field name="amount" sum="الإجمالي"/>
                    <field name="state" widget="badge"
                           decoration-success="state == 'posted'"
                           decoration-danger="state == 'cancel'"
                           decoration-muted="state == 'draft'"/>
                    <field name="last_error" string="تعذّر الترحيل" optional="show"/>
                    <button name="action_post_now" type="object" icon="fa-check"
                            title="ترحيل الآن"
                            invisible="state != 'draft'"/>
                </list>
            </field>
        </record>
        <record id="view_bank_settlement_prepaid_line_form" model="ir.ui.view">
            <field name="name">bank.settlement.prepaid.line.form</field>
            <field name="model">bank.settlement.prepaid.line</field>
            <field name="arch" type="xml">
                <form string="سطر استحقاق دفعة مقدمة" create="0">
                    <header>
                        <button name="action_post_now" type="object"
                                string="ترحيل الآن" class="btn-primary"
                                groups="bank_settlement.group_bank_settlement_reviewer,bank_settlement.group_bank_settlement_manager"
                                invisible="state != 'draft'"/>
                        <button name="action_cancel_line" type="object"
                                string="إيقاف هذا السطر"
                                groups="bank_settlement.group_bank_settlement_manager"
                                confirm="لن يُرحَّل هذا السطر تلقائياً بعد الآن. هل تريد المتابعة؟"
                                invisible="state != 'draft'"/>
                        <button name="action_reset_to_draft" type="object"
                                string="إعادة تفعيل السطر"
                                groups="bank_settlement.group_bank_settlement_manager"
                                invisible="state != 'cancel'"/>
                        <field name="state" widget="statusbar"
                               statusbar_visible="draft,posted"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_source" type="object"
                                    class="oe_stat_button" icon="fa-file-text-o">
                                <div class="o_stat_info">
                                    <span class="o_stat_text">سجل السداد المصدر</span>
                                </div>
                            </button>
                            <button name="action_view_move" type="object"
                                    class="oe_stat_button" icon="fa-book"
                                    invisible="not move_id">
                                <div class="o_stat_info">
                                    <span class="o_stat_text">قيد الاستحقاق</span>
                                </div>
                            </button>
                        </div>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="employee_id"/>
                                <field name="category_id"/>
                            </group>
                            <group>
                                <field name="period_start_date"/>
                                <field name="period_end_date"/>
                                <field name="amount"/>
                                <field name="currency_id" invisible="1"/>
                                <field name="last_attempt_date" invisible="not last_attempt_date"/>
                            </group>
                        </group>
                        <div class="alert alert-danger" role="alert" invisible="not last_error">
                            تعذّر ترحيل هذا السطر في آخر محاولة:
                            <field name="last_error" readonly="1" nolabel="1"/>
                        </div>
                    </sheet>
                </form>
            </field>
        </record>

    </data>
</odoo>
