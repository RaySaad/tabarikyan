<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="res_config_settings_view_form_bank_settlement" model="ir.ui.view">
            <field name="name">res.config.settings.form.bank.settlement</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//block[@name='companies_setting_container']" position="after">
                    <block title="السداد البنكي" name="bank_settlement_setting">
                        <setting string="حساب ذمم الموظفين"
                                 help="يقرأ منه كشف حساب الموظف الرواتب والعمولات وبقية الذمم. يُبحث عن الرقم في كل الشركات، فلكل فرع حسابه بالرقم نفسه.">
                            <field name="settlement_dues_account_code"/>
                        </setting>
                    </block>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
