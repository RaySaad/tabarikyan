<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_bank_settlement_government_fee_list" model="ir.ui.view">
            <field name="name">bank.settlement.government.fee.list</field>
            <field name="model">bank.settlement.government.fee</field>
            <field name="arch" type="xml">
                <list string="الرسوم الحكومية" decoration-success="state == 'done'">
                    <field name="name"/>
                    <field name="government_entity"/>
                    <field name="fee_type"/>
                    <field name="employee_category"/>
                    <field name="employee_id"/>
                    <field name="residency_number"/>
                    <field name="transfer_date"/>
                    <field name="amount" sum="الإجمالي"/>
                    <field name="employee_amount" sum="حصة الموظفين" optional="show"/>
                    <field name="employee_payment_state" optional="hide"/>
                    <field name="state" widget="badge"
                           decoration-success="state == 'done'"
                           decoration-info="state == 'confirmed'"
                           decoration-muted="state == 'draft'"/>
                </list>
            </field>
        </record>

        <record id="view_bank_settlement_government_fee_form" model="ir.ui.view">
            <field name="name">bank.settlement.government.fee.form</field>
            <field name="model">bank.settlement.government.fee</field>
            <field name="arch" type="xml">
                <form string="رسوم حكومية">
                    <header>
                        <button name="action_submit_review" string="إرسال للمراجعة"
                                type="object" class="btn-primary"
                                invisible="state != 'draft'"/>
                        <button name="action_confirm" string="تأكيد"
                                type="object" class="btn-primary"
                                groups="bank_settlement.group_bank_settlement_manager"
                                invisible="state != 'under_review'"/>
                        <button name="action_done" string="تم السداد"
                                type="object" class="btn-primary"
                                groups="bank_settlement.group_bank_settlement_reviewer"
                                invisible="state != 'confirmed'"/>
                        <button name="action_reset_draft" string="إعادة لمسودة"
                                type="object" invisible="state not in ('under_review', 'confirmed')"/>
                        <button name="action_cancel" string="إلغاء"
                                type="object" invisible="state in ('done', 'cancel')"/>
                        <field name="state" widget="statusbar"
                               statusbar_visible="draft,under_review,confirmed,done"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_employee_move" type="object"
                                    class="oe_stat_button" icon="fa-file-text-o"
                                    invisible="not employee_move_id">
                                <div class="o_stat_info">
                                    <span class="o_stat_text">فاتورة الموظف</span>
                                    <field name="employee_payment_state" widget="badge" class="o_stat_value"/>
                                </div>
                            </button>
                        </div>
                        <div class="oe_title">
                            <h1><field name="name" readonly="1"/></h1>
                        </div>
                        <group>
                            <group string="بيانات الرسوم">
                                <field name="government_entity"/>
                                <field name="fee_type"/>
                                <field name="linked_account_id"/>
                            </group>
                            <group string="بيانات الموظف">
                                <field name="employee_category"/>
                                <field name="employee_id"/>
                                <field name="residency_number"/>
                            </group>
                        </group>
                        <group string="بيانات السداد البنكي">
                            <group>
                                <field name="transfer_date"/>
                                <field name="bank_reference"/>
                                <field name="journal_id"/>
                                <field name="currency_id" invisible="1"/>
                                <field name="amount"/>
                            </group>
                            <group>
                                <field name="project_id"/>
                                <field name="analytic_account_id" readonly="1"/>
                                <field name="operating_system"/>
                            </group>
                        </group>
                        <group string="حصة الموظف من الرسوم">
                            <field name="employee_amount"/>
                        </group>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="action_bank_settlement_government_fee" model="ir.actions.act_window">
            <field name="name">الرسوم الحكومية</field>
            <field name="res_model">bank.settlement.government.fee</field>
            <field name="view_mode">list,form</field>
        </record>

    </data>
</odoo>
