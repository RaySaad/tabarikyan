<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_bank_settlement_government_fee_list" model="ir.ui.view">
            <field name="name">bank.settlement.government.fee.list</field>
            <field name="model">bank.settlement.government.fee</field>
            <field name="arch" type="xml">
                <list string="الرسوم الحكومية" decoration-success="state == 'done'"
                      decoration-danger="state == 'rejected'">
                    <field name="name"/>
                    <field name="government_entity_id"/>
                    <field name="fee_type_id"/>
                    <field name="employee_category"/>
                    <field name="employee_id"/>
                    <field name="residency_number"/>
                    <field name="transfer_date"/>
                    <field name="amount" sum="الإجمالي"/>
                    <field name="state" widget="badge"
                           decoration-success="state == 'done'"
                           decoration-info="state == 'confirmed'"
                           decoration-danger="state == 'rejected'"
                           decoration-muted="state == 'draft'"/>
                </list>
            </field>
        </record>

        <record id="view_bank_settlement_government_fee_search" model="ir.ui.view">
            <field name="name">bank.settlement.government.fee.search</field>
            <field name="model">bank.settlement.government.fee</field>
            <field name="arch" type="xml">
                <search string="الرسوم الحكومية">
                    <field name="name"/>
                    <field name="employee_id"/>
                    <field name="government_entity_id"/>
                    <field name="fee_type_id"/>
                    <filter name="inactive" string="مؤرشف" domain="[('active', '=', False)]"/>
                    <group>
                        <filter name="group_by_state" string="الحالة" context="{'group_by': 'state'}"/>
                        <filter name="group_by_employee" string="الموظف" context="{'group_by': 'employee_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="view_bank_settlement_government_fee_form" model="ir.ui.view">
            <field name="name">bank.settlement.government.fee.form</field>
            <field name="model">bank.settlement.government.fee</field>
            <field name="arch" type="xml">
                <form string="رسوم حكومية">
                    <header>
                        <button name="action_submit_review" string="إرسال للمراجعة"
                                type="object" class="btn-primary"
                                invisible="state != 'draft'"/>
                        <button name="action_confirm" string="تأكيد"
                                type="object" class="btn-primary"
                                groups="bank_settlement.group_bank_settlement_manager"
                                invisible="state != 'under_review'"/>
                        <button name="action_done" string="تم السداد"
                                type="object" class="btn-primary"
                                groups="bank_settlement.group_bank_settlement_reviewer"
                                invisible="state != 'confirmed'"/>
                        <button name="action_open_return_wizard" string="إرجاع للتصحيح"
                                type="object" groups="bank_settlement.group_bank_settlement_manager"
                                invisible="state != 'confirmed'"/>
                        <button name="action_open_reject_wizard" string="رفض"
                                type="object" groups="bank_settlement.group_bank_settlement_reviewer"
                                invisible="state in ('done', 'cancel', 'rejected')"/>
                        <field name="state" widget="statusbar"
                               statusbar_visible="draft,under_review,confirmed,done"/>
                    </header>
                    <sheet>
                        <field name="recruitment_request_id" invisible="1"/>
                        <field name="import_request_id" invisible="1"/>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_move" type="object"
                                    class="oe_stat_button" icon="fa-file-text-o"
                                    invisible="not move_id">
                                <div class="o_stat_info">
                                    <span class="o_stat_text">قيد الجهة الحكومية</span>
                                </div>
                            </button>
                        </div>
                        <div class="oe_title">
                            <h1><field name="name" readonly="1"/></h1>
                        </div>
                        <div class="alert alert-warning" role="alert" invisible="not returned_for_correction">
                            تم إرجاع هذا السجل للتصحيح - يمكن تعديل المبلغ وبيانات السداد
                            البنكي (الحساب/دفتر اليومية/رقم السداد) مؤقتاً حتى إعادة الاعتماد.
                            هوية الموظف/المنصة تبقى مقفولة.
                        </div>
                        <group>
                            <group string="بيانات الرسوم">
                                <field name="government_entity_id"
                                       readonly="state != 'draft'"/>
                                <field name="fee_type_id"
                                       readonly="state != 'draft'"/>
                                <!-- رقم السداد مرتبط برقم مرجعي يعرفه من يرفع
                                     الطلب نفسه للجهة الحكومية منذ البداية -
                                     وليس بيانات سداد بنكي فعلي يُدخلها المحاسب
                                     لاحقاً كباقي حقول هذه الشاشة، فيبقى مفتوحاً
                                     وقابلاً للتعديل من "مسودة" مباشرة (طلب صريح). -->
                                <field name="bank_reference"
                                       readonly="state in ('done', 'rejected', 'cancel')"/>
                                <!-- الحساب المرتبط لا يظهر إلا بعد اعتماد المدير
                                     العام (أو أثناء "إرجاع للتصحيح")، ويبقى قابلاً
                                     للتعبئة تحديداً في تلك الحالة (قبل تسجيل
                                     السداد الفعلي). -->
                                <field name="linked_account_id" readonly="state != 'confirmed' and not returned_for_correction"
                                       invisible="state not in ('confirmed', 'done') and not returned_for_correction"/>
                            </group>
                            <group string="بيانات الموظف">
                                <field name="employee_category" readonly="state != 'draft'"/>
                                <field name="employee_id"
                                       required="not recruitment_request_id and not import_request_id"
                                       readonly="state != 'draft'"/>
                                <field name="residency_number"/>
                                <field name="partner_id" readonly="state != 'draft'"/>
                                <field name="company_id" groups="base.group_multi_company" readonly="1"/>
                            </group>
                        </group>
                        <group string="بيانات السداد البنكي">
                            <group>
                                <!-- بيانات السداد الفعلي (خاصة بالمحاسب وقت
                                     الصرف تحديداً) - لا تظهر إلا بعد اعتماد
                                     المدير العام (أو أثناء "إرجاع للتصحيح"). -->
                                <field name="transfer_date" readonly="state != 'confirmed' and not returned_for_correction"
                                       invisible="state not in ('confirmed', 'done') and not returned_for_correction"/>
                                <field name="journal_id" readonly="state != 'confirmed' and not returned_for_correction"
                                       invisible="state not in ('confirmed', 'done') and not returned_for_correction"/>
                                <field name="currency_id" invisible="1"/>
                                <field name="amount" readonly="state != 'draft' and not returned_for_correction"/>
                            </group>
                            <group>
                                <field name="project_id"
                                       readonly="state != 'draft'"/>
                                <field name="analytic_account_id" readonly="1"/>
                                <field name="operating_system"/>
                            </group>
                        </group>
                        <group string="الدفعة المقدمة">
                            <group>
                                <field name="is_prepaid" readonly="state != 'draft'"/>
                                <field name="prepaid_days" invisible="not is_prepaid"
                                       readonly="state != 'draft'"/>
                                <field name="prepaid_category_id" invisible="not is_prepaid"
                                       readonly="state != 'draft'"/>
                            </group>
                            <group invisible="not is_prepaid">
                                <field name="prepaid_line_count" invisible="1"/>
                                <button name="action_view_prepaid_lines" type="object"
                                        class="oe_link" invisible="not prepaid_line_count">
                                    عرض جدول الاستحقاق
                                </button>
                            </group>
                        </group>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="action_bank_settlement_government_fee" model="ir.actions.act_window">
            <field name="name">الرسوم الحكومية</field>
            <field name="res_model">bank.settlement.government.fee</field>
            <field name="view_mode">list,form</field>
        </record>

    </data>
</odoo>
