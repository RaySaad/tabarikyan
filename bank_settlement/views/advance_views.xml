<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_bank_settlement_advance_list" model="ir.ui.view">
            <field name="name">bank.settlement.advance.list</field>
            <field name="model">bank.settlement.advance</field>
            <field name="arch" type="xml">
                <list string="السلف" decoration-success="state == 'paid'"
                      decoration-info="state == 'waiting_approval'">
                    <field name="name"/>
                    <field name="employee_id"/>
                    <field name="residency_number"/>
                    <field name="employee_category"/>
                    <field name="advance_reason"/>
                    <field name="amount" sum="الإجمالي"/>
                    <field name="state" widget="badge"
                           decoration-success="state == 'paid'"
                           decoration-info="state == 'waiting_approval'"
                           decoration-muted="state == 'draft'"/>
                </list>
            </field>
        </record>

        <record id="view_bank_settlement_advance_form" model="ir.ui.view">
            <field name="name">bank.settlement.advance.form</field>
            <field name="model">bank.settlement.advance</field>
            <field name="arch" type="xml">
                <form string="سلفة">
                    <header>
                        <button name="action_submit_review" string="إرسال للمراجعة"
                                type="object" class="btn-primary"
                                invisible="state != 'draft'"/>
                        <button name="action_confirm" string="الموافقة"
                                type="object" class="btn-primary"
                                groups="bank_settlement.group_bank_settlement_manager"
                                invisible="state != 'waiting_approval'"/>
                        <button name="action_done" string="تم الصرف"
                                type="object" class="btn-primary"
                                groups="bank_settlement.group_bank_settlement_reviewer"
                                invisible="state != 'approved'"/>
                        <button name="action_reset_draft" string="إعادة لمسودة"
                                type="object" groups="bank_settlement.group_bank_settlement_manager"
                                invisible="state not in ('waiting_approval', 'approved')"/>
                        <button name="action_cancel" string="إلغاء"
                                type="object" groups="bank_settlement.group_bank_settlement_reviewer"
                                invisible="state in ('paid', 'cancel')"/>
                        <field name="state" widget="statusbar"
                               statusbar_visible="draft,waiting_approval,approved,paid"/>
                    </header>
                    <sheet>
                        <widget name="web_ribbon" title="ملغاة" bg_color="text-bg-danger"
                                invisible="state != 'cancel'"/>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_move" type="object"
                                    class="oe_stat_button" icon="fa-file-text-o"
                                    invisible="not move_id">
                                <div class="o_stat_info">
                                    <span class="o_stat_text">القيد المحاسبي</span>
                                </div>
                            </button>
                        </div>
                        <div class="oe_title">
                            <h1><field name="name" readonly="1"/></h1>
                        </div>
                        <group>
                            <group string="بيانات الموظف">
                                <field name="employee_id" required="1"/>
                                <field name="residency_number"/>
                                <field name="employee_category"/>
                            </group>
                            <group string="بيانات السلفة">
                                <field name="advance_reason"/>
                                <field name="currency_id" invisible="1"/>
                                <field name="amount" readonly="move_id"/>
                                <field name="linked_account_id" readonly="move_id"/>
                            </group>
                        </group>
                        <group string="بيانات السداد البنكي">
                            <group>
                                <field name="transfer_date"/>
                                <field name="bank_reference"/>
                                <field name="journal_id" readonly="move_id"/>
                            </group>
                            <group>
                                <field name="project_id"/>
                                <field name="analytic_account_id" readonly="1"/>
                            </group>
                        </group>
                        <group string="ملاحظات">
                            <field name="notes" nolabel="1"/>
                        </group>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="action_bank_settlement_advance" model="ir.actions.act_window">
            <field name="name">السلف</field>
            <field name="res_model">bank.settlement.advance</field>
            <field name="view_mode">list,form</field>
        </record>

    </data>
</odoo>
