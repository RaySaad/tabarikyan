<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- noupdate="1": تُنشأ هذه القيم مرة واحدة فقط (نفس القائمة الثابتة
         القديمة، لعدم فقدان أي خيار كان موجوداً) - بعدها المستخدم حر في
         تعديلها/إضافة غيرها/أرشفتها من "السداد البنكي ← الإعدادات" دون
         أن تُعاد الكتابة عليها في أي ترقية لاحقة للموديول. -->
    <data noupdate="1">

        <!-- الجهة الحكومية -->
        <record id="government_entity_mol_resident" model="bank.settlement.government.entity">
            <field name="name">وزارة الداخلية ( مقيم )</field>
            <field name="sequence">10</field>
        </record>
        <record id="government_entity_hrsd_expat" model="bank.settlement.government.entity">
            <field name="name">وزارة التنمية و الموارد البشرية ( قوى &amp; أجير )</field>
            <field name="sequence">20</field>
        </record>

        <!-- نوع الرسوم الحكومية -->
        <record id="government_fee_type_office_fee" model="bank.settlement.government.fee.type">
            <field name="name">رسوم مكتب العمل</field>
            <field name="sequence">10</field>
        </record>
        <record id="government_fee_type_passport_fee" model="bank.settlement.government.fee.type">
            <field name="name">رسوم الجوازات</field>
            <field name="sequence">20</field>
        </record>
        <record id="government_fee_type_sponsorship_transfer" model="bank.settlement.government.fee.type">
            <field name="name">رسوم نقل كفالة</field>
            <field name="sequence">30</field>
        </record>
        <record id="government_fee_type_import_request" model="bank.settlement.government.fee.type">
            <field name="name">رسوم استقدام</field>
            <field name="sequence">40</field>
        </record>

        <!-- نوع تحويل المركبة -->
        <record id="vehicle_transfer_type_sticker_purchase" model="bank.settlement.vehicle.transfer.type">
            <field name="name">شراء استيكرات</field>
            <field name="sequence">10</field>
        </record>
        <record id="vehicle_transfer_type_sticker_install" model="bank.settlement.vehicle.transfer.type">
            <field name="name">تركيب استيكر</field>
            <field name="sequence">20</field>
        </record>
        <record id="vehicle_transfer_type_vehicle_transfer" model="bank.settlement.vehicle.transfer.type">
            <field name="name">نقل مركبة</field>
            <field name="sequence">30</field>
        </record>
        <record id="vehicle_transfer_type_new_reg_public" model="bank.settlement.vehicle.transfer.type">
            <field name="name">تسجيل سيارة جديدة نقل عام</field>
            <field name="sequence">40</field>
        </record>
        <record id="vehicle_transfer_type_new_reg_private" model="bank.settlement.vehicle.transfer.type">
            <field name="name">تسجيل سيارة جديد نقل خصوصي</field>
            <field name="sequence">50</field>
        </record>
        <record id="vehicle_transfer_type_ownership_transfer_car" model="bank.settlement.vehicle.transfer.type">
            <field name="name">نقل ملكية سيارة</field>
            <field name="sequence">60</field>
        </record>
        <record id="vehicle_transfer_type_ownership_transfer_bike" model="bank.settlement.vehicle.transfer.type">
            <field name="name">نقل ملكية دباب</field>
            <field name="sequence">70</field>
        </record>
        <record id="vehicle_transfer_type_fuel_oil" model="bank.settlement.vehicle.transfer.type">
            <field name="name">وقود وزيوت</field>
            <field name="sequence">80</field>
        </record>
        <record id="vehicle_transfer_type_bike_plate_issue" model="bank.settlement.vehicle.transfer.type">
            <field name="name">أصدار لوحات دباب</field>
            <field name="sequence">90</field>
        </record>
        <record id="vehicle_transfer_type_bike_form_issue" model="bank.settlement.vehicle.transfer.type">
            <field name="name">اصدار استمارة دباب</field>
            <field name="sequence">100</field>
        </record>
        <record id="vehicle_transfer_type_form_issue_lost" model="bank.settlement.vehicle.transfer.type">
            <field name="name">اصدار استمارة بدل فاقد</field>
            <field name="sequence">110</field>
        </record>
        <record id="vehicle_transfer_type_plate_issue_lost" model="bank.settlement.vehicle.transfer.type">
            <field name="name">أصدار لوحة بدل فاقد</field>
            <field name="sequence">120</field>
        </record>
        <record id="vehicle_transfer_type_plate_change" model="bank.settlement.vehicle.transfer.type">
            <field name="name">تغيير لوحات سيارة</field>
            <field name="sequence">130</field>
        </record>
        <record id="vehicle_transfer_type_public_transport_authority" model="bank.settlement.vehicle.transfer.type">
            <field name="name">هيئة النقل العام</field>
            <field name="sequence">140</field>
        </record>
        <record id="vehicle_transfer_type_car_rental" model="bank.settlement.vehicle.transfer.type">
            <field name="name">ايجار سيارة</field>
            <field name="sequence">150</field>
        </record>
        <record id="vehicle_transfer_type_driving_license" model="bank.settlement.vehicle.transfer.type">
            <field name="name">رخصة قيادة</field>
            <field name="sequence">160</field>
        </record>
        <record id="vehicle_transfer_type_traffic_violation" model="bank.settlement.vehicle.transfer.type">
            <field name="name">مخالفة مرور</field>
            <field name="sequence">170</field>
        </record>
        <record id="vehicle_transfer_type_movement_officer_custody" model="bank.settlement.vehicle.transfer.type">
            <field name="name">عهدة مسؤول حركة</field>
            <field name="sequence">180</field>
        </record>
        <record id="vehicle_transfer_type_other" model="bank.settlement.vehicle.transfer.type">
            <field name="name">اخري</field>
            <field name="sequence">190</field>
        </record>

        <!-- نوع رسوم التأمين الطبي -->
        <record id="medical_insurance_type_medical_insurance" model="bank.settlement.medical.insurance.type">
            <field name="name">تأمين طبي</field>
            <field name="sequence">10</field>
        </record>
        <record id="medical_insurance_type_medical_checkup" model="bank.settlement.medical.insurance.type">
            <field name="name">فحص طبي</field>
            <field name="sequence">20</field>
        </record>

        <!-- سبب السلفة -->
        <record id="advance_reason_salary_advance" model="bank.settlement.advance.reason">
            <field name="name">سلفة راتب</field>
            <field name="sequence">10</field>
        </record>
        <record id="advance_reason_emergency" model="bank.settlement.advance.reason">
            <field name="name">طارئة</field>
            <field name="sequence">20</field>
        </record>

    </data>

    <!-- بدون noupdate: يجب أن تعمل هذه الاستدعاءات في كل ترقية للموديول
         (وليس فقط عند التثبيت الأول) لتهاجر بيانات السجلات الموجودة
         فعلاً من الحقول القديمة (Selection) للحقول الجديدة (Many2one)
         أعلاه - وهي آمنة للتكرار (WHERE ... IS NULL في كل دالة). -->
    <data>
        <function model="bank.settlement.government.fee" name="_migrate_selection_fields_to_many2one" eval="[]"/>
        <function model="bank.settlement.vehicle.transfer" name="_migrate_selection_fields_to_many2one" eval="[]"/>
        <function model="bank.settlement.medical.insurance" name="_migrate_selection_fields_to_many2one" eval="[]"/>
        <function model="bank.settlement.advance" name="_migrate_selection_fields_to_many2one" eval="[]"/>
    </data>
</odoo>
