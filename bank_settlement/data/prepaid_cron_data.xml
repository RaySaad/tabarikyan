<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ترحيل قيود استحقاق "الدفعة المقدمة" - يومياً، بلا مراجعة
             بشرية (طلب صريح) - انظر
             prepaid_schedule.py._cron_generate_due_entries. -->
        <record id="cron_bank_settlement_prepaid_generate_entries" model="ir.cron">
            <field name="name">السداد البنكي: ترحيل استحقاقات الدفعات المقدمة</field>
            <field name="model_id" ref="model_bank_settlement_prepaid_line"/>
            <field name="state">code</field>
            <field name="code">model._cron_generate_due_entries()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

    </data>
</odoo>
