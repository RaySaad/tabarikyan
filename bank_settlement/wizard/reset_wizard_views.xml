<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_bank_settlement_reset_wizard_form" model="ir.ui.view">
        <field name="name">bank.settlement.reset.wizard.form</field>
        <field name="model">bank.settlement.reset.wizard</field>
        <field name="arch" type="xml">
            <form string="إعادة السجل لمسودة">
                <field name="res_model" invisible="1"/>
                <field name="res_id" invisible="1"/>
                <group>
                    <field name="reason" placeholder="وضّح سبب إعادة هذا السجل لمسودة..."/>
                </group>
                <footer>
                    <button name="action_confirm_reset" type="object"
                            string="تأكيد الإعادة لمسودة" class="btn-primary"/>
                    <button string="إلغاء" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
