<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_bank_settlement_reject_wizard_form" model="ir.ui.view">
        <field name="name">bank.settlement.reject.wizard.form</field>
        <field name="model">bank.settlement.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="رفض السجل">
                <field name="res_model" invisible="1"/>
                <field name="res_id" invisible="1"/>
                <group>
                    <field name="reason" placeholder="وضّح سبب رفض هذا السجل..."/>
                </group>
                <footer>
                    <button name="action_confirm_reject" type="object"
                            string="تأكيد الرفض" class="btn-primary"/>
                    <button string="إلغاء" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
