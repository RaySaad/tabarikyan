<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_bank_settlement_sequence_reset_wizard_form" model="ir.ui.view">
        <field name="name">bank.settlement.sequence.reset.wizard.form</field>
        <field name="model">bank.settlement.sequence.reset.wizard</field>
        <field name="arch" type="xml">
            <form string="إعادة ضبط الترقيم">
                <div class="alert alert-danger" role="alert">
                    تحذير: تأكد أن كل السجلات صاحبة الأرقام الحالية أو الأعلى
                    من الرقم الجديد قد حُذفت فعلاً - وإلا ستتكرر نفس الأكواد
                    على سجلات مختلفة.
                </div>
                <group>
                    <field name="sequence_model"/>
                    <field name="next_number"/>
                    <field name="confirmation_text" placeholder="إعادة ترقيم"/>
                </group>
                <footer>
                    <button name="action_confirm_reset" type="object"
                            string="تأكيد إعادة الضبط" class="btn-danger"/>
                    <button string="إلغاء" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_bank_settlement_sequence_reset_wizard" model="ir.actions.act_window">
        <field name="name">إعادة ضبط الترقيم</field>
        <field name="res_model">bank.settlement.sequence.reset.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
