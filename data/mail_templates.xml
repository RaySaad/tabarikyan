<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="mail_template_request_approved" model="mail.template">
            <field name="name">طلب توظيف - تمت الموافقة</field>
            <field name="model_id" ref="model_recruitment_request"/>
            <field name="subject">طلب التوظيف {{ object.name }} - تمت الموافقة</field>
            <field name="email_from">{{ (object.company_id.email or user.email) }}</field>
            <field name="email_to">{{ object.email }}</field>
            <field name="body_html" type="html">
                <div style="margin:0px;padding:0px;font-size:14px;" dir="rtl">
                    <p>مرحباً،</p>
                    <p>تمت الموافقة على طلب التوظيف <strong t-out="object.name or ''">REC/2026/00001</strong>
                       الخاص بالموظف <strong t-out="object.employee_name or ''"></strong>.</p>
                    <p>المرحلة الحالية: <strong t-out="object.stage_id.name or ''"></strong></p>
                </div>
            </field>
            <field name="lang">{{ object.company_id.partner_id.lang }}</field>
            <field name="auto_delete" eval="True"/>
        </record>

        <record id="mail_template_request_rejected" model="mail.template">
            <field name="name">طلب توظيف - تم الرفض</field>
            <field name="model_id" ref="model_recruitment_request"/>
            <field name="subject">طلب التوظيف {{ object.name }} - تم الرفض</field>
            <field name="email_from">{{ (object.company_id.email or user.email) }}</field>
            <field name="email_to">{{ object.email }}</field>
            <field name="body_html" type="html">
                <div style="margin:0px;padding:0px;font-size:14px;" dir="rtl">
                    <p>مرحباً،</p>
                    <p>نأسف لإبلاغك بأن طلب التوظيف <strong t-out="object.name or ''"></strong> قد تم رفضه.</p>
                    <p>السبب: <span t-out="object.rejection_reason or 'غير محدد'"></span></p>
                </div>
            </field>
            <field name="lang">{{ object.company_id.partner_id.lang }}</field>
            <field name="auto_delete" eval="True"/>
        </record>

    </data>
</odoo>
