<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- ============================================================
             آلية العمل - مهمة لفهم الملف كله:

             قواعد السجلات المرتبطة بمجموعات (وليست global) تُدمَج بينها
             بـ OR لا AND. ولهذا لا يكفي *إضافة* قاعدة مقيِّدة: أودو
             تشحن أصلاً قواعد مفتوحة [(1,'=',1)] على نفس مجموعات المحاسبة
             (see_all / group_invoice / group_readonly)، فتُدمَج مع أي
             قاعدة جديدة بـ OR وتُبطلها تماماً. تحقّقنا من ذلك عملياً:
             قواعد الدفاتر عملت من أول مرة (لا توجد قاعدة مفتوحة عليها)
             بينما لم تعمل قواعد القيود والبنود إطلاقاً.

             الحل: تعديل *نفس* القواعد المفتوحة لتصبح مدرِكة للفرق، مع
             قاعدة مفتوحة خاصة بمدير المحاسبة تعيد له الرؤية الكاملة
             عبر نفس منطق الـOR.

             عند إلغاء تثبيت هذا الموديول تُعاد القواعد الثلاث لأصلها
             تلقائياً (انظر uninstall_hook في __init__.py) - وإلا بقيت
             تشير لحقل team_ids المحذوف فتتعطل المحاسبة بالكامل.
             ============================================================ -->

        <!-- ================= دفاتر اليومية ================= -->
        <!-- هنا نضيف قاعدة جديدة (لا توجد قاعدة مفتوحة على الدفاتر) -->
        <record id="account_journal_team_rule" model="ir.rule">
            <field name="name">دفاتر اليومية: حسب الفريق المحاسبي</field>
            <field name="model_id" ref="account.model_account_journal"/>
            <field name="groups" eval="[(4, ref('account.group_account_invoice'))]"/>
            <field name="domain_force">['|', ('team_ids', '=', False), ('team_ids', 'in', user.accounting_team_ids.ids)]</field>
        </record>

        <record id="account_journal_manager_rule" model="ir.rule">
            <field name="name">دفاتر اليومية: مدير المحاسبة يرى الكل</field>
            <field name="model_id" ref="account.model_account_journal"/>
            <field name="groups" eval="[(4, ref('account.group_account_manager'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <!-- ========= القيود والفواتير ========= -->
        <!-- قواعد أودو المفتوحة تُعدَّل برمجياً عند التثبيت (post_init_hook
             في __init__.py) - تعديلها من XML مستحيل: سجلاتها داخل كتلة
             noupdate="1" فيُتجاهَل أي <record> يستهدفها بصمت. -->
        <record id="account_move_manager_rule" model="ir.rule">
            <field name="name">القيود والفواتير: مدير المحاسبة يرى الكل</field>
            <field name="model_id" ref="account.model_account_move"/>
            <field name="groups" eval="[(4, ref('account.group_account_manager'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <!-- ========= بنود القيود ========= -->
        <record id="account_move_line_manager_rule" model="ir.rule">
            <field name="name">بنود القيود: مدير المحاسبة يرى الكل</field>
            <field name="model_id" ref="account.model_account_move_line"/>
            <field name="groups" eval="[(4, ref('account.group_account_manager'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

    </data>
</odoo>
