<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- ============================================================
             قواعد الشركات لنماذج الصيانة
             ============================================================
             لم تكن هناك أي قاعدة على هذه النماذج: من يملك مجموعة
             الأسطول كان يرى وقود كل الفروع وخططها وتقاريرها بلا فرز.
             ============================================================ -->

        <!-- الوقود: تكلفته على الفرع، واستهلاكه يهمّ الأسطول مالك
             المركبة - فيراه الطرفان، ولا يراه فرع ثالث. -->
        <record id="fleet_fuel_log_company_rule" model="ir.rule">
            <field name="name">تعبئات الوقود: الفرع المتحمِّل أو مالك المركبة</field>
            <field name="model_id" ref="model_fleet_fuel_log"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('company_id', 'in', company_ids), ('vehicle_id.company_id', 'in', company_ids)]</field>
        </record>

        <!-- خطط الصيانة يملكها الأسطول، ويقرؤها الفرع الذي المركبة
             لديه ليعرف موعد دخولها الورشة. -->
        <record id="fleet_maintenance_plan_company_rule" model="ir.rule">
            <field name="name">خطط الصيانة: الأسطول أو الفرع المستأجر</field>
            <field name="model_id" ref="model_fleet_maintenance_plan"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('company_id', 'in', company_ids), ('vehicle_id.rental_branch_id', 'in', company_ids)]</field>
        </record>

        <record id="fleet_service_request_company_rule" model="ir.rule">
            <field name="name">طلبات الصيانة: الفرع الطالب أو الأسطول</field>
            <field name="model_id" ref="model_fleet_service_request"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('company_id', 'in', company_ids), ('fleet_company_id', 'in', company_ids)]</field>
        </record>

        <record id="fleet_vehicle_cost_report_company_rule" model="ir.rule">
            <field name="name">تقرير تكلفة المركبة: الأسطول أو الفرع المستأجر</field>
            <field name="model_id" ref="model_fleet_vehicle_cost_report"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('company_id', 'in', company_ids), ('vehicle_id.rental_branch_id', 'in', company_ids)]</field>
        </record>

        <record id="fleet_employee_cost_report_company_rule" model="ir.rule">
            <field name="name">تقرير تكلفة المندوب: حسب الفرع</field>
            <field name="model_id" ref="model_fleet_employee_cost_report"/>
            <field name="global" eval="True"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

    </data>
</odoo>
