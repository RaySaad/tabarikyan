<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_fleet_fuel_log_list" model="ir.ui.view">
            <field name="name">fleet.fuel.log.list</field>
            <field name="model">fleet.fuel.log</field>
            <field name="arch" type="xml">
                <list string="تعبئات الوقود" editable="bottom">
                    <field name="date"/>
                    <field name="vehicle_id" options="{'no_create': True, 'no_open': True}"/>
                    <field name="odometer"/>
                    <field name="liters" sum="اللترات"/>
                    <field name="amount" sum="المبلغ"/>
                    <field name="price_per_liter" optional="show"/>
                    <field name="distance" optional="hide"/>
                    <field name="consumption" optional="show"/>
                    <field name="company_id" string="الفرع المتحمِّل" readonly="1"
                           options="{'no_create': True, 'no_open': True}"/>
                    <field name="driver_id" optional="hide"
                           options="{'no_create': True, 'no_open': True}"/>
                    <field name="currency_id" column_invisible="True"/>
                </list>
            </field>
        </record>

        <record id="view_fleet_fuel_log_form" model="ir.ui.view">
            <field name="name">fleet.fuel.log.form</field>
            <field name="model">fleet.fuel.log</field>
            <field name="arch" type="xml">
                <form string="تعبئة وقود">
                    <sheet>
                        <group>
                            <group string="التعبئة">
                                <field name="vehicle_id"
                                       options="{'no_create': True, 'no_open': True}"/>
                                <field name="date"/>
                                <field name="odometer"/>
                                <field name="liters"/>
                                <field name="amount"/>
                                <field name="currency_id" invisible="1"/>
                                <field name="price_per_liter" readonly="1"/>
                            </group>
                            <group string="التحمّل والاستهلاك">
                                <field name="company_id"
                                       options="{'no_create': True, 'no_open': True}"/>
                                <field name="contract_id" readonly="1"
                                       invisible="not contract_id"
                                       options="{'no_create': True, 'no_open': True}"/>
                                <field name="driver_id"
                                       options="{'no_create': True, 'no_open': True}"/>
                                <field name="distance" readonly="1"/>
                                <field name="consumption" readonly="1"/>
                                <field name="settlement_id"
                                       options="{'no_create': True, 'no_open': True}"/>
                            </group>
                        </group>
                        <group string="ملاحظة">
                            <field name="note" nolabel="1"/>
                        </group>
                        <div class="alert alert-info" role="alert">
                            الوقود يدفعه المستأجر: تكلفته على الفرع المتحمِّل أعلاه ولا
                            تدخل دفاتر شركة الأسطول ولا صافيها. والسجل يبقى على المركبة
                            لقياس الاستهلاك، وقراءة عدّاده تُغذّي جدولة الصيانة.
                        </div>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_fleet_fuel_log_search" model="ir.ui.view">
            <field name="name">fleet.fuel.log.search</field>
            <field name="model">fleet.fuel.log</field>
            <field name="arch" type="xml">
                <search string="تعبئات الوقود">
                    <field name="vehicle_id"/>
                    <field name="driver_id"/>
                    <field name="company_id"/>
                    <filter name="this_month" string="هذا الشهر"
                            domain="[('date', '&gt;=', (context_today().replace(day=1)).strftime('%Y-%m-%d'))]"/>
                    <filter name="weak" string="استهلاك ضعيف (أقل من 8 كم/لتر)"
                            domain="[('consumption', '&gt;', 0), ('consumption', '&lt;', 8)]"/>
                    <group>
                        <filter name="group_vehicle" string="المركبة"
                                context="{'group_by': 'vehicle_id'}"/>
                        <filter name="group_company" string="الفرع المتحمِّل"
                                context="{'group_by': 'company_id'}"/>
                        <filter name="group_driver" string="السائق"
                                context="{'group_by': 'driver_id'}"/>
                        <filter name="group_month" string="الشهر"
                                context="{'group_by': 'date:month'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="view_fleet_fuel_log_pivot" model="ir.ui.view">
            <field name="name">fleet.fuel.log.pivot</field>
            <field name="model">fleet.fuel.log</field>
            <field name="arch" type="xml">
                <pivot string="استهلاك الوقود" sample="1">
                    <field name="vehicle_id" type="row"/>
                    <field name="date" interval="month" type="col"/>
                    <field name="liters" type="measure"/>
                    <field name="amount" type="measure"/>
                </pivot>
            </field>
        </record>

        <record id="action_fleet_fuel_log" model="ir.actions.act_window">
            <field name="name">تعبئات الوقود</field>
            <field name="res_model">fleet.fuel.log</field>
            <field name="view_mode">list,pivot,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">سجّل أول تعبئة</p>
                <p>التكلفة تُنسب للفرع المستأجر تلقائياً من عقد المركبة يوم التعبئة،
                   والسجل يبقى على المركبة لقياس الاستهلاك.</p>
            </field>
        </record>

    </data>
</odoo>
