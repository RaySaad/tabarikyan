<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_fleet_service_request_list" model="ir.ui.view">
            <field name="name">fleet.service.request.list</field>
            <field name="model">fleet.service.request</field>
            <field name="arch" type="xml">
                <list string="طلبات الصيانة"
                      decoration-danger="urgency == 'urgent' and state == 'new'"
                      decoration-muted="state in ('done', 'refused')">
                    <field name="date_request"/>
                    <field name="vehicle_id"/>
                    <field name="company_id" string="الفرع"/>
                    <field name="request_type"/>
                    <field name="urgency"/>
                    <field name="employee_id" optional="show"/>
                    <field name="odometer" optional="hide"/>
                    <field name="service_log_id" optional="hide"/>
                    <field name="state" widget="badge"
                           decoration-info="state == 'new'"
                           decoration-warning="state == 'accepted'"
                           decoration-success="state == 'done'"
                           decoration-danger="state == 'refused'"/>
                </list>
            </field>
        </record>

        <record id="view_fleet_service_request_form" model="ir.ui.view">
            <field name="name">fleet.service.request.form</field>
            <field name="model">fleet.service.request</field>
            <field name="arch" type="xml">
                <form string="طلب صيانة">
                    <header>
                        <!-- أزرار الأسطول: الفرع لا يملك الكتابة أصلاً،
                             وإخفاؤها يمنع نقرة تنتهي برسالة صلاحيات. -->
                        <button name="action_accept" type="object"
                                string="قبول الطلب" class="btn-primary"
                                invisible="state != 'new'"
                                groups="recruitment_workflow.group_recruitment_workflow_fleet_supervisor"/>
                        <button name="action_done" type="object"
                                string="تسجيل التنفيذ"
                                invisible="state not in ('new', 'accepted')"
                                groups="recruitment_workflow.group_recruitment_workflow_fleet_supervisor"/>
                        <button name="action_refuse" type="object"
                                string="رفض"
                                invisible="state in ('done', 'refused')"
                                groups="recruitment_workflow.group_recruitment_workflow_fleet_supervisor"/>
                        <field name="state" widget="statusbar"
                               statusbar_visible="new,accepted,done"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1><field name="name" readonly="1"/></h1>
                        </div>
                        <group>
                            <group string="المركبة">
                                <field name="vehicle_id" readonly="state != 'new'"
                                       options="{'no_create': True, 'no_open': True}"/>
                                <field name="employee_id" readonly="state != 'new'"
                                       options="{'no_create': True, 'no_open': True}"/>
                                <field name="odometer"/>
                                <field name="company_id" readonly="1"
                                       options="{'no_create': True, 'no_open': True}"/>
                                <field name="fleet_company_id" invisible="1"/>
                            </group>
                            <group string="الطلب">
                                <field name="request_type" readonly="state != 'new'"/>
                                <field name="urgency" readonly="state != 'new'"/>
                                <field name="date_request" readonly="state != 'new'"/>
                                <field name="service_log_id" readonly="1"
                                       invisible="not service_log_id"
                                       options="{'no_create': True, 'no_open': True}"/>
                            </group>
                        </group>
                        <group string="وصف العطل">
                            <field name="description" nolabel="1"
                                   placeholder="ماذا يحدث للمركبة؟ منذ متى؟"/>
                        </group>
                        <group string="رد الأسطول" invisible="state == 'new' and not fleet_note">
                            <field name="fleet_note" nolabel="1"
                                   placeholder="موعد دخول الورشة، أو سبب الرفض."/>
                        </group>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="view_fleet_service_request_search" model="ir.ui.view">
            <field name="name">fleet.service.request.search</field>
            <field name="model">fleet.service.request</field>
            <field name="arch" type="xml">
                <search string="طلبات الصيانة">
                    <field name="vehicle_id"/>
                    <field name="employee_id"/>
                    <field name="description"/>
                    <filter name="filter_new" string="مُقدَّم"
                            domain="[('state', '=', 'new')]"/>
                    <filter name="filter_urgent" string="عاجل"
                            domain="[('urgency', '=', 'urgent')]"/>
                    <filter name="filter_open" string="غير منتهٍ"
                            domain="[('state', 'in', ('new', 'accepted'))]"/>
                    <separator/>
                    <filter name="group_state" string="الحالة"
                            context="{'group_by': 'state'}"/>
                    <filter name="group_company" string="الفرع"
                            context="{'group_by': 'company_id'}"/>
                    <filter name="group_vehicle" string="المركبة"
                            context="{'group_by': 'vehicle_id'}"/>
                </search>
            </field>
        </record>

        <record id="action_fleet_service_request" model="ir.actions.act_window">
            <field name="name">طلبات الصيانة</field>
            <field name="res_model">fleet.service.request</field>
            <field name="view_mode">list,form</field>
            <field name="context">{'search_default_filter_open': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">سجّل طلب صيانة للمركبة</p>
                <p>يصل الطلب إلى الأسطول مباشرةً مع تنبيه لمسؤول المركبة.</p>
            </field>
        </record>

        <record id="view_fleet_service_request_close_wizard_form" model="ir.ui.view">
            <field name="name">fleet.service.request.close.wizard.form</field>
            <field name="model">fleet.service.request.close.wizard</field>
            <field name="arch" type="xml">
                <form string="تسجيل تنفيذ الصيانة">
                    <group>
                        <field name="request_id" invisible="1"/>
                        <field name="vehicle_id" readonly="1"
                               options="{'no_open': True}"/>
                        <field name="date"/>
                        <field name="amount"/>
                        <field name="currency_id" invisible="1"/>
                        <field name="note" placeholder="تغيير زيت وفلتر..."/>
                    </group>
                    <footer>
                        <button name="action_confirm" type="object"
                                string="تأكيد" class="btn-primary"/>
                        <button string="إلغاء" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

    </data>
</odoo>
