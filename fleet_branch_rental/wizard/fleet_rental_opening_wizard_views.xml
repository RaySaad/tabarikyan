<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_fleet_rental_opening_wizard_form" model="ir.ui.view">
            <field name="name">fleet.rental.opening.wizard.form</field>
            <field name="model">fleet.rental.opening.wizard</field>
            <field name="arch" type="xml">
                <form string="إنشاء عقود تأجير افتتاحية">
                    <div class="alert alert-info" role="alert">
                        يُنشأ لكل مركبة خاضعة للتحميل عقدٌ سارٍ مع فرع سائقها الحالي.
                        المركبات التي بلا سائق أو بلا أجرة شهرية تُترك، وتُعرض أسبابها
                        في نهاية العملية. والمركبة التي لها عقد سارٍ لا تتكرر.
                    </div>
                    <group>
                        <field name="date_start"/>
                        <field name="vehicle_ids" widget="many2many_tags"
                               options="{'no_create': True, 'no_open': True}"/>
                    </group>
                    <footer>
                        <button name="action_create_contracts" type="object"
                                string="إنشاء العقود" class="btn-primary"/>
                        <button string="إلغاء" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_fleet_rental_opening_wizard" model="ir.actions.act_window">
            <field name="name">عقود تأجير افتتاحية</field>
            <field name="res_model">fleet.rental.opening.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>
    </data>
</odoo>
