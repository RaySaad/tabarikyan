<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_fleet_rental_contract_list" model="ir.ui.view">
            <field name="name">fleet.rental.contract.list</field>
            <field name="model">fleet.rental.contract</field>
            <field name="arch" type="xml">
                <list string="عقود تأجير المركبات"
                      decoration-muted="state in ('ended', 'cancel')">
                    <field name="name"/>
                    <field name="vehicle_id" options="{'no_create': True, 'no_open': True}"/>
                    <field name="company_id" options="{'no_create': True, 'no_open': True}"/>
                    <field name="employee_id" optional="show"
                           options="{'no_create': True, 'no_open': True}"/>
                    <field name="date_start"/>
                    <field name="date_end"/>
                    <field name="monthly_rate" sum="إجمالي الأجرة الشهرية"/>
                    <field name="currency_id" column_invisible="True"/>
                    <field name="state" widget="badge"
                           decoration-success="state == 'active'"
                           decoration-muted="state != 'active'"/>
                </list>
            </field>
        </record>

        <record id="view_fleet_rental_contract_form" model="ir.ui.view">
            <field name="name">fleet.rental.contract.form</field>
            <field name="model">fleet.rental.contract</field>
            <field name="arch" type="xml">
                <form string="عقد تأجير مركبة">
                    <header>
                        <button name="action_print" type="object"
                                string="طباعة العقد" class="btn-primary"/>
                        <button name="action_end" type="object"
                                string="إنهاء العقد"
                                invisible="state != 'active'"
                                confirm="سيتوقف احتساب الأجرة من اليوم. متابعة؟"/>
                        <button name="action_cancel" type="object"
                                string="إلغاء"
                                invisible="state == 'cancel'"/>
                        <field name="state" widget="statusbar"
                               statusbar_visible="active,ended"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1><field name="name" readonly="1"/></h1>
                        </div>
                        <group>
                            <group string="طرفا العقد">
                                <field name="fleet_company_id" readonly="1"
                                       options="{'no_create': True, 'no_open': True}"/>
                                <field name="company_id" readonly="state != 'active'"
                                       options="{'no_create': True, 'no_open': True}"/>
                                <field name="employee_id" readonly="state != 'active'"
                                       options="{'no_create': True, 'no_open': True}"/>
                                <field name="recruitment_request_id" readonly="1"
                                       invisible="not recruitment_request_id"
                                       options="{'no_create': True, 'no_open': True}"/>
                            </group>
                            <group string="المركبة والمدة">
                                <field name="vehicle_id" readonly="state != 'active'"
                                       options="{'no_create': True, 'no_open': True}"/>
                                <field name="monthly_rate" readonly="state != 'active'"/>
                                <field name="currency_id" invisible="1"/>
                                <field name="date_start" readonly="state != 'active'"/>
                                <field name="date_end" readonly="1"
                                       invisible="not date_end"/>
                                <field name="end_reason" readonly="1"
                                       invisible="not end_reason"/>
                            </group>
                        </group>
                        <group string="ملاحظات">
                            <field name="note" nolabel="1"/>
                        </group>
                        <div class="alert alert-info" role="alert">
                            الأجرة تشمل الاستهلاك والتأمين والاستمارة والصيانة الدورية
                            والأعطال - على المؤجِّر. والحوادث والتلفيات على المستأجر
                            بنسبة تحمّله. وتتوقف الأجرة يوم إرجاع المركبة.
                        </div>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="view_fleet_rental_contract_search" model="ir.ui.view">
            <field name="name">fleet.rental.contract.search</field>
            <field name="model">fleet.rental.contract</field>
            <field name="arch" type="xml">
                <search string="عقود التأجير">
                    <field name="name"/>
                    <field name="vehicle_id"/>
                    <field name="company_id"/>
                    <field name="employee_id"/>
                    <filter name="active" string="سارية" domain="[('state', '=', 'active')]"/>
                    <filter name="ended" string="منتهية" domain="[('state', '=', 'ended')]"/>
                    <group>
                        <filter name="group_company" string="الفرع"
                                context="{'group_by': 'company_id'}"/>
                        <filter name="group_vehicle" string="المركبة"
                                context="{'group_by': 'vehicle_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="action_fleet_rental_contract" model="ir.actions.act_window">
            <field name="name">عقود تأجير المركبات</field>
            <field name="res_model">fleet.rental.contract</field>
            <field name="view_mode">list,form</field>
            <field name="context">{'search_default_active': 1}</field>
        </record>

        <!-- ============ عقد للطباعة والتوقيع ============ -->
        <record id="action_report_fleet_rental_contract" model="ir.actions.report">
            <field name="name">عقد تأجير مركبة</field>
            <field name="model">fleet.rental.contract</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">fleet_branch_rental.report_fleet_rental_contract</field>
            <field name="report_file">fleet_branch_rental.report_fleet_rental_contract</field>
            <field name="binding_model_id" ref="model_fleet_rental_contract"/>
            <field name="binding_type">report</field>
        </record>

        <template id="report_fleet_rental_contract_document">
            <t t-call="web.external_layout">
                <div class="page">
                    <h2 class="text-center mb-1">عقد تأجير مركبة</h2>
                    <div class="text-center text-muted mb-4">
                        <span t-field="o.name"/>
                    </div>

                    <table class="table table-sm mb-4">
                        <tr>
                            <td style="width:35%"><strong>المؤجِّر</strong></td>
                            <td><span t-field="o.fleet_company_id"/></td>
                        </tr>
                        <tr>
                            <td><strong>المستأجر</strong></td>
                            <td><span t-field="o.company_id"/></td>
                        </tr>
                        <tr t-if="o.employee_id">
                            <td><strong>المندوب المستلِم</strong></td>
                            <td><span t-field="o.employee_id"/></td>
                        </tr>
                        <tr>
                            <td><strong>المركبة</strong></td>
                            <td>
                                <span t-field="o.vehicle_id"/>
                                <t t-if="o.vehicle_id.license_plate">
                                    <span> — لوحة: </span>
                                    <span t-field="o.vehicle_id.license_plate"/>
                                </t>
                            </td>
                        </tr>
                        <tr>
                            <td><strong>تاريخ التسليم</strong></td>
                            <td><span t-field="o.date_start"/></td>
                        </tr>
                        <tr t-if="o.date_end">
                            <td><strong>تاريخ الإرجاع</strong></td>
                            <td><span t-field="o.date_end"/></td>
                        </tr>
                        <tr>
                            <td><strong>الأجرة الشهرية</strong></td>
                            <td><span t-field="o.monthly_rate"/></td>
                        </tr>
                    </table>

                    <div class="mb-4">
                        <strong>بنود العقد</strong>
                        <ol>
                            <li>تبقى ملكية المركبة للمؤجِّر، وللمستأجر حق استعمالها
                                خلال مدة هذا العقد.</li>
                            <li>تشمل الأجرة الاستهلاك والتأمين والاستمارة والصيانة
                                الدورية والأعطال - وهي على المؤجِّر.</li>
                            <li>تكاليف الحوادث والتلفيات على المستأجر بنسبة تحمّله
                                وفق تقرير تحديد المسؤولية.</li>
                            <li>تُحتسب الأجرة بالتناسب على أيام الاستعمال، وتتوقف
                                يوم إرجاع المركبة للمؤجِّر.</li>
                            <li>عند الحادث أو العطل الكبير تُسلَّم المركبة للمؤجِّر
                                وينتهي العقد بتاريخ التسليم.</li>
                            <li>الوقود والمخالفات المرورية على المستأجر مباشرة.</li>
                        </ol>
                    </div>

                    <div t-if="o.note" class="mb-4">
                        <strong>ملاحظات</strong>
                        <div t-field="o.note"/>
                    </div>

                    <div class="row mt-5">
                        <div class="col-6 text-center">
                            <div>المؤجِّر</div>
                            <div class="mt-5">........................</div>
                        </div>
                        <div class="col-6 text-center">
                            <div>المستأجر</div>
                            <div class="mt-5">........................</div>
                        </div>
                    </div>
                </div>
            </t>
        </template>

        <template id="report_fleet_rental_contract">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <t t-call="fleet_branch_rental.report_fleet_rental_contract_document"/>
                </t>
            </t>
        </template>

    </data>
</odoo>
