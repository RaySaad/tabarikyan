<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_fleet_vehicle_form_rental" model="ir.ui.view">
            <field name="name">fleet.vehicle.form.rental</field>
            <field name="model">fleet.vehicle</field>
            <field name="inherit_id" ref="fleet.fleet_vehicle_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='model_id']" position="after">
                    <field name="rental_chargeable"/>
                    <field name="rental_monthly_rate"
                           invisible="not rental_chargeable"/>
                    <field name="currency_id" invisible="1"/>
                </xpath>
            </field>
        </record>

        <record id="view_fleet_vehicle_list_rental" model="ir.ui.view">
            <field name="name">fleet.vehicle.list.rental</field>
            <field name="model">fleet.vehicle</field>
            <field name="inherit_id" ref="fleet.fleet_vehicle_view_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='model_id']" position="after">
                    <field name="rental_monthly_rate" optional="show"/>
                    <field name="currency_id" column_invisible="True"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
