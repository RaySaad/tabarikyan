<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ============================================================
             واجهة الفرع
             ============================================================
             جذر مستقل عن تطبيق "الأسطول": قوائم أودو لا تُفلتر بالشركة
             بل بالمجموعة، وقائمة الأسطول الجذرية محمية بمجموعة أودو
             التي تمنح تعديل المركبات - فلا سبيل لإظهار بند واحد منها
             للفرع دون منحه ما لا يجوز له.
             ============================================================ -->

        <record id="action_branch_vehicle" model="ir.actions.act_window">
            <field name="name">مركبات الفرع</field>
            <field name="res_model">fleet.vehicle</field>
            <field name="view_mode">kanban,list,form</field>
            <field name="domain">[('rental_branch_id', '!=', False)]</field>
            <field name="context">{'create': False, 'edit': False}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">لا مركبة مؤجَّرة لفرعك بعد</p>
                <p>تظهر هنا المركبات التي أصدر الأسطول عقداً لها مع فرعك.</p>
            </field>
        </record>

        <record id="action_branch_odometer" model="ir.actions.act_window">
            <field name="name">قراءات العدّاد</field>
            <field name="res_model">fleet.vehicle.odometer</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">سجّل قراءة عدّاد</p>
                <p>القراءة تُحرّك جدولة الصيانة بالكيلومترات، فسجّلها دورياً.</p>
            </field>
        </record>

        <record id="action_branch_accident_report" model="ir.actions.act_window">
            <field name="name">بلاغات الحوادث</field>
            <field name="res_model">fleet.accident.report</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">سجّل بلاغ حادث</p>
                <p>البلاغ يصل الأسطول، وتُحدَّد منه نسبة تحمّل الفرع والمندوب.</p>
            </field>
        </record>

        <record id="action_branch_rental_charge" model="ir.actions.act_window">
            <field name="name">تحميلات فرعي</field>
            <field name="res_model">fleet.branch.rental.charge</field>
            <field name="view_mode">list,form</field>
            <field name="context">{'create': False, 'edit': False}</field>
        </record>

        <menuitem id="menu_branch_fleet_root"
                  name="مركبات فرعي"
                  web_icon="fleet,static/description/icon.png"
                  sequence="46"
                  groups="group_fleet_branch_supervisor"/>

        <menuitem id="menu_branch_fleet_vehicles"
                  name="مركبات الفرع"
                  parent="menu_branch_fleet_root"
                  action="action_branch_vehicle"
                  sequence="10"/>

        <menuitem id="menu_branch_fleet_operations"
                  name="التسجيل اليومي"
                  parent="menu_branch_fleet_root"
                  sequence="20"/>

        <menuitem id="menu_branch_fleet_odometer"
                  name="قراءات العدّاد"
                  parent="menu_branch_fleet_operations"
                  action="action_branch_odometer"
                  sequence="20"/>

        <menuitem id="menu_branch_fleet_accident"
                  name="بلاغات الحوادث"
                  parent="menu_branch_fleet_operations"
                  action="action_branch_accident_report"
                  sequence="30"/>

        <menuitem id="menu_branch_fleet_costs"
                  name="التكاليف"
                  parent="menu_branch_fleet_root"
                  sequence="30"/>

        <menuitem id="menu_branch_fleet_charges"
                  name="تحميلات فرعي"
                  parent="menu_branch_fleet_costs"
                  action="action_branch_rental_charge"
                  sequence="10"/>

    </data>
</odoo>
