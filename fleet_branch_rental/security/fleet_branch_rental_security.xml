<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- التحميل يخص فرعين معاً: الفرع المحمَّل وشركة الأسطول. فقصره
             على company_id وحده يُخفيه عن الأسطول الذي أصدره. -->
        <record id="fleet_branch_rental_charge_company_rule" model="ir.rule">
            <field name="name">تحميل أجرة الأسطول: الفرع أو الأسطول</field>
            <field name="model_id" ref="model_fleet_branch_rental_charge"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('company_id', 'in', company_ids), ('fleet_company_id', 'in', company_ids)]</field>
        </record>

        <record id="fleet_branch_rental_charge_line_company_rule" model="ir.rule">
            <field name="name">سطور تحميل أجرة الأسطول: حسب الشركة</field>
            <field name="model_id" ref="model_fleet_branch_rental_charge_line"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('company_id', 'in', company_ids), ('charge_id.fleet_company_id', 'in', company_ids)]</field>
        </record>

        <record id="fleet_rental_contract_company_rule" model="ir.rule">
            <field name="name">عقود التأجير: الفرع أو الأسطول</field>
            <field name="model_id" ref="model_fleet_rental_contract"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('company_id', 'in', company_ids), ('fleet_company_id', 'in', company_ids)]</field>
        </record>

    </data>
</odoo>
