<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- التحميل يخص فرعين معاً: الفرع المحمَّل وشركة الأسطول. فقصره
             على company_id وحده يُخفيه عن الأسطول الذي أصدره. -->
        <record id="fleet_branch_rental_charge_company_rule" model="ir.rule">
            <field name="name">تحميل أجرة الأسطول: الفرع أو الأسطول</field>
            <field name="model_id" ref="model_fleet_branch_rental_charge"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('company_id', 'in', company_ids), ('fleet_company_id', 'in', company_ids)]</field>
        </record>

        <record id="fleet_branch_rental_charge_line_company_rule" model="ir.rule">
            <field name="name">سطور تحميل أجرة الأسطول: حسب الشركة</field>
            <field name="model_id" ref="model_fleet_branch_rental_charge_line"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('company_id', 'in', company_ids), ('charge_id.fleet_company_id', 'in', company_ids)]</field>
        </record>

        <record id="fleet_rental_contract_company_rule" model="ir.rule">
            <field name="name">عقود التأجير: الفرع أو الأسطول</field>
            <field name="model_id" ref="model_fleet_rental_contract"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('company_id', 'in', company_ids), ('fleet_company_id', 'in', company_ids)]</field>
        </record>

        <!-- ============================================================
             مشرف مركبات الفرع
             ============================================================
             دور الفرع لا دور الأسطول: يُدخل ما يقع على المركبة عنده
             (وقود، عدّاد، حادث، طلب صيانة) ويقرأ تكاليفها، ولا يعدّل
             شيئاً - التصحيح من الأسطول وحده.

             لا تشمل fleet.fleet_group_user عمداً: تلك تمنح تعديل المركبة
             وحذفها (1,1,1,1 في أودو)، ومن حقولها الأجرة الشهرية - فيصير
             بوسع الفرع تخفيض أجرة نفسه. لذلك قوائم الفرع في جذر مستقل
             وصلاحيته على المركبة قراءة فقط.
             ============================================================ -->
        <record id="group_fleet_branch_supervisor" model="res.groups">
            <field name="name">مشرف مركبات الفرع</field>
            <field name="sequence">54</field>
            <field name="privilege_id" ref="recruitment_workflow.privilege_recruitment_workflow"/>
            <field name="implied_ids" eval="[
                (4, ref('recruitment_workflow.group_recruitment_workflow_user')),
            ]"/>
        </record>

        <!-- ============================================================
             توسيع قواعد أودو: الرؤية بالعقد لا بالملكية
             ============================================================
             القواعد العامة تُجمع بـAND، فإضافة قاعدة جديدة لا توسّع
             الرؤية أبداً مهما كان نطاقها - ولا توسيع إلا بتعديل نطاق
             قاعدة أودو نفسها، وهو ما يجري هنا.

             المركبة مملوكة لشركة الأسطول، فنطاق أودو يُخفيها عن الفرع
             المستأجر، والفرع يحتاج رؤيتها ليسجّل وقودها وحوادثها.
             rental_branch_id مخزَّن على البطاقة فالفلترة عليه فهرسية.
             ============================================================ -->
        <!-- كتابة صريحة لا سجلّ بنفس المعرّف: قواعد أودو هذه مسجَّلة
             بـnoupdate=True، فإعادة تعريفها في ملف بيانات **تُتجاهَل
             بصمت** - بلا خطأ ولا أثر في السجل (كشفه اختبار الرؤية).
             وwrite لا يخضع لتلك الحماية، ويُعاد تنفيذه عند كل ترقية
             فيستعيد التوسيع لو أعادت أودو ضبط القاعدة. -->
        <!-- التوسيع **للقراءة وحدها**. قاعدة أودو الواحدة تحكم القراءة
             والكتابة والإنشاء والحذف معاً، فتوسيعها كما هي كان يفتح
             للفرع تعديل المركبة: ينقل شركتها إلى فرعه فتخرج من دفاتر
             الأسطول وتتوقف أجرتها. الكتابة تبقى على المالك في قاعدة
             مستقلة أدناه. -->
        <function model="ir.rule" name="write"
                  eval="[[ref('fleet.ir_rule_fleet_vehicle')],
                         {'domain_force': &quot;['|', ('company_id', 'in', company_ids + [False]), ('rental_branch_id', 'in', company_ids)]&quot;,
                          'perm_read': True, 'perm_write': False,
                          'perm_create': False, 'perm_unlink': False}]"/>

        <record id="fleet_vehicle_owner_write_rule" model="ir.rule">
            <field name="name">تعديل المركبة: شركتها المالكة وحدها</field>
            <field name="model_id" ref="fleet.model_fleet_vehicle"/>
            <field name="global" eval="True"/>
            <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
            <field name="perm_read" eval="False"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- العدّاد: الفرع يقرأ **ويُنشئ** قراءة لمركبته، ولا يعدّل
             قراءة سابقة ولا يحذفها. -->
        <function model="ir.rule" name="write"
                  eval="[[ref('fleet.ir_rule_fleet_odometer')],
                         {'domain_force': &quot;['|', ('vehicle_id.company_id', 'in', company_ids + [False]), ('vehicle_id.rental_branch_id', 'in', company_ids)]&quot;,
                          'perm_read': True, 'perm_create': True,
                          'perm_write': False, 'perm_unlink': False}]"/>

        <record id="fleet_odometer_owner_write_rule" model="ir.rule">
            <field name="name">تعديل قراءة العدّاد: مالك المركبة وحده</field>
            <field name="model_id" ref="fleet.model_fleet_vehicle_odometer"/>
            <field name="global" eval="True"/>
            <field name="domain_force">[('vehicle_id.company_id', 'in', company_ids + [False])]</field>
            <field name="perm_read" eval="False"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- الفرع يرى تكلفة ورشة مركبته (شفافية طلبها صاحب القرار)
             ولا يكتبها: الورشة على الأسطول. -->
        <function model="ir.rule" name="write"
                  eval="[[ref('fleet.ir_rule_fleet_log_services')],
                         {'domain_force': &quot;['|', ('company_id', 'in', company_ids + [False]), ('vehicle_id.rental_branch_id', 'in', company_ids)]&quot;,
                          'perm_read': True, 'perm_write': False,
                          'perm_create': False, 'perm_unlink': False}]"/>

        <record id="fleet_service_log_owner_write_rule" model="ir.rule">
            <field name="name">سجل الورشة: الكتابة لشركة المركبة</field>
            <field name="model_id" ref="fleet.model_fleet_vehicle_log_services"/>
            <field name="global" eval="True"/>
            <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
            <field name="perm_read" eval="False"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- بلاغ الحادث شركته شركة الموظف، فكان يختفي عن شركة الأسطول
             مع أنها مالكة المركبة ومن يتحمّل إصلاحها. -->
        <record id="recruitment_workflow.fleet_accident_report_company_rule" model="ir.rule">
            <field name="domain_force">['|', '|', ('company_id', '=', False), ('company_id', 'in', company_ids), ('vehicle_id.company_id', 'in', company_ids)]</field>
        </record>

    </data>
</odoo>
